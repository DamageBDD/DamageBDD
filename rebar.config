%%% -*- mode: erlang; erlang-indent-level: 2; -*-
{project_app_dirs, ["apps/*"]}.

{pre_hooks, [{compile, "git rev-parse HEAD > commit_hash.txt"}]}.

{
    erl_opts,
    [
        %warnings_as_errors,
        debug_info,
        {
            src_dirs,
            ["src", "test", "test/handlers"]
        }
    ]
}.

{erlc_compiler, [{recursive, true}]}.

{
    deps,
    [
        tls_certificate_check,
        {
            ejsonpath,
            {
                git,
                "https://github.com/ostrovok-team/ejsonpath.git",
                {branch, "master"}
            }
        },
        {
            egherkin,
            {git, "https://github.com/asyncmind0/egherkin.git", {branch, "master"}}
        },
        {
            mustache,
            {git, "https://github.com/mojombo/mustache.erl.git", {branch, "master"}}
        },
        yamerl,
        {
            cowboy,
            {git, "https://github.com/ninenines/cowboy.git", {branch, "master"}}
        },
        {cowboy_swagger, "2.7.0"},
        {
            uuid,
            ".*",
            {git, "https://github.com/avtobiff/erlang-uuid.git", {branch, "master"}}
        },
        {pa, ".*", {git, "https://github.com/erszcz/pa.git", {branch, "master"}}},
        {
            poolboy,
            ".*",
            {git, "https://github.com/devinus/poolboy.git", {branch, "master"}}
        },
        {
            docopt,
            ".*",
            {git, "https://github.com/plux/docopt-erl.git", {branch, "master"}}
        },
        {
            datestring,
            {git, "https://github.com/strange/datestring.git", {branch, "master"}}
        },
        {
            gun,
            ".*",
            {git, "https://github.com/ninenines/gun.git", {tag, "2.2.0"}}
        },
        recon,
        {
            throttle,
            {git, "https://github.com/lambdaclass/throttle.git", {tag, "0.3.0"}}
        },
        jsx,
        erlcron,
        erlexec,
        {
            base58,
            {git, "https://github.com/aeternity/erl-base58.git", {branch, "master"}}
        },
        {
            aesophia,
            {git, "https://github.com/aeternity/aesophia.git", {branch, "master"}}
        },
        {ipfs, {git, "https://github.com/asyncmind0/ipfs.git", {branch, "master"}}},
        {gen_smtp, "1.3.0"},
        certifi,
        opentelemetry,
        opentelemetry_exporter,
        opentelemetry_cowboy,

        {
            color,
            {git, "https://github.com/asyncmind0/erlang-color.git", {branch, "master"}}
        },
        {webdrv, {git, "https://github.com/asyncmind0/webdrv.git", {branch, "master"}}},
        {sync, {git, "https://github.com/asyncmind0/Sync.git", {branch, "master"}}},
        {enacl, {git, "https://github.com/aeternity/enacl.git", {branch, "master"}}},
        {prometheus,
            {git, "https://github.com/prometheus-erl/prometheus.erl.git", {branch, "master"}}},
        {prometheus_cowboy,
            {git, "https://github.com/prometheus-erl/prometheus-cowboy.git", {branch, "master"}}},
        {bbmustache, ".*", {git, "https://github.com/soranoba/bbmustache.git", {branch, "master"}}},
        {trails, "2.3.1"},
        iso8601,
        gproc,
        thoas,
        jwt,
        sheldon,
        bech32,
        base64url,
        jose
    ]
}.

{project_plugins, [rebar3_edoc_extensions, pc]}.

{edoc_opts, [{dir, "priv/docs/"}]}.

{
    plugins,
    [
        rebar3_hex,
        {
            rebar3_pkg,
            {
                git,
                "https://github.com/DamageBDD/rebar3_pkg.git",
                {branch, "main"}
            }
        },
        erlfmt,
        pc,
        {
            rebar3_dialyzer_html,
            {
                git,
                "https://github.com/srijan/rebar3_dialyzer_html.git",
                {branch, "main"}
            }
        }
    ]
}.

{dialyzer, [{output_format, raw}, {warnings, [no_unknown]}]}.

{
    shell,
    [
        {config, "config/sys.config"},
        {
            apps,
            [
                kernel,
                stdlib,
                public_key,
                ssl,
                crypto,
                yamerl,
                cowboy,
                gun,
                erlcron,
                erlexec,
                cedb,
                bbmustache,
                gproc,
                ssh,
                damage,
                bech32,
                erm,
                bop
            ]
        }
    ]
}.

{ct_compile_opts, [export_all]}.

{
    profiles,
    [
        {prod, [{erl_opts, [no_debug_info, warnings_as_errors]}]},
        {native, [{erl_opts, [{native, {hipe, o3}}, {d, 'NATIVE'}]}]},
        {
            test,
            [
                {erl_opts, [debug_info]},
                {
                    src_dirs,
                    [
                        "src",
                        "test",
                        "test/handlers",
                        "apps/{damage,erm,ecai,nosternity}/{src,include,test}/*.{hrl,erl}"
                    ]
                },
                {
                    deps,
                    [
                        {
                            ct_helper,
                            ".*",
                            {git, "https://github.com/ninenines/ct_helper.git"}
                        },
                        {ranch, ".*", {git, "https://github.com/ninenines/ranch.git"}}
                    ]
                },
                {kernel, [{error_logger, {file, "test.log"}}]},
                {ct_hooks, cowboy_ct_hook},
                {ct_opts, [{sys_config, "config/sys.config"}]}
            ]
        }
    ]
}.

{
    relx,
    [
        {
            release,
            {damage, git},
            [
                kernel,
                stdlib,
                ssl,
                ssh,
                sasl,
                tls_certificate_check,
                public_key,
                ssl,
                crypto,
                inets,
                jsx,
                datestring,
                poolboy,
                gun,
                erlcron,
                ejsonpath,
                egherkin,
                bbmustache,
                yamerl,
                cowboy,
                uuid,
                pa,
                poolboy,
                docopt,
                iso8601,
                datestring,
                gun,
                recon,
                throttle,
                jsx,
                erlexec,
                ipfs,
                gen_smtp,
                certifi,
                opentelemetry,
                opentelemetry_exporter,
                opentelemetry_cowboy,
                color,
                webdrv,
                enacl,
                trails,
                cowboy_swagger,
                gproc,
                bech32,
                thoas,
                jwt,
                base64url,
                aeserialization,
                damage,
                erm,
                ecai,
                bop
            ]
        },
        {sys_config, "config/sys.config.sample"},
        %{vm_args,    "config/vm.args"},
        {dev_mode, false},
        {include_erts, true},
        {extended_start_script, true}
    ]
}.

{erlfmt, [
    write,
    {files, [
        "apps/{damage,erm,ecai,nosternity}/{src,include,test}/*.{hrl,erl}",
        "rebar.config",
        "config/*.config"
    ]}
]}.

{
    port_env,
    [
        {
            "linux",
            "LDFLAGS",
            "$LDFLAGS -shared -lgmp -lcrypto"
        },
        {"linux", "CFLAGS", "-shared -fPIC -I/usr/lib/erlang/erts-*/include"}
    ]
}.
{
    port_specs,
    [
        {"apps/ecai/priv/ecai.so", ["apps/ecai/c_src/ecai_nif.c"]}
    ]
}.
{provider_hooks, [{pre, [{compile, {pc, compile}}, {clean, {pc, clean}}]}]}.
