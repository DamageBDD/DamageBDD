%%% -*- mode: erlang; erlang-indent-level: 2; -*-
%% OTP 27+ compatibility for meck when warnings_as_errors is enabled.
{overrides, [
    {add, meck, [{erl_opts, [nowarn_deprecated_catch]}]},
    {add, chatterbox, [{erl_opts, [nowarn_deprecated_catch]}]},
    {add, erlexec, [{erl_opts, [nowarn_deprecated_catch]}]},
    {add, katana_code, [{erl_opts, [nowarn_deprecated_catch]}]},
    {add, prometheus, [{erl_opts, [nowarn_deprecated_catch]}]}
]}.

{project_app_dirs, ["apps/*"]}.

%% Production sources only. Tests belong to the test profile, not app ebin.
{src_dirs, ["src"]}.

{
    erl_opts,
    [
        %warnings_as_errors,
        debug_info,
        {i, "include"}
    ]
}.

{erlc_compiler, [{recursive, true}]}.

%% Shared runtime/build dependencies. bech32, zj, zx and vanillae are
%% project applications under apps/*; do not fetch second copies here.
{
    deps,
    [
        tls_certificate_check,
        {
            ejsonpath,
            {
                git,
                "https://github.com/ostrovok-team/ejsonpath.git",
                {branch, "master"}
            }
        },
        {
            egherkin,
            {git, "https://github.com/asyncmind0/egherkin.git", {branch, "master"}}
        },
        yamerl,
        {cowboy, "2.18.0"},
        {cowboy_swagger, "2.7.0"},
        {
            uuid,
            ".*",
            {git, "https://github.com/avtobiff/erlang-uuid.git", {branch, "master"}}
        },
        {
            poolboy,
            ".*",
            {git, "https://github.com/devinus/poolboy.git", {branch, "master"}}
        },
        {
            datestring,
            {git, "https://github.com/strange/datestring.git", {branch, "master"}}
        },
        {gun, "2.2.0"},
        recon,
        {
            throttle,
            {git, "https://github.com/lambdaclass/throttle.git", {tag, "0.3.0"}}
        },
        jsx,
        erlcron,
        erlexec,
        {
            base58,
            {git, "https://github.com/aeternity/erl-base58.git", {branch, "master"}}
        },
        {
            aesophia,
            {git, "https://github.com/aeternity/aesophia.git", {branch, "master"}}
        },
        {ipfs, {git, "https://github.com/asyncmind0/ipfs.git", {branch, "master"}}},
        {gen_smtp, {git, "https://github.com/asyncmind0/gen_smtp.git", {branch, "master"}}},
        certifi,
        opentelemetry,
        opentelemetry_exporter,
        opentelemetry_cowboy,
        cowboy_telemetry,
        {
            color,
            {git, "https://github.com/asyncmind0/erlang-color.git", {branch, "master"}}
        },
        {webdrv, {git, "https://github.com/asyncmind0/webdrv.git", {branch, "master"}}},
        %% Node-local code reload: shell development or explicit release opt-in.
        %% fs supplies notifications; damage_reload owns compilation/publication.
        {fs, "11.4.1"},
        {enacl, {git, "https://github.com/aeternity/enacl.git", {branch, "master"}}},
        {prometheus, {git, "https://github.com/asyncmind0/prometheus.erl.git", {branch, "master"}}},
        {prometheus_cowboy,
            {git, "https://github.com/prometheus-erl/prometheus-cowboy.git", {branch, "master"}}},
        {bbmustache, ".*", {git, "https://github.com/soranoba/bbmustache.git", {branch, "master"}}},
        {trails, "2.3.1"},
        gproc,
        jwt,
        {ec_utils, {git, "https://github.com/hanssv/ec_utils.git", {branch, "master"}}},
        {aebytecode, {git, "https://github.com/aeternity/aebytecode.git", {tag, "v3.4.1"}}},
        eblake2,
        base64url,
        pe4kin,
        {aws, "1.3.2", {pkg, aws_erlang}},
        {aws_credentials, "1.0.4"}
    ]
}.

{project_plugins, [
    erlfmt
]}.

{
    plugins,
    [
        {
            rebar3_pkg,
            {
                git,
                "https://github.com/DamageBDD/rebar3_pkg.git",
                {branch, "main"}
            }
        },
        pc
    ]
}.

{edoc_opts, [{dir, "priv/docs/"}]}.

{dialyzer, [
    {incremental, true},
    {plt_apps, all_deps},
    {warnings, [
        unmatched_returns,
        error_handling
    ]}
]}.

{alias, [
    {verify, [
        compile,
        eunit,
        dialyzer
    ]}
]}.

{
    shell,
    [
        {config, "config/sys.config"},
        {script_file, "apps/damage/scripts/dev_shell.escript"},
        {
            apps,
            [
                damage,
                nosternity,
                erm,
                ecai,
                vanillae,
                bop
            ]
        }
    ]
}.

{ct_compile_opts, [export_all]}.

{pre_hooks, [
    {compile, "escript apps/damage/scripts/check_no_catchall_steps.escript"},
    {release, "escript apps/damage/scripts/check_no_catchall_steps.escript"},
    {compile, "sh bin/gen_build_info.sh"},
    {compile, "git rev-parse HEAD > commit_hash.txt"},
    {clean, "sh bin/build_oqs_nif.sh clean"}
]}.

%% OQS is a single damage artifact, not a port target inherited by all apps.
%% The root post-compile hook runs after the active profile's app directories
%% exist. Do not build in apps/damage/priv and assume it was copied to _build.
%% Rebar3 >= 3.23 exports the active build and Erlang paths to shell hooks.
{post_hooks, [
    {compile, "sh bin/build_oqs_nif.sh"}
]}.
{
    profiles,
    [
        {prod, [{erl_opts, [debug_info]}]},
        %% Optional native capture, Whisper, VAD and speaker verification.
        %% Build: rebar3 as native_voice compile
        {native_voice, [
            {port_specs, [
                {".*-linux.*", "apps/erm/priv/erm_native_voice",
                    ["apps/erm/c_src/erm_native_voice.cpp"], [{env, [
                        {"CXXFLAGS", "$CXXFLAGS -std=c++17 -O2 -Wall -Wextra -pthread "
                            "-I\"${WHISPER_PREFIX:-/opt/whisper}/include\" "
                            "-I\"${SHERPA_PREFIX:-/opt/sherpa-onnx}/include\""},
                        {"LDFLAGS", "$LDFLAGS -pthread "
                            "-L\"${WHISPER_PREFIX:-/opt/whisper}/lib\" "
                            "-L\"${SHERPA_PREFIX:-/opt/sherpa-onnx}/lib\" "
                            "-Wl,--disable-new-dtags,-rpath,\"${WHISPER_PREFIX:-/opt/whisper}/lib:${SHERPA_PREFIX:-/opt/sherpa-onnx}/lib\" "
                            "-lwhisper -lsherpa-onnx-c-api"}
                    ]}]}
            ]}
        ]},
        %% Native speech requires a separately installed libpiper SDK.
        %% Ordinary builds and isolated voice tests do not need this SDK.
        %% Build speech with: PIPER_PREFIX=/opt/piper rebar3 as tts compile
        %% Release with speech: rebar3 as prod,tts release
        {tts, [
            {port_specs, [
                %% ----------------------------------------------------------------
                %% ERM native Piper TTS - supervised standalone C++ executable
                %% Requires libpiper + ONNX Runtime installed under /opt/piper (lib/).
                %% Build: PIPER_PREFIX=/absolute/prefix rebar3 as tts compile
                %% Uses the existing pc compile/clean hooks; no Python dependency.
                %% The prefix must also exist on the runtime host (embedded RPATH).
                %% ----------------------------------------------------------------
                {".*-linux.*", "apps/erm/priv/erm_tts_port",
                    ["apps/erm/c_src/erm_tts_port.cpp"], [
                        {env, [
                            {"CXXFLAGS",
                                "$CXXFLAGS -std=c++17 -O2 -Wall -Wextra -pthread "
                                "-I\"${PIPER_PREFIX:-/opt/piper}/include\""},
                            {"LDFLAGS",
                                "$LDFLAGS -pthread "
                                "-L\"${PIPER_PREFIX:-/opt/piper}/lib\" "
                                "-Wl,--disable-new-dtags,-rpath,\"${PIPER_PREFIX:-/opt/piper}/lib\" "
                                "-lpiper -lonnxruntime"}
                        ]}
                    ]}
            ]}
        ]},

        %% CUDA/GPU support is optional. Keep it out of the default/prod
        %% build so hosts without nvcc can still build a complete release.
        %%
        %% Enable explicitly with:
        %%   rebar3 as prod,cuda release
        {cuda, [
            {port_specs, [
                {".*-linux.*", "apps/ecai/priv/ecai_gpu.so", ["apps/ecai/c_src/ecai_gpu_nif.c"], [
                    {env, [
                        {"CC", "nvcc"},
                        {"CFLAGS", "$ERL_CFLAGS"},
                        {"DRV_CFLAGS", "-Xcompiler -fPIC"},
                        {"LDFLAGS", "$LDFLAGS -shared -L${CUDA_LIB64} -lcudart"},
                        {"DRV_LDFLAGS", ""}
                    ]}
                ]}
            ]}
        ]},
        {mac, [
            {erl_opts, [{d, 'MACOS'}]}
        ]},
        {native, [{erl_opts, [{native, {hipe, o3}}, {d, 'NATIVE'}]}]},
        {
            test,
            [
                {erl_opts, [debug_info]},
                %% Test sources are compiled outside the production module list.
                %% Recurse once through test/; do not add test/handlers again.
                {extra_src_dirs, [{"test", [{recursive, true}]}]},
                {
                    deps,
                    [
                        %% Explicit test dependency; no legacy mustache dependency.
                        %% Select the published Hex release, not an unpinned Git HEAD.
                        {meck, "1.0.0"},
                        {
                            ct_helper,
                            ".*",
                            {git, "https://github.com/ninenines/ct_helper.git"}
                        }
                    ]
                },
                {kernel, [{error_logger, {file, "test.log"}}]},
                {ct_hooks, cowboy_ct_hook},
                {ct_opts, [{sys_config, "config/sys.config"}]}
            ]
        }
    ]
}.

{
    relx,
    [
        {
            release,
            {damage, git},
            [
                kernel,
                stdlib,
                %% Available for explicitly enabled post-release development,
                %% but do not start fs's default watcher during release boot.
                {fs, load},
                {compiler, load},
                ssh,
                sasl,
                tls_certificate_check,
                public_key,
                ssl,
                crypto,
                inets,
                {aws, none},
                {aws_credentials, none},
                datestring,
                gun,
                erlcron,
                ejsonpath,
                egherkin,
                bbmustache,
                yamerl,
                cowboy,
                uuid,
                poolboy,
                os_mon,
                recon,
                throttle,
                jsx,
                erlexec,
                ipfs,
                gen_smtp,
                certifi,
                opentelemetry,
                opentelemetry_exporter,
                opentelemetry_cowboy,
                prometheus,
                prometheus_cowboy,
                color,
                webdrv,
                enacl,
                trails,
                cowboy_swagger,
                cowboy_telemetry,
                gproc,
                bech32,
                jwt,
                base64url,
                aeserialization,
                zj,
                zx,
                vanillae,
                ec_utils,
                aebytecode,
                aesophia,
                eblake2,
                damage,
                nosternity,
                erm,
                ecai,
                bop
            ]
        },
        {sys_config, "config/sys.config.sample"},
        %{vm_args,    "config/vm.args"},
        {dev_mode, false},
        {mode, prod},
        %% Keep operator-inspectable/editable application source in production.
        %% Explicit values override relx prod-mode defaults.
        {include_src, true},
        {debug_info, keep},
        {include_erts, true},
        {extended_start_script, true},
        %% Include nsecbunker operational artifacts in the release root.
        %% Release layout after `rebar3 release` / package install:
        %%   /opt/damage/bin/damage-nsecbunker-crypto-c
        %%   /opt/damage/scripts/nsecbunker/*.sh
        %%   /opt/damage/features/nsecbunker/*.feature
        %%   /opt/damage/doc/nsecbunker/*
        %%
        %% The C backend is compiled by pc from priv/crypto/... and then copied
        %% into bin/ so sys.config can use a stable absolute path on target hosts.
        {overlay, [
            {mkdir, "share"},
            {mkdir, "share/damage"},
            {mkdir, "share/damage/build"},
            {copy, "rebar.config", "share/damage/build/rebar.config"},
            {copy, "rebar.lock", "share/damage/build/rebar.lock"},
            {copy, "commit_hash.txt", "share/damage/build/commit_hash.txt"},

            {mkdir, "scripts"},
            {mkdir, "features"},
            {mkdir, "doc"},
            {mkdir, "config"},
            {copy, "config/sys.config.code_reload.fragment.config",
                "config/sys.config.code_reload.fragment.config"},
            {copy, "doc/code_reload.md", "doc/code_reload.md"},
            {copy, "apps/damage/scripts/check-nsecbunker-aws-invariants.sh",
                "scripts/check-nsecbunker-aws-invariants.sh"},

            {copy, "apps/damage/scripts/validate-ec2-security.sh",
                "scripts/validate-ec2-security.sh"},

            {copy, "features/nsecbunker", "features/nsecbunker"},
            {copy, "doc/nsecbunker", "doc/nsecbunker"},
            {copy, "config/sys.config.aws.production.fragment.config",
                "config/sys.config.aws.production.fragment.config"},

            {copy, "config/sys.config.nsecbunker.fragment.config",
                "config/sys.config.nsecbunker.fragment.config"},
            {copy, "priv/crypto/damage-nsecbunker-crypto-c/damage-nsecbunker-crypto-c",
                "bin/damage-nsecbunker-crypto-c"}
        ]}
    ]
}.

{erlfmt, [
    write,
    {files, [
        "apps/{damage,erm,ecai,nosternity}/{src,include,test}/*.{hrl,erl,src}",
        "rebar.config",
        "config/*.config"
    ]}
]}.

%% rebar.config

%% -------------------------------------------------------------------
%% Global defaults
%%  - no global -shared (that breaks the exe)
%%  - keep ERL_* flags
%% -------------------------------------------------------------------
{port_env, [
    {".*", "CFLAGS", "$CFLAGS -O2"},
    {".*", "ERL_CFLAGS", "$ERL_CFLAGS"},
    {".*", "ERL_LDFLAGS", "$ERL_LDFLAGS"}
]}.

{port_specs, [
    %% ----------------------------------------------------------------
    %% ERM DPMS X11 NIF - shared object
    %%
    %% Keep this as a port_spec rather than a compile pre-hook so rebar3
    %% owns the artifact and carries it into _build/lib/erm/priv and
    %% subsequent releases/packages.
    %% ----------------------------------------------------------------
    {".*-linux.*", "apps/erm/priv/erm_dpms_nif.so",
        ["apps/erm/c_src/erm_dpms_nif.c"], [
            {env, [
                {"LANG", "C"},
                {"CFLAGS",
                    "$CFLAGS $ERL_CFLAGS -fPIC "
                    "-O2 -g3 -Wall -Wextra -Wpedantic "
                    "-Werror=implicit-function-declaration "
                    "$(pkg-config --cflags xcb xcb-screensaver xcb-dpms)"},
                {"LDFLAGS",
                    "$LDFLAGS $ERL_LDFLAGS "
                    "$(pkg-config --libs xcb xcb-screensaver xcb-dpms)"}
            ]}
        ]},

    %% ----------------------------------------------------------------
    %% ERM GTK4 C-node - supervised standalone executable
    %% ----------------------------------------------------------------
    {".*-linux.*", "apps/erm/priv/bin/gtknode4", ["apps/erm/c_src/gtknode4/*.c"], [
        {env, [
            {"LANG", "C"},
            {"CFLAGS",
                "$CFLAGS $ERL_CFLAGS "
                "-std=c17 -O2 -g3 -fno-omit-frame-pointer "
                "-Wall -Wextra -Wpedantic -Wformat=2 "
                "-Werror=implicit-function-declaration "
                "$(pkg-config --cflags gtk4)"},
            {"LDFLAGS",
                "$LDFLAGS $ERL_LDFLAGS -lei "
                "$(pkg-config --libs gtk4) -lX11"}
        ]}
    ]},

    {".*-darwin.*", "apps/erm/priv/bin/gtknode4", ["apps/erm/c_src/gtknode4/*.c"], [
        {env, [
            {"LANG", "C"},
            {"CFLAGS",
                "$CFLAGS $ERL_CFLAGS "
                "-std=c17 -O2 -g3 -fno-omit-frame-pointer "
                "-Wall -Wextra -Wpedantic -Wformat=2 "
                "-Werror=implicit-function-declaration "
                "$(pkg-config --cflags gtk4)"},
            {"LDFLAGS",
                "$LDFLAGS $ERL_LDFLAGS -lei "
                "$(pkg-config --libs gtk4)"}
        ]}
    ]},

    %% ----------------------------------------------------------------
    %% NSECBUNKER crypto backend - standalone C executable
    %% ----------------------------------------------------------------
    {".*-linux.*", "priv/crypto/damage-nsecbunker-crypto-c/damage-nsecbunker-crypto-c",
        ["priv/crypto/damage-nsecbunker-crypto-c/src/main.c"], [
            {env, [
                {"CFLAGS", "$CFLAGS -O2 -Wall -Wextra"},
                {"LDFLAGS", "$LDFLAGS -lcrypto"}
            ]}
        ]},

    %% ----------------------------------------------------------------
    %% CPU NIF (gcc/clang) - shared object
    %% ----------------------------------------------------------------
    {".*-linux.*", "apps/ecai/priv/ecai.so", ["apps/ecai/c_src/ecai_nif.c"], [
        {env, [
            {"CFLAGS",
                "$CFLAGS $ERL_CFLAGS -fPIC "
                "-I/usr/lib/erlang/erts-*/include"},
            {"LDFLAGS", "$LDFLAGS -shared -lgmp -lcrypto"}
        ]}
    ]},

    %% macOS CPU NIF
    {".*-darwin.*", "apps/ecai/priv/ecai.so", ["apps/ecai/c_src/ecai_nif.c"], [
        {env, [
            {"CFLAGS",
                "$CFLAGS $ERL_CFLAGS -O2 -fPIC "
                "-I$(erl -eval 'io:format(\"~s\", [code:root_dir()])' -noshell)/erts-*/include"},
            {"LDFLAGS", "$LDFLAGS -bundle -undefined dynamic_lookup -lgmp -lcrypto"}
        ]}
    ]}
]}.

{provider_hooks, [
    {pre, [
        {compile, {pc, compile}},
        {clean, {pc, clean}}
    ]}
]}.

{pkg, [
    {profile, "prod"},
    {postinst_d, "apps/damage/priv/pkg/postinst.d"},
    {maintainer, "Steven <steven@damagebdd.com>"},
    {depends, [
        "bash",
        {deb, [
            %% Native libraries for the bundled ERM GTK4 C-node.
            "libgtk-4-1",
            "libx11-6",
            "tor",
            "libsodium23",
            "libsodium-dev",
            "libssl3"
        ]},
        {arch, [
            "kubo",
            "gtk4",
            "openssl"
        ]}
    ]},
    {recommends, [
        "cuda",
        "pass",
        "gnupg",
        "curl"
    ]},
    {suggests, []},

    {systemd_unit, "apps/damage/priv/pkg/damage.service"}
]}.
