# Change this example token! Use a long random secret. See README.
ECAI_VIDEO_KEYS={"customer1":"REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"}
ECAI_VIDEO_DATA=/data
ECAI_VIDEO_MAX_UPLOAD_MB=100
ECAI_VIDEO_MAX_SECONDS=180
# Operator-configured backends. Demo does NOT invoke a video AI model.
ECAI_VIDEO_BACKENDS={"demo":{"kind":"demo"}}
# Optional customer self-service connector onboarding. HTTPS endpoints only.
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# ECAI_VIDEO_FERNET_KEY=<your-Fernet-key>
# ECAI_VIDEO_ALLOWED_CONNECT_HOSTS=["queue.fal.run","fal.media","v3.fal.media"]
# Caution: allow result CDN hostnames for your actual provider.
# Example operator-managed fal integration:
# ECAI_VIDEO_BACKENDS={"demo":{"kind":"demo"},"fal":{"kind":"fal_queue","url":"https://queue.fal.run/fal-ai/kling-video/v3/pro/text-to-video","auth_env":"FAL_KEY","auth_scheme":"Key","output_path":"video.url","download_hosts":["fal.media","v3.fal.media"],"defaults":{"duration":"5","aspect_ratio":"16:9","generate_audio":false}}}
# FAL_KEY=REPLACE_WITH_YOUR_PERSONAL_FAL_API_KEY

# Managed-account dashboard integration (set the SAME random secret on ECAI node).
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
# ECAI_VIDEO_BRIDGE_SECRET=REPLACE_WITH_A_NEW_64_CHARACTER_HEX_SECRET
# Restrict port 9011 to localhost/private network, or use HTTPS.
