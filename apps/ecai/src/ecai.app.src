%%% -*- mode: erlang; erlang-indent-level: 2; -*-

{
    application,
    ecai,
    [
        {description, "ECAI - Elliptic Curve Artificial Intelligence."},
        {vsn, "0.1.0"},
        {registered, []},
        {mod, {ecai_app, []}},
        {applications, [
            kernel,
            stdlib,
            crypto,
            public_key,
            ssl,
            ranch,
            cowlib,
            cowboy,
            gun,
            poolboy,
            jsx,
            trails,
            os_mon,
            cowboy_swagger,
            vanillae,
            damage
        ]},
        {env, [
            {code_health_monitor_enabled, true},
            {code_health_interval_ms, 300000},
            {code_health_initial_delay_ms, 15000},
            {code_health_recent_log_limit, 12},
            {code_health_queue_timeout_ms, 15000},
            {code_health_request_timeout_ms, 30000},
            {code_health_connect_timeout_ms, 5000},
            {code_health_cluster_attempts, 2},
            {code_health_max_prompt_bytes, 65536},
            {code_health_model_statuses, [degraded, fail]},
            {code_health_provider, ollama},
            {code_log_learning_enabled, true},
            {code_log_learning_max_queue, 256},
            {code_log_learning_retry_limit, 5},
            {code_log_learning_retry_delay_ms, 30000},
            {code_log_learning_queue_timeout_ms, 30000},
            {code_log_learning_request_timeout_ms, 60000},
            {code_log_learning_connect_timeout_ms, 5000},
            {code_log_learning_cluster_attempts, 2},
            {code_log_learning_max_prompt_bytes, 65536},
            {code_log_learning_provider, ollama},
            {code_repair_feedback_enabled, true},
            {code_repair_feedback_min_confidence, medium},
            {code_repair_feedback_replay_limit, 100},
            {code_health_repair_feedback_enabled, true}
        ]},
        {modules, []},
        {licenses, ["Apache 2.0"]},
        {
            start_phases,
            [
                {start_trails_http, []}
            ]
        },
        {links, []}
    ]
}.
