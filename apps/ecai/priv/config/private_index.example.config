%% Merge these entries into the corresponding applications in sys.config.
%% Replace Owner, key_name and key_id with your authenticated account and the
%% references returned by ecai_private_keys:provision/2. No keys/passwords here.
[
 {damage, [{pqc_backend_module, secrets_pqc_oqs}]},
 {ecai, [
   {private_corpora, #{
     <<"engineering-private">> => #{
       owner => <<"REPLACE_WITH_AUTHENTICATED_ACCOUNT">>,
       base_dir => "/var/lib/damage/ecai/private/engineering-private",
       key_name => <<"REPLACE_WITH_PROVISIONED_KEY_NAME">>,
       key_id => <<"REPLACE_WITH_PROVISIONED_KEY_ID">>,
       readers => [],
       writers => [],
       llm_destinations => [<<"local-ollama">>],
       allow_remote_llm => false
     }
   }},
   {private_llm_destinations, #{
     <<"local-ollama">> => #{
       trust => local,
       options => #{provider => ollama, host => "127.0.0.1", port => 11434,
                    model => <<"REPLACE_WITH_INSTALLED_LOCAL_MODEL">>}
     }
   }}
 ]}
].
