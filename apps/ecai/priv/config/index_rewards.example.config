%% Merge selected settings into the EXISTING ecai section; do not replace
%% your sys.config. Public-key placeholders MUST be replaced. No secrets here.
[{ecai, [
    {index_jobs_max_concurrency, 1},
    %% Omit indexing_worker_nodes for local-only operation. Multi-node workers
    %% need the same code, a private trusted Erlang cluster and shared paths.
    %% {indexing_worker_nodes, ['damage@desktop-a', 'damage@desktop-b']},
    {wikimedia_work_dir, "/srv/ecai-share/wikimedia-work"},
    {index_rewards_enabled, false},
    {index_rewards_config, #{
        %% LOCAL to ONE coordinator, not a shared multi-writer DETS file.
        ledger_file => "/var/lib/damage/ecai/rewards/index-rewards.dets",
        treasury_node => <<"REPLACE_WITH_CLN_GETINFO_ID">>,
        network => <<"regtest">>,
        payment_method => xpay,
        payments_enabled => false,
        allow_mainnet => false,
        max_budget_msat => 10000000,
        max_fee_msat => 1000,
        creators => [<<"REPLACE_CREATOR_ACCOUNT">>],
        participants => #{
            <<"REPLACE_CREATOR_ACCOUNT">> => <<"REPLACE_CREATOR_REFUND_LN_NODE">>,
            <<"REPLACE_INDEXER_ACCOUNT">> => <<"REPLACE_INDEXER_LN_NODE">>,
            <<"REPLACE_VERIFIER_ACCOUNT">> => <<"REPLACE_VERIFIER_LN_NODE">>
        }
    }}
]}].
