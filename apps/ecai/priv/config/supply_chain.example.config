%% Merge these entries into the existing {ecai, [...]} section of sys.config.
%% Defaults already enable the local synthetic lab; no configuration is required.
[
 {ecai, [
   {supply_chain_enabled, true},
   {supply_chain_public_enabled, true}, %% Set false to disable only guest demos.
   {supply_chain_curve_addresses, false}
   %% Behind a TLS-terminating proxy, set the exact browser origin (no trailing slash).
   %% ,{supply_chain_public_origin, <<"https://ecai.example.org">>}
   %% Optional absolute path; default uses ecai_paths:runtime_dir()/supply-chain.
   %% ,{supply_chain_state_dir, "/var/lib/damage/runtime/ecai/supply-chain"}
 ]}
].
