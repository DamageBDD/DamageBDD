%% Merge into the existing ecai proplist in sys.config, NOT a replacement file.
%% Alternatively edit the eval_* fields in Node administration -> ECAI settings.
%% Only the operator configures URLs and credential references. Do not put keys
%% in datasets, account settings, prompts, generated evidence or Git.
[
 {ecai, [
   {eval_enabled, false},
   {eval_allow_remote, false},
   {eval_target_ids, ["eval-local"]},
   {eval_max_parallel, 2},
   {eval_max_parallel_per_account, 1},
   {eval_daily_calls, 1000},
   {eval_node_daily_calls, 10000},
   {eval_max_run_calls, 500},
   {eval_max_output_tokens, 2048},
   {eval_min_reviewers, 1},
   {eval_min_pass_bps, 9500},
   {eval_retention_days, 30},
   %% Extend your existing list; do not overwrite production inference nodes.
   {code_model_nodes, [
     #{id => <<"eval-local">>, provider => ollama,
       host => "127.0.0.1", port => 11434, transport => tcp,
       models => [<<"REPLACE_WITH_INSTALLED_MODEL_TAG">>],
       default_model => <<"REPLACE_WITH_INSTALLED_MODEL_TAG">>,
       max_inflight => 1}
     %% Optional remote configuration; also requires eval_allow_remote=true,
     %% the node allowlist and the account's explicit remote consent.
     %% ,#{id => <<"eval-cloud">>, provider => openai,
     %%    host => "api.openai.com", port => 443, transport => tls,
     %%    default_model => <<"REPLACE_WITH_FIXED_MODEL_SNAPSHOT">>,
     %%    api_key_env => "ECAI_EVAL_OPENAI_API_KEY", max_inflight => 1}
   ]}
 ]}
].
