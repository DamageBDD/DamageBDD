%% Merge into the EXISTING ecai application environment. Do not replace config.
%% Defaults never submit a cloud job, Lightning payment or NFT transaction.
[{ecai,[
  {source_retrieval_max_bytes,67108864},
  {disk_index_batch_docs,1000},
  {disk_index_flush_interval_ms,2000},
  {knowledge_backend_timeout_ms,5000},
  %% Only explicit public corpus directories belong here. Never private corpora.
  %% Omit this entry to use ecai_paths:ipfs_index_dir() automatically.
  {knowledge_disk_indexes,[
    #{id => <<"public-ipfs">>,dir => "/var/lib/damage/runtime/ecai/ipfs-index"}
  ]},
  %% Current Wikimedia service has one active live build. Serialize Wikimedia
  %% jobs on a node; use isolated funded shards for multi-node fan-out.
  {index_jobs_max_concurrency,1},
  {index_rewards_enabled,false},
  {index_pool_enabled,false}
]}].
