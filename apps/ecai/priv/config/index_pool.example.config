%% MERGE these entries into the corresponding existing application sections.
%% Never replace a working sys.config with this example. No real keys below.
%% Coordinator example: enable only after the tests and a CLN regtest exercise.
[
 {ecai, [
    {index_rewards_enabled, false},
    {index_pool_enabled, false},
    {indexing_worker_nodes, ['damage@desktop-a', 'damage@desktop-b']},
    {index_pool_shared_root, "/srv/ecai-share"},
    {index_pool_max_inflight, 2},
    {index_pool_tick_ms, 1000},
    {index_pool_max_snapshot_bytes, 67108864},
    {index_pool_shard_limits, #{max_shard_bytes => 8388608,
        max_line_bytes => 2097152, max_lines_per_shard => 1000, max_shards => 256}},
    {index_jobs_max_concurrency, 1},
    {index_rewards_config, #{
        ledger_file => "/var/lib/damage/ecai/index-rewards.dets",
        %% Replace with damage_cln:getinfo() id from the COORDINATOR.
        treasury_node => <<"REPLACE_WITH_COORDINATOR_LN_NODE_ID">>,
        network => <<"regtest">>,
        payment_method => xpay,
        payments_enabled => false,
        allow_mainnet => false,
        max_budget_msat => 10000000, %% 10,000 satoshi maximum per campaign
        max_fee_msat => 1000,       %% one satoshi maximum fee per payout
        creators => [],            %% pool grants require DamageBDD node_admins
        participants => #{}        %% successful pool enrollments persist separately
    }}
 ]}
].

