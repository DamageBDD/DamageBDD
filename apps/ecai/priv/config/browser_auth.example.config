%% Merge into the EXISTING ecai environment; do not replace sys.config.
%% Keep damage.browser_auth.origin set to DamageBDD's own public origin.
%% An ECAI origin is required explicitly: never trust the incoming Host header.
[
    {ecai, [
        {browser_auth_origin, "https://ecai.damagebdd.com"}
    ]}
].
%% Local development only: use the exact localhost scheme/port and the existing
%% DamageBDD cookie_secure=false setting. Never disable Secure for public HTTPS.
%% Admin, pool and payments switches are deliberately NOT enabled here.
