%% Merge into your release sys.config. Start on CLN regtest and AE testnet.
%% Replace all identity placeholders, register real manifests, then enable sales.
[{ecai, [
    {personality_sales_enabled, false},
    {personality_lightning, #{
        treasury_node => <<"REPLACE_WITH_66_HEX_CHAR_CLN_NODE_ID">>,
        network => <<"regtest">>,
        allow_mainnet => false
    }},
    {personality_nft, #{
        enabled => false,
        contract_id => <<"ct_REPLACE_WITH_DEPLOYED_CONTRACT">>,
        network_id => <<"ae_uat">>,
        confirmations => 3
    }}
    %% Optional: {personality_store_dir, "/var/lib/ecai/personality-sales"}
    %% Optional: {personality_package_dir, "/var/lib/ecai/personality-packages"}
    %% Set personality_catalog to a list of complete product maps. See doc/personality_sales.md.
]}].
