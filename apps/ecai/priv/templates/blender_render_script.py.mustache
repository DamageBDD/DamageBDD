scene = bpy.context.scene

# Common resolution settings
scene.render.resolution_x = {{res_x}}
scene.render.resolution_y = {{res_y}}
scene.render.resolution_percentage = 100


root, ext = os.path.splitext(output_path)
ext = ext.lower()

video_exts = {'.mp4', '.mkv', '.mov', '.avi', '.webm'}

audio_path = "{{audio_path}}".strip()

if ext in video_exts:
    # ---- VIDEO: render PNG frames, then ffmpeg; audio provided by Erlang ----
    tmp_dir = tempfile.mkdtemp(prefix="ecai_frames_")

    scene.render.image_settings.file_format = 'PNG'

    for f in range(scene.frame_start, scene.frame_end + 1):
        scene.frame_set(f)
        scene.render.filepath = os.path.join(tmp_dir, f"f_%04d" % f)
        bpy.ops.render.render(write_still=True)

    fps = scene.render.fps if scene.render.fps > 0 else 24
    pattern = os.path.join(tmp_dir, "f_%04d.png")

    cmd = [
        "ffmpeg",
        "-y",
        "-framerate", str(fps),
        "-i", pattern,
    ]

    if audio_path and os.path.exists(audio_path):
        cmd += ["-i", audio_path, "-shortest", "-c:a", "aac", "-b:a", "192k"]
    else:
        print("ECAI/Blender: no audio_path provided or file missing, rendering silent video")
        print(audio_path)
        exit(1)


    cmd += ["-c:v", "libx264", "-pix_fmt", "yuv420p", output_path]

    try:
        subprocess.run(cmd, check=True)
    except Exception as e:
        print("FFmpeg failed:", e)
else:
    # ---- STILL IMAGE ----
    scene.frame_set({{frame}})
    scene.render.image_settings.file_format = '{{format}}'
    scene.render.filepath = output_path
    bpy.ops.render.render(write_still=True)
