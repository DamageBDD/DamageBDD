  <section class="surface panel-pad math-evidence" aria-labelledby="mathEvidenceTitle">
    <div class="panel-heading"><div><div class="eyebrow">EXACT CLAIMS HAVE EXPLICIT LIMITS</div><h2 id="mathEvidenceTitle">Verification, search bounds &amp; provenance</h2></div><div class="inline-actions"><button type="button" id="mathExport" class="button button-outline button-sm" disabled>Export path JSON</button><button type="button" id="mathBundle" class="button button-outline button-sm" disabled>Export evidence bundle</button></div></div>
