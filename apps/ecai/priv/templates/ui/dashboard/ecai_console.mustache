<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="ECAI node control plane: search, conversational access, indexing, private knowledge and operations">
  <meta name="referrer" content="no-referrer">
  <meta name="theme-color" content="#101b32">
  <title>{{brand_name}} · Control plane</title>
  {{#has_brand_favicon}}<link rel="icon" href="{{brand_favicon}}">{{/has_brand_favicon}}
  <link rel="stylesheet" href="/static/css/ecai-model-internals.css?v=model-internals-v1">
  <link rel="stylesheet" href="/static/css/ecai-console.css?v=personality-conversations-v1">
  <link rel="stylesheet" href="/static/css/ecai-personalities.css?v=personalities-v1">
  <link rel="stylesheet" href="/static/css/ecai-eval.css?v=eval-v1">
  <link rel="stylesheet" href="/static/css/ecai-math-paths.css?v=math-samples-explorer-v2">
  <link rel="stylesheet" href="/static/css/ecai-video.css">
  <link rel="stylesheet" href="/static/css/ecai-market-maker.css">
  <link rel="stylesheet" href="/ecai/auth-assets/css/auth.css">
  <link rel="stylesheet" href="/static/css/ecai-auth.css">
  <link rel="stylesheet" href="/static/css/ecai-quick-index.css?v=quick-index-v2">
  <link rel="stylesheet" href="/static/css/ecai-index-pool.css">
  <link rel="stylesheet" href="/static/css/ecai-compute-settings.css">
  <link rel="stylesheet" href="/static/css/ecai-keys.css">
  <link rel="stylesheet" href="/api/themes/css?app=ecai">
</head>
<body>
  <div class="console-shell" id="ecaiConsole" data-node-version="{{node_version}}">
    <aside class="console-sidebar" id="consoleSidebar" aria-label="Primary navigation">
      <div class="brand-block">
        {{#has_brand_logo}}<img class="theme-brand-logo" src="{{brand_logo}}" alt="">{{/has_brand_logo}}
        {{^has_brand_logo}}<div class="brand-symbol" aria-hidden="true">e<span>·</span></div>{{/has_brand_logo}}
        <div><div class="brand-name">{{brand_name}}</div><div class="brand-caption">{{brand_tagline}}</div></div>
        <button class="icon-button sidebar-close" type="button" id="closeNav" aria-label="Close menu">×</button>
      </div>
      <div class="sidebar-label">WORKSPACE</div>
      <nav id="consoleNav" class="main-nav" aria-label="ECAI areas">
        <button type="button" data-view="overview" class="nav-link is-active" aria-current="page"><span class="nav-icon" aria-hidden="true">◫</span>Overview</button>
        <button type="button" data-view="search" class="nav-link"><span class="nav-icon" aria-hidden="true">⌕</span>Knowledge search</button>
        <button type="button" data-view="evaluation" class="nav-link"><span class="nav-icon" aria-hidden="true">✓</span>LLM evaluation</button>
        <button type="button" data-view="math" class="nav-link"><span class="nav-icon" aria-hidden="true">↝</span>Mathematical paths</button>
        <button type="button" data-view="personalities" class="nav-link"><span class="nav-icon" aria-hidden="true">◉</span>AI personalities</button>
        <button type="button" data-view="chat" class="nav-link"><span class="nav-icon" aria-hidden="true">▤</span>Conversation</button>
        <button type="button" data-view="video" class="nav-link"><span class="nav-icon" aria-hidden="true">▸</span>Video Studio</button>
        <button type="button" data-view="indexing" class="nav-link"><span class="nav-icon" aria-hidden="true">▦</span>Index jobs</button>
        <button type="button" data-view="compute" class="nav-link"><span class="nav-icon" aria-hidden="true">⌁</span>Compute &amp; NFTs</button>
        <button type="button" data-view="keys" class="nav-link"><span class="nav-icon" aria-hidden="true">⌑</span>Keys</button>
        <button type="button" data-view="network" class="nav-link" id="indexPoolNav" hidden><span class="nav-icon" aria-hidden="true">ϟ</span>Funded indexing</button>
        <button type="button" data-view="wikimedia" class="nav-link"><span class="nav-icon" aria-hidden="true">◎</span>Wikimedia</button>
        <button type="button" data-view="knowledge" class="nav-link"><span class="nav-icon" aria-hidden="true">⌘</span>Knowledge &amp; privacy</button>
        <button type="button" data-view="marketplace" class="nav-link"><span class="nav-icon" aria-hidden="true">◇</span>Marketplace</button>
        <button type="button" data-view="market-maker" class="nav-link"><span class="nav-icon" aria-hidden="true">◈</span>Market Maker</button>
        <button type="button" data-view="code" class="nav-link" id="codeAdminNav" hidden><span class="nav-icon" aria-hidden="true">▣</span>Code learning &amp; repair</button>
        <button type="button" data-view="operations" class="nav-link"><span class="nav-icon" aria-hidden="true">≋</span>Operations</button>
        <button type="button" data-view="api" class="nav-link"><span class="nav-icon" aria-hidden="true">{ }</span>API explorer</button>
      </nav>
      <div class="sidebar-bottom">
        <div class="sidebar-label">EXISTING TOOLS</div>
        <a href="/indexer" class="subtle-link">Simple indexer <span aria-hidden="true">↗</span></a>
        <a href="/indexer/advanced" class="subtle-link">Advanced indexer <span aria-hidden="true">↗</span></a>
        <a href="/chat" class="subtle-link">Legacy chat <span aria-hidden="true">↗</span></a>
        <div class="node-mark"><span class="node-dot" id="sidebarStatusDot"></span><span id="sidebarNodeState">Node not checked</span><span class="node-version">{{node_version}}</span></div>
      </div>
    </aside>

    <div class="console-body">
      <header class="console-topbar">
        <div class="topbar-leading">
          <button type="button" class="icon-button mobile-nav-trigger" id="openNav" aria-label="Open menu">☰</button>
          <div class="breadcrumb">ECAI <span aria-hidden="true">/</span> <strong id="viewBreadcrumb">Overview</strong></div>
        </div>
        <div class="topbar-actions">
          <span class="topbar-runtime" id="topbarRuntime">Connecting to node…</span>
          <button type="button" id="refreshView" class="icon-button refresh-icon" title="Refresh current view" aria-label="Refresh current view">↻</button>
          <span class="topbar-divider" aria-hidden="true"></span>
          <span class="console-session-kind" id="consoleSessionKind"></span>
          <span class="signed-in" id="authIdentity">Guest access</span>
          <button type="button" class="button button-outline button-sm" id="loginBtn">Sign in</button>
          <button type="button" class="button button-outline button-sm" id="createAccountBtn">Create account</button>
          <button type="button" class="button button-primary button-sm" id="connectWalletBtn">Connect wallet</button>
          <button type="button" class="button button-outline button-sm" id="switchAccountBtn" hidden>Switch account</button>
          <button type="button" class="button button-outline button-sm" id="logoutBtn" hidden>Sign out</button>
        </div>
      </header>

      <main class="console-main" id="consoleMain">
        <div id="consoleAuthStatus" class="console-auth-status" role="status" aria-live="polite"></div>
        <aside id="consoleWalletNotice" class="console-wallet-notice" hidden>
          <div><strong>Wallet identity verified · restricted session</strong><p>Public search and conversation are available. Indexing, private corpora, node administration and Lightning rewards require managed email sign-in. Connecting a wallet does not authorize payments or link it to an email account.</p></div>
          <button type="button" id="walletManagedLogin" class="button button-outline button-sm">Sign in with email</button>
        </aside>
        <section class="view is-visible" data-panel="overview" aria-labelledby="overviewTitle">
          <div class="welcome-banner">
            <div>
              <div class="eyebrow eyebrow-light">NODE CONTROL PLANE <span class="dot-separator">•</span> LIVE SYSTEM VIEW</div>
              <h1 id="overviewTitle">Intelligence, in view.</h1>
              <p>One workspace for the ECAI search fabric, durable indexing queue, private knowledge and marketplace.</p>
              <div class="banner-actions"><button type="button" class="button button-light" data-go="search">Explore the index <span aria-hidden="true">↗</span></button><button type="button" class="button button-glass" data-go="indexing">Manage jobs</button></div>
            </div>
            <div class="orbit-art" aria-hidden="true"><div class="orbit orbit-1"></div><div class="orbit orbit-2"></div><div class="orbit orbit-3"></div><div class="orbit-core"></div><i class="orbit-node n1"></i><i class="orbit-node n2"></i><i class="orbit-node n3"></i></div>
          </div>
          <div class="video-overview-cta"><div><strong>Video Studio</strong><span>Bring your own model, reuse assets and verify every revision.</span></div><button type="button" class="button button-outline button-sm" data-go="video">Open Video Studio ↗</button></div>
          <div class="video-overview-cta"><div><strong>Market Maker</strong><span>Observe Coinstore DAMAGE/BTC, tune paper quotes and audit trading performance.</span></div><button type="button" class="button button-outline button-sm" data-go="market-maker">Open Market Maker ↗</button></div>
          <div class="metric-grid" aria-label="Node statistics">
            <article class="metric-card"><div class="metric-label">Indexed documents <span aria-hidden="true">↗</span></div><div id="metricDocs" class="metric-value">—</div><div class="metric-foot">Yelp / search index</div></article>
            <article class="metric-card"><div class="metric-label">Running jobs <span aria-hidden="true">◉</span></div><div id="metricRunning" class="metric-value">—</div><div class="metric-foot">Durable indexing queue</div></article>
            <article class="metric-card"><div class="metric-label">Queued jobs <span aria-hidden="true">▥</span></div><div id="metricQueued" class="metric-value">—</div><div class="metric-foot">Awaiting execution</div></article>
            <article class="metric-card"><div class="metric-label">Chat service <span aria-hidden="true">◌</span></div><div id="metricChat" class="metric-value metric-word">Checking</div><div class="metric-foot">Local ECAI endpoint</div></article>
          </div>
          <div class="two-column">
            <section class="surface panel-pad">
              <div class="panel-heading"><div><div class="eyebrow">OPERATIONS</div><h2>Recent index activity</h2></div><button type="button" class="text-button" data-go="indexing">All jobs →</button></div>
              <div id="overviewJobs" class="overview-jobs"><div class="empty-state">Sign in to see current queue activity.</div></div>
            </section>
            <section class="surface panel-pad">
              <div class="panel-heading"><div><div class="eyebrow">SYSTEM</div><h2>Service availability</h2></div><button type="button" id="refreshHealth" class="text-button">Recheck ↻</button></div>
              <div class="service-list" id="overviewServices"><div class="empty-state">Checking connected APIs…</div></div>
              <p class="context-hint">Availability is based on real endpoint responses, not simulated metrics.</p>
            </section>
          </div>
        </section>

        <!-- The Video Studio panel is intentionally inlined: a running Erlang
             dashboard handler need not be recompiled to supply its markup.
             Keep this block in sync with ecai_video.mustache; contract tests
             compare both copies to prevent template drift. -->
        <section class="view" data-panel="video" data-ecai-managed aria-labelledby="videoTitle" hidden>
          <div class="video-hero">
            <div>
              <div class="eyebrow eyebrow-light">VIDEO FASTPATH · BRING YOUR OWN MODEL</div>
              <h1 id="videoTitle">Generate once. Reuse with proof.</h1>
              <p>Connect a video backend, import an existing clip or generate a new one. Make local edits without paying for another model run, then verify every version.</p>
              <div class="video-hero-actions">
                <button class="button button-light" type="button" id="videoStartProject">New project ↗</button>
                <button class="button button-glass" type="button" id="videoRefresh">Refresh studio</button>
              </div>
            </div>
            <div class="video-hero-status"><span class="video-status-dot" id="videoStatusDot"></span><span id="videoServiceState">Checking video service…</span></div>
          </div>
          <p id="videoNotice" class="video-notice" role="status" aria-live="polite">Sign in with a managed account to use Video Studio.</p>
          <div class="video-metrics" aria-label="Video Fastpath metrics">
            <article class="surface video-metric"><span>Projects</span><strong id="videoMetricProjects">—</strong></article>
            <article class="surface video-metric"><span>Versions</span><strong id="videoMetricVersions">—</strong></article>
            <article class="surface video-metric"><span>Model calls avoided</span><strong id="videoMetricAvoided">—</strong></article>
            <article class="surface video-metric"><span>External submissions</span><strong id="videoMetricSubmissions">—</strong></article>
          </div>
          <div class="video-layout">
            <div class="video-column">
              <section class="surface panel-pad" id="videoProjectSection">
                <div class="panel-heading"><div><div class="eyebrow">01 · WORKSPACE</div><h2>Video projects</h2></div><span class="status-tag">Account-scoped</span></div>
                <form id="videoProjectForm" class="stack-form">
                  <label for="videoProjectTitle">Project name<input id="videoProjectTitle" maxlength="160" required placeholder="Autumn product campaign"></label>
                  <div class="field-grid">
                    <label for="videoLicense">Asset licence<input id="videoLicense" maxlength="128" value="all-rights-reserved" required></label>
                    <label for="videoTags">Tags (comma-separated)<input id="videoTags" placeholder="campaign, australia"></label>
                  </div>
                  <button type="submit" class="button button-primary">Create project</button>
                </form>
                <div class="video-picker"><label for="videoProjectSelect">Active project</label><select id="videoProjectSelect" aria-label="Active video project"><option value="">Choose or create a project</option></select></div>
              </section>
              <section class="surface panel-pad">
                <div class="panel-heading"><div><div class="eyebrow">02 · GENERATION</div><h2>Your video backend</h2></div><span class="status-tag">Bring your own API</span></div>
                <p class="context-hint">Choose a configured backend or register a connector. Customer API keys go to the server and are not saved in the browser.</p>
                <label for="videoBackendSelect" class="video-label">Generation backend</label>
                <select id="videoBackendSelect"><option value="">No backend selected</option></select>
                <details id="videoConnectorDetails" class="video-connector">
                  <summary>Connect an API provider <span aria-hidden="true">▾</span></summary>
                  <p id="videoConnectorPolicy" class="context-hint">Loading the operator-approved connection policy…</p>
                  <form id="videoBackendForm" class="stack-form">
                    <label for="videoBackendId">Connection ID<input id="videoBackendId" required maxlength="48" pattern="[A-Za-z0-9_-]+" placeholder="my-video-model"></label>
                    <label for="videoBackendKind">Protocol<select id="videoBackendKind"><option value="http_sync">HTTP JSON → video URL</option><option value="fal_queue">fal.ai queue</option></select></label>
                    <label for="videoBackendUrl">Generation API URL<input id="videoBackendUrl" required type="url" placeholder="https://approved-provider.example/generate"></label>
                    <label for="videoBackendKey">Provider API key<input id="videoBackendKey" type="password" required minlength="8" autocomplete="off" placeholder="Stored encrypted on Fastpath"></label>
                    <label for="videoBackendAuthScheme">Authorization scheme<select id="videoBackendAuthScheme"><option>Bearer</option><option>Key</option></select></label>
                    <label for="videoBackendHosts">Video download hosts (comma-separated)<input id="videoBackendHosts" placeholder="cdn.example.com"></label>
                    <label for="videoBackendResultPath">Response video field<input id="videoBackendResultPath" value="video_url" placeholder="video.url"></label>
                    <button type="submit" class="button button-outline">Save backend connection</button>
                  </form>
                </details>
                <form id="videoGenerateForm" class="stack-form video-generate-form">
                  <label for="videoPrompt">Describe the video<textarea id="videoPrompt" rows="4" required minlength="1" maxlength="3000" placeholder="A cinematic product reveal with slow camera movement…"></textarea></label>
                  <button type="submit" class="button button-primary" id="videoGenerateBtn">Generate video ↗</button>
                  <p class="context-hint">Third-party models can incur fees. The demo backend creates a synthetic test clip, not AI footage.</p>
                </form>
                <div id="videoJobArea" class="video-job" role="status" aria-live="polite">No active generation.</div>
              </section>
              <section class="surface panel-pad">
                <div class="panel-heading"><div><div class="eyebrow">03 · IMPORT</div><h2>Have a video already?</h2></div></div>
                <p class="context-hint">Skip generation entirely. Register an existing MP4 as a verifiable source asset (up to 25 MiB in the dashboard).</p>
                <form id="videoImportForm" class="stack-form">
                  <label for="videoImportFile">Choose MP4<input id="videoImportFile" type="file" accept="video/mp4,.mp4" required></label>
                  <button class="button button-outline" type="submit">Import MP4</button>
                </form>
              </section>
            </div>
            <div class="video-column">
              <section class="surface panel-pad">
                <div class="panel-heading"><div><div class="eyebrow">04 · ASSET LIBRARY</div><h2>Version history</h2></div><button type="button" id="videoReloadVersions" class="text-button">Reload ↻</button></div>
                <div id="videoVersions" class="video-versions"><div class="empty-state">Select a project to browse verified clips.</div></div>
                <div class="video-selected" id="videoSelected" aria-live="polite">No video version selected.</div>
                <div class="video-preview"><video id="videoPlayer" controls playsinline preload="none" hidden></video><div id="videoPreviewEmpty" class="video-preview-empty">Select a version, then load a preview.</div></div>
                <div class="inline-actions video-actions">
                  <button type="button" id="videoPreviewBtn" class="button button-outline button-sm" disabled>Load preview</button>
                  <button type="button" id="videoDownloadBtn" class="button button-outline button-sm" disabled>Download MP4</button>
                  <button type="button" id="videoVerifyBtn" class="button button-primary button-sm" disabled>Verify integrity</button>
                </div>
                <div id="videoVerifyResult" role="status" aria-live="polite" class="video-proof">The signature, bytes and parent lineage can be verified independently of the generation backend.</div>
              </section>
              <section class="surface panel-pad">
                <div class="panel-heading"><div><div class="eyebrow">05 · SHORT-CIRCUIT</div><h2>Revise without regenerating</h2></div><span class="status-tag">Local-first</span></div>
                <p class="context-hint">Change metadata and reuse the exact MP4. Captions or trims invoke local FFmpeg, not an AI model.</p>
                <form id="videoRevisionForm" class="stack-form">
                  <label for="videoOperation">Revision type<select id="videoOperation"><option value="metadata">Metadata · exact media reuse</option><option value="caption">Caption · local render</option><option value="trim">Trim · local render</option></select></label>
                  <label id="videoRevisionTextLabel" for="videoRevisionText">Revision note<input id="videoRevisionText" maxlength="1000" placeholder="Localized AUD offer"></label>
                  <div id="videoTrimFields" class="field-grid" hidden><label for="videoTrimStart">Start (seconds)<input id="videoTrimStart" type="number" min="0" step="0.1" value="0"></label><label for="videoTrimEnd">End (seconds)<input id="videoTrimEnd" type="number" min="0.1" step="0.1" value="5"></label></div>
                  <button type="submit" id="videoReviseBtn" class="button button-primary" disabled>Create version ↗</button>
                </form>
              </section>
              <section class="surface panel-pad">
                <div class="panel-heading"><div><div class="eyebrow">06 · PROVENANCE</div><h2>Verify &amp; prepare an NFT</h2></div><span class="status-tag">Mint not included</span></div>
                <div class="inline-actions video-actions">
                  <button type="button" id="videoManifestBtn" class="button button-outline button-sm" disabled>View signed manifest</button>
                  <button type="button" id="videoGraphBtn" class="button button-outline button-sm" disabled>View dependency graph</button>
                </div>
                <pre id="videoProofOutput" class="code-display video-output">Select a version to inspect its provenance.</pre>
                <form id="videoNftForm" class="stack-form">
                  <label for="videoCid">Already-published video IPFS CID<input id="videoCid" placeholder="bafy…" required></label>
                  <button type="submit" class="button button-outline" id="videoNftBtn" disabled>Prepare NFT metadata</button>
                  <p class="context-hint">Returns an unsigned metadata draft. It does not upload to IPFS, verify your CID or mint a token.</p>
                </form>
              </section>
            </div>
          </div>
        </section>

        <section class="view" data-panel="search" aria-labelledby="searchTitle" hidden>
          <div class="page-intro"><div class="eyebrow">RETRIEVAL</div><h1 id="searchTitle">Knowledge search</h1><p>Search indexed records and inspect returned verification material.</p></div>
          <section class="surface panel-pad">
            <form id="searchForm" class="search-form"><label for="searchQuery" class="sr-only">Search query</label><span class="search-leading" aria-hidden="true">⌕</span><input id="searchQuery" type="search" placeholder="Search the ECAI fabric…" required minlength="1" maxlength="2048"><label class="compact-field">Results <input type="number" id="searchLimit" min="1" max="100" value="10"></label><button class="button button-primary" type="submit">Search</button></form>
            <div class="form-meta"><span id="searchStatus" role="status">Search is available without signing in.</span><span>POST /ecai/search</span></div>
            <div id="searchResults" class="result-stack"><div class="empty-state">Start with a name, term, category or location.</div></div>
          </section>
          <details class="surface expandable"><summary>Verification payload <span class="expand-arrow">⌄</span></summary><pre id="searchProofs" class="code-display">Run a search to view the proofs returned by the server.</pre></details>
        </section>

        <section class="view" data-panel="chat" aria-labelledby="chatTitle" hidden>
          <div class="page-intro"><div class="eyebrow">CONVERSATION</div><h1 id="chatTitle">Speak to the knowledge layer</h1><p>Signed-in conversations are durable, searchable through the private ECAI term index and can be grouped into projects. Guest chat remains an isolated session. Replies depend on the configured backend and are not cryptographic proofs.</p></div>
          <div class="chat-workspace">
            <aside class="surface chat-history-panel" id="chatHistoryPanel" aria-label="Conversation history">
              <div class="chat-history-actions">
                <button type="button" class="button button-primary chat-new-button" id="newChatBtn">＋ New chat</button>
                <button type="button" class="chat-search-button" id="chatSearchBtn"><span aria-hidden="true">⌕</span><span>Search chats</span><kbd>⌘K</kbd></button>
              </div>
              <div class="chat-history-auth" id="chatHistoryAuth">Sign in or connect a wallet to save account-scoped history, search messages and use projects.</div>
              <div class="chat-history-section">
                <div class="chat-history-heading"><span>Projects</span><button type="button" class="chat-history-icon-button" id="chatNewProjectBtn" aria-label="Create project">＋</button></div>
                <button type="button" class="chat-history-item is-active" id="chatAllChats"><span class="chat-history-icon" aria-hidden="true">◫</span><span class="chat-history-copy"><strong>All chats</strong><small>Every project</small></span></button>
                <div id="chatProjects" class="chat-project-list"></div>
              </div>
              <div class="chat-history-section chat-history-recent">
                <div class="chat-history-heading"><span>Recent</span><button type="button" class="chat-history-icon-button" id="chatHistoryRefresh" aria-label="Refresh conversation history">↻</button></div>
                <div id="chatHistoryList" class="chat-history-list"><div class="chat-history-empty">Sign in to keep account-scoped history.</div></div>
              </div>
            </aside>
            <div class="surface chat-layout">
              <div class="chat-toolbar">
                <button type="button" class="chat-history-toggle" id="chatHistoryToggle" aria-controls="chatHistoryPanel" aria-expanded="false" aria-label="Toggle conversation history">☰</button>
                <span class="status-indicator"><span class="status-pulse"></span>ECAI chat</span>
                <div class="chat-thread-heading"><strong id="chatConversationTitle">New conversation</strong><span id="chatProjectLabel" class="small muted">Guest session</span></div>
                <span id="chatSessionLabel" class="mono small">New session</span>
                <div class="chat-thread-actions">
                  <button type="button" class="text-button" id="chatRenameBtn" disabled>Rename</button>
                  <select id="chatMoveProject" class="chat-project-select" aria-label="Move conversation to project" disabled><option value="">No project</option></select>
                  <button type="button" class="text-button chat-delete-button" id="chatDeleteBtn" disabled>Delete</button>
                </div>
              </div>
              <div class="chat-personality-bar">
                <div class="chat-personality-choice"><label for="chatPersonality">PERSONALITY</label><select id="chatPersonality" aria-describedby="chatPersonalityStatus"><option value="default">ECAI default · built-in</option></select></div>
                <button type="button" id="chatPersonalityRefresh" class="icon-button" aria-label="Refresh owned personalities" title="Refresh owned personalities">↻</button>
                <button type="button" class="text-button" data-go="personalities">Explore personalities ↗</button>
                <p id="chatPersonalityStatus" class="chat-personality-status" role="status" aria-live="polite">Guest conversations use ECAI default.</p>
              </div>
              <div class="chat-messages" id="chatMessages" aria-live="polite"><div class="chat-welcome"><div class="welcome-icon">e·</div><h2>Ask a question</h2><p>Guest messages use a temporary session. Sign in to keep searchable conversation history.</p></div></div>
              <form id="chatForm" class="composer"><label class="sr-only" for="chatPrompt">Your message</label><textarea id="chatPrompt" rows="2" required maxlength="16384" placeholder="Ask the ECAI knowledge layer…"></textarea><button class="button button-primary" type="submit" id="chatSend">Send ↗</button></form>
              <div class="form-meta"><span id="chatStatus" role="status">Ready</span><span>Saved + privately indexed when signed in</span></div>
            </div>
          </div>
