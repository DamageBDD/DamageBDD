<header class="ecai-indexer-header">
  <div>
    <h1>ECAI Indexer</h1>
    <p class="ecai-indexer-muted">advanced operator console · durable queue · live progress · NFT-ready artifacts · {{node_version}}</p>
  </div>

  <div class="ecai-indexer-grow"></div>

  <div class="ecai-indexer-auth-summary" aria-live="polite">
    <a class="ecai-indexer-view-link" href="{{indexer_path}}">Simple view</a>
    <span id="authState" class="bad">sign in required</span>
    <span id="authIdentity" class="ecai-indexer-muted"></span>
    <button id="loginBtn" type="button">Sign in</button>
    <button id="logoutBtn" type="button" hidden>Sign out</button>
  </div>
</header>
