<section class="ecai-indexer-panel" data-component="queue-status">
  <h2>Queue status</h2>
  <div class="ecai-indexer-statusbar">
    <div class="ecai-indexer-metric"><span>Concurrency</span><b id="mConcurrency">–</b></div>
    <div class="ecai-indexer-metric"><span>Running</span><b id="mRunning">–</b></div>
    <div class="ecai-indexer-metric"><span>Queued</span><b id="mQueued">–</b></div>
    <div class="ecai-indexer-metric"><span>Workers</span><b id="mWorkers">–</b></div>
  </div>
  <div class="ecai-indexer-row ecai-indexer-panel-actions">
    <button id="doctorBtn" type="button">Doctor</button>
    <button id="sourcesBtn" type="button">List sources</button>
    <button id="planBtn" type="button">Preview plan</button>
    <span id="connectionState" class="ecai-indexer-muted">not connected</span>
  </div>
</section>
