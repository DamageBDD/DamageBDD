<section class="ecai-indexer-panel" data-component="jobs">
  <div class="ecai-indexer-row">
    <h2 class="ecai-indexer-grow">Index jobs</h2>
    <select id="stateFilter" aria-label="Filter jobs by state">
      <option value="">all states</option>
      <option>queued</option>
      <option>preparing</option>
      <option>running</option>
      <option>pause_requested</option>
      <option>paused</option>
      <option>cancel_requested</option>
      <option>canceled</option>
      <option>finalizing</option>
      <option>completed</option>
      <option>ready_to_mint</option>
      <option>failed</option>
    </select>
    <button id="refreshBtn" type="button">Refresh</button>
    <label class="ecai-indexer-checkbox"><input id="autoRefresh" type="checkbox" checked> Auto</label>
  </div>

  <div class="ecai-indexer-jobs-wrap">
    <table>
      <thead><tr><th>Job</th><th>State</th><th>Progress</th><th>Controls</th></tr></thead>
      <tbody id="jobsBody"></tbody>
    </table>
  </div>
</section>
