<header class="ecai-indexer-header">
  <div>
    <h1>ECAI Indexer</h1>
    <p class="ecai-indexer-muted">durable queue · live progress · NFT-ready artifacts · {{node_version}}</p>
  </div>

  <div class="ecai-indexer-grow"></div>

  <label class="ecai-indexer-header-field">
    <span>API base</span>
    <input id="apiBase" placeholder="same origin">
  </label>

  <label class="ecai-indexer-header-field">
    <span>Bearer token</span>
    <input id="token" type="password" autocomplete="off" placeholder="uses current session when blank">
  </label>

  <button id="connectBtn" type="button">Connect</button>
</header>
