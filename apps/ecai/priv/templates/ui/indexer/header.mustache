<header class="ecai-indexer-header">
  <div>
    <p class="ecai-indexer-kicker">ECAI</p>
    <h1>Wikimedia Indexer</h1>
    <p class="ecai-indexer-muted">Choose a source and queue it. The node resolves the release, pageview window, storage and indexing policy.</p>
  </div>

  <div class="ecai-indexer-header-actions" aria-live="polite">
    <span id="queueSummary" class="ecai-indexer-muted">queue unavailable</span>
    <span id="authIdentity" class="ecai-indexer-muted"></span>
    <a class="ecai-indexer-view-link" href="{{advanced_indexer_path}}">Advanced</a>
    <button id="loginBtn" type="button">Sign in</button>
    <button id="logoutBtn" type="button" hidden>Sign out</button>
  </div>
</header>
