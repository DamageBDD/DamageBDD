def create_material(name, base_color=(1, 1, 1, 1), metalic=0.0, roughness=0.5):
    mat = bpy.data.materials.new(name)

    if len(base_color) == 3:
        base_color = list(base_color)
        base_color.append(1)

    mat.use_nodes = True
    node = mat.node_tree.nodes[0]
    node.inputs['Base Color'].default_value = base_color
    node.inputs['Metallic'].default_value = metalic
    node.inputs['Roughness'].default_value = roughness
    #node.inputs[0].default_value = base_color
    #node.inputs[4].default_value = metalic
    #node.inputs[7].default_value = roughness

    return mat 
# Helper to create emission material
def make_emission(name, color, strength=5.0):
    mat = create_material(name, color)
    mat.use_nodes = True
    nodes = mat.node_tree.nodes
    links = mat.node_tree.links
    # clear default nodes
    for n in list(nodes):
        nodes.remove(n)
    out = nodes.new(type="ShaderNodeOutputMaterial")
    emis = nodes.new(type="ShaderNodeEmission")
    emis.inputs["Color"].default_value = (color[0], color[1], color[2], 1.0)
    emis.inputs["Strength"].default_value = 1 # strength

    links.new(emis.outputs["Emission"], out.inputs["Surface"])
    return mat

