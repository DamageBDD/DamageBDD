def get_palette(theme):
    # Returns: (bg_rgba, sphere_rgb, sphere_strength,
    #           hoop_rgb, hoop_strength,
    #           text_rgb, text_strength)

    if theme == "ecai_navy":
        # Deep navy, warm cream/orange lines
        return (
            (0.03, 0.05, 0.11, 1.0),           # bg
            (1.00, 0.62, 0.20), 6.0,          # sphere
            (1.00, 0.78, 0.35), 3.5,          # hoops
            (1.00, 0.88, 0.55), 4.0           # text
        )

    if theme == "bitcoin_war":
        # Bitcoin-orange heavy, very dark blue bg
        return (
            (0.01, 0.02, 0.05, 1.0),           # bg
            (1.00, 0.47, 0.00), 7.0,          # sphere (hard orange)
            (1.00, 0.84, 0.10), 4.0,          # hoops (yellow-orange)
            (1.00, 0.95, 0.75), 4.5           # text (pale cream)
        )

    if theme == "ecai_teal":
        # Cyber teal / magenta combo
        return (
            (0.01, 0.03, 0.06, 1.0),           # bg
            (0.20, 1.00, 0.85), 5.0,          # sphere (teal)
            (1.00, 0.30, 0.70), 3.5,          # hoops (magenta)
            (1.00, 0.95, 0.90), 4.0           # text (soft white)
        )

    # Fallback: original-ish
    return (
        (0.02, 0.03, 0.06, 1.0),
        (1.00, 0.55, 0.10), 0.8,
        (1.00, 0.70, 0.20), 0.4,
        (1.00, 0.80, 0.30), 0.6
    )

