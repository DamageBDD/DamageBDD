# Helper to find the Strength socket on an Emission node
def get_emission_strength_socket(mat):
    nodes = mat.node_tree.nodes

    emis_node = None
    for n in nodes:
        if getattr(n, "bl_idname", "") == "ShaderNodeEmission":
            emis_node = n
            break

    if emis_node is None:
        return None

    # Try by name (case-insensitive)
    for sock in emis_node.inputs:
        if sock.name.lower() == "strength":
            return sock

    # Fallback: second input is usually the strength/scale
    if len(emis_node.inputs) > 1:
        return emis_node.inputs[1]

    return None

