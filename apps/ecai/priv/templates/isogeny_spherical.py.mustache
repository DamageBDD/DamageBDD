# ---------------- GPU / Cycles device setup ----------------
scene.render.engine = 'CYCLES'

def configure_cycles_device():
    try:
        prefs = bpy.context.preferences
        cycles_prefs = prefs.addons['cycles'].preferences

        # Try OptiX first (best for RTX 3090), fallback to CUDA
        backend_order = ['OPTIX', 'CUDA']

        chosen_backend = None

        for backend in backend_order:
            try:
                cycles_prefs.compute_device_type = backend
                devices = cycles_prefs.get_devices_for_type(backend)
            except AttributeError:
                # Older API: get_devices() returns all, filter by type
                devices_all = cycles_prefs.get_devices()
                devices = [d for d in devices_all if getattr(d, "type", "") == backend]

            if not devices:
                continue

            # Enable only NVIDIA devices, disable others
            any_gpu = False
            for dev in devices:
                is_nvidia = "NVIDIA" in getattr(dev, "name", "") or "RTX" in getattr(dev, "name", "")
                dev.use = is_nvidia
                any_gpu = any_gpu or is_nvidia

            if any_gpu:
                chosen_backend = backend
                break

        if chosen_backend:
            print(f"ECAI/Blender: using Cycles GPU backend: {chosen_backend}")
            scene.cycles.device = 'GPU'
        else:
            print("ECAI/Blender: no usable GPU device, falling back to CPU")
            scene.cycles.device = 'CPU'

        # Set a sane sample count – tweak as you like
        scene.cycles.samples = 64

    except Exception as e:
        print("ECAI/Blender: failed to configure GPU, falling back to CPU:", e)
        if hasattr(scene, "cycles"):
            scene.cycles.device = 'CPU'
            scene.cycles.samples = 32

configure_cycles_device()
