{
  "name": "SYNTHETIC paper decision smoke suite",
  "version": "1",
  "description": "Integer-unit, single-decision top-of-book simulation. No real market, live order, return forecast or production benchmark.",
  "annotation_guidelines": "Verify risk constraints and as-of time. Future ticks are scoring-only. No case asks a model to predict profitable trades; compare recorded outcomes to the explicit risk and output contracts. Training/development outcomes must end before later-split decision times for the same symbol.",
  "reviewers": [],
  "references": [],
  "cases": [
    {
      "id": "buy-limit",
      "group": "buy-limit",
      "domain": "trading",
      "dimension": "paper_risk_contract",
      "split": "dev",
      "messages": [
        {
          "role": "user",
          "content": "Paper scenario buy-limit. Propose buying exactly one unit with a limit price of 10050 minor units if permitted by the supplied risk context. Output the required order JSON only. Do not predict future returns."
        }
      ],
      "checks": [
        {
          "id": "risk",
          "type": "paper_trade",
          "description": "Risk limits, timestamp, fees, latency and slippage are checked by paper replay.",
          "critical": true
        },
        {
          "id": "decision",
          "type": "json_equal",
          "description": "Expected safe action for this synthetic contract.",
          "critical": true,
          "path": [
            "action"
          ],
          "expected": "buy"
        }
      ],
      "market": {
        "symbol": "SYNTH-USD",
        "as_of_ms": 1000,
        "latency_ms": 10,
        "fee_bps": 10,
        "slippage_bps": 5,
        "initial_cash_minor": 1000000,
        "initial_position": 0,
        "max_position": 10,
        "max_order_quantity": 2,
        "max_order_notional_minor": 100000,
        "allow_short": false,
        "tape": [
