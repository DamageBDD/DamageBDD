%%% -*- mode: erlang; erlang-indent-level: 2; -*-

{
    application,
    erm,
    [
        {description, "An OTP application that provides a graphical shell."},
        {vsn, "0.1.0"},
        {registered, [erm_sup, gtknode4_sup, gtknode4, gtknode4_port, gtkgs, erm_maps]},
        {mod, {erm_app, []}},
        {
            applications,
            [kernel, stdlib, jsx, cowboy, trails, cowboy_swagger, gproc, erlexec, damage]
        },
        {
            env,
            [
                %% Keep the native session opt-in until the C-node implements
                %% the complete protocol in doc/gtknode4_protocol.md. Enable it
                %% in sys.config with the local/fake/visual examples supplied
                %% by this integration bundle.
                {display_manager, [
                    {mode, disabled},
                    {default_session, "herbstluftwm"},
                    {display_number, 0},
                    {exit_on_accept, true},
                    {auth_helper, "apps/erm/priv/erm_greetd_auth"},
                    {sessions, [
                        [
                            {id, "herbstluftwm"},
                            {label, "herbstluftwm"},
                            {command, "/usr/bin/herbstluftwm"},
                            {args, []},
                            {desktop, "herbstluftwm"}
                        ]
                    ]}
                ]},
                {gtknode4, [
                    {enabled, false},
                    {mode, local_cnode},
                    {port, [
                        {cnode_regname, gtknode4},
                        {controller_regname, gtknode4},
                        {handshake_timeout, 10000},
                        {test_mode, false}
                    ]},
                    {gs, [
                        {test_mode, false},
                        {backend_timeout, 5000},
                        {dialog_timeout, infinity},
                        {event_log_limit, 1000}
                    ]}
                ]},
                {maps, [
                    {source_id, "osm-mapnik"},
                    {latitude, 0.0},
                    {longitude, 0.0},
                    {zoom_level, 2.0},
                    {show_zoom_buttons, true},
                    {width, 1024},
                    {height, 720},
                    {ready_timeout, 15000}
                ]}
            ]
        },
        {modules, []},
        {licenses, ["Apache 2.0"]},
        {
            start_phases,
            [
                {start_trails_http, []}
            ]
        },
        {links, []}
    ]
}.
