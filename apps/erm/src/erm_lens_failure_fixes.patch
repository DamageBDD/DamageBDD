+reclaim_registered_supervisor(Name, Pid) ->
+    case catch gen_server:stop(Pid, shutdown, 10000) of
+        ok -> ok;
+        {'EXIT', Reason} ->
+            ?LOG_WARNING("Could not stop stale ~p cleanly pid=~p reason=~p", [Name, Pid, Reason]),
