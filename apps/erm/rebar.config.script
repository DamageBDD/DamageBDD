%% Build the Linux native voice worker with ordinary `rebar3 compile`.
%% CONFIG retains any other per-app settings added to rebar.config.
Enabled = case os:getenv("ERM_NATIVE_VOICE") of
    false -> true;
    "1" -> true;
    "0" -> false;
    Other -> error({invalid_environment, "ERM_NATIVE_VOICE", Other})
end,
case os:type() =:= {unix, linux} andalso Enabled of
    false -> CONFIG;
    true ->
        Additions = [
            {pre_hooks, [{compile, "sh scripts/build_native_voice.sh"}]},
            {post_hooks, [{clean, "sh scripts/build_native_voice.sh clean"}]},
            {artifacts, ["priv/erm_native_voice"]}
        ],
        lists:foldl(fun({Key, Values}, Acc) ->
            Existing = proplists:get_value(Key, Acc, []),
            lists:keystore(Key, 1, Acc, {Key, Existing ++ Values})
        end, CONFIG, Additions)
end.
