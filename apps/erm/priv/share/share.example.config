%% Merge into sys.config. Paths are absolute and belong to the desktop user.
%% Run erm in that user's session, with DBUS_SESSION_BUS_ADDRESS inherited.
[
 {erm, [{share, #{
   enabled => true,
   directory => "/home/steven/.local/share/erm/share",
   corpus => <<"engineering-private">>,
   principal => <<"REPLACE_WITH_CORPUS_OWNER">>,
   max_file_bytes => 16777216,
   max_total_bytes => 536870912,
   max_items => 1000,
   poll_ms => 1000,
   kdeconnect => #{
     enabled => true,
     device_ids => [<<"REPLACE_WITH_PAIRED_DEVICE_ID">>],
     roots => ["/home/steven/.local/share/erm/kdeconnect"]
   },
   airdrop => #{
     enabled => true,
     directory => "/home/steven/.local/share/erm/airdrop"
   }
 }}]}
].
%% Configure ecai.private_corpora and provision keys separately using
%% apps/ecai/priv/config/private_index.example.config. No private keys here.
