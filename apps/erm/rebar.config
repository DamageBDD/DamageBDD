%%% -*- mode: erlang; erlang-indent-level: 2; -*-

%% ERM-local native build configuration.
%%
%% This file is deliberately app-local: port_specs and artifacts are
%% resolved relative to apps/erm, so the resulting NIF is placed in
%% _build/<profile>/lib/erm/priv/erm_dpms_nif.so and is carried into
%% releases/packages with the ERM application.

{artifacts, [
    "priv/erm_dpms_nif.so"
]}.

{port_specs, [
    {".*-linux.*",
        "priv/erm_dpms_nif.so",
        ["c_src/erm_dpms_nif.c"],
        [
            {env, [
                {"LANG", "C"},
                {"CFLAGS",
                    "$CFLAGS $ERL_CFLAGS "
                    "-fPIC -O2 -g3 "
                    "-Wall -Wextra -Wpedantic "
                    "-Werror=implicit-function-declaration "
                    "$(pkg-config --cflags xcb xcb-screensaver xcb-dpms)"},
                {"LDFLAGS",
                    "$LDFLAGS $ERL_LDFLAGS "
                    "$(pkg-config --libs xcb xcb-screensaver xcb-dpms)"}
            ]}
        ]}
]}.
