contract BoPLightningProofRegistry =

  record payment =
    { hash : string       // payment_hash (SHA256 of preimage, off-chain verified)
    , sats : int
    , aud_milli : int
    , timestamp : int }

  record state =
    { recipient_ln : string                // LN address for human reference
    , payments : map(string, payment)
    , total_msats : int
    , goal_aud : int
    , deadline : int
    , finalized : bool }

  datatype event =
    PaymentRegistered(string, int, int)

  entrypoint init(_recipient_ln : string, _goal_aud : int, _duration_secs : int) : state =
    require(_goal_aud > 0, "Goal must be positive")
    require(_duration_secs > 0, "Duration must be positive")
    { recipient_ln = _recipient_ln,
      payments = {},
      total_msats = 0,
      goal_aud = _goal_aud,
      deadline = Chain.timestamp + _duration_secs,
      finalized = false } 

  // Off-chain backend submits Lightning payment_hash as proof
  stateful entrypoint register_payment(payment_hash : string, sats : int, aud_milli : int) =
    require(Chain.timestamp < state.deadline, "Fundraising ended")
    require(! Map.member(payment_hash, state.payments), "Already registered")
    require(sats > 0, "Invalid sats")

    let new_payment = {
      hash = payment_hash,
      sats = sats,
      aud_milli = aud_milli,
      timestamp = Chain.timestamp}
    Chain.event(PaymentRegistered(payment_hash, sats, aud_milli))
    put(state{
      payments[payment_hash] = new_payment,
      total_msats = state.total_msats + sats})

  stateful entrypoint finalize() =
    require(! state.finalized, "Already finalized")
    require(state.total_msats >= state.goal_aud, "Goal not reached")

    put(state{ finalized = true })

  // Read-only API
  entrypoint is_registered(payment_hash : string) : bool =
    Map.member(payment_hash, state.payments)

  entrypoint get_total_msats() : int = state.total_msats
  entrypoint get_goal_aud() : int = state.goal_aud
  entrypoint is_finalized() : bool = state.finalized
  entrypoint get_recipient_ln() : string = state.recipient_ln
  entrypoint get_deadline() : int = state.deadline
