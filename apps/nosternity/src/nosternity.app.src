{
    application,
    nosternity,
    [
        {description, "Nosternity - Nostr client for eternal notes and stuff."},
        {vsn, "0.1.0"},
        {registered, []},
        {mod, {nosternity_app, []}},
        {
            applications,
            [kernel, stdlib, jsx, cowboy, trails, cowboy_swagger, gproc, gun, damage]
        },
        {env, []},
        {modules, [nosternity_app, nosternity_sup]},
        {licenses, ["Apache 2.0"]},
        {
            start_phases,
            [
                {start_trails_http, []}
            ]
        },
        {links, []}
    ]
}.
