%% Merge this application entry into the full repository sys.config.
%% HTTP and WebSocket share the interface and port below.
[
    {nosternity, [
        %% Service controls. HTTP API and WebSocket share this listener.
        {enabled, true},
        {http_enabled, true},
        {websocket_enabled, true},
        %% Loopback by default; use {0,0,0,0} for all IPv4 interfaces,
        %% or a specific local interface address. WebSocket path: /nostr.
        {ip, {127, 0, 0, 1}},
        {port, 9001},
        {http_num_acceptors, 10},
        {http_max_connections, 1024},
        {http_idle_timeout_ms, 60000},
        {http_request_timeout_ms, 10000},
        {websocket_idle_timeout_ms, 120000},

        %% A search relay needs no signing identities. Enable only when
        %% nosternity_nostr_nsec and inglorious_nostr_nsec are configured.
        {nostr_clients_enabled, false},

        %% Durable event store and ECAI query limits. Preserve this DETS
        %% file across restarts: it also retains deletion tombstones.
        {search_store_file, "data/nosternity/search.dets"},
        {search_max_events, 10000},
        {search_default_limit, 50},
        {search_max_limit, 200},
        {max_subscriptions, 32},
        {max_total_subscriptions, 4096},
        {max_filters, 8},
        {max_filter_values, 256},
        {websocket_messages_per_minute, 120},
        {subscriber_queue_max, 256},

        %% /context works without inference. /ask additionally requires
        %% NOSTERNITY_LLM_API_TOKEN in the BEAM process environment.
        %% Select a model actually installed on the configured provider.
        {search_llm_enabled, false},
        {search_llm_opts, [
            {provider, ollama},
            {host, "127.0.0.1"},
            {port, 11434},
            {transport, tcp},
            {model, <<"qwen3-coder:30b">>},
            {temperature, 0},
            {max_output_tokens, 2048}
        ]},
        {pools, []},
        {relays, ["wss://nos.lol"]},
        %% SENSITIVE legacy key; prefer encrypted secret handling where possible.
        %% {nostr_private_key_hex, "DO_NOT_COMMIT_PRIVATE_KEYS"},
        {ae_event_store_enabled, false},
        {ae_event_store_contract, undefined},
        {ae_event_store_auto_deploy, false},
        {ae_event_store_contract_file, "contracts/NostrEventStore.aes"},
        {ae_event_store_kinds, [1, 7, 30023]},
        {ae_event_store_pubkeys, all},
        {ae_event_store_max_event_bytes, 65536},
        {ae_event_store_queue_max, 5000},
        {ae_event_store_batch_size, 10},
        {ae_event_store_flush_ms, 2000},
        {ae_event_store_retry_ms, 5000},
        {ae_event_store_rehydrate, true},
        {ae_event_store_hydrate_page_size, 25},
        {ae_event_store_confirm_writes, true}

        %% ------------------------------------------------------------------
        %% COMPLETE TOP-LEVEL OPTION REFERENCE
        %% Every current canonical application-env key consumed by this app
        %% is listed below. Entries are commented because the code default is
        %% normally preferable. Uncomment only when overriding it.
        %% ------------------------------------------------------------------
        %% enabled: configured above. Code default: true
        %% http_enabled: configured above. Code default: true
        %% websocket_enabled: configured above. Code default: true
        %% nostr_clients_enabled: configured above. Code default: true (legacy compatibility)
        %% http_num_acceptors: configured above. Code default: 10
        %% http_max_connections: configured above. Code default: 1024
        %% http_idle_timeout_ms: configured above. Code default: 60000
        %% http_request_timeout_ms: configured above. Code default: 10000
        %% websocket_idle_timeout_ms: configured above. Code default: 120000
        %% search_store_file: configured above. Code default: "data/nosternity/search.dets"
        %% search_max_events: configured above. Code default: 10000
        %% search_default_limit: configured above. Code default: 50
        %% search_max_limit: configured above. Code default: 200
        %% max_subscriptions: configured above. Code default: 32
        %% max_total_subscriptions: configured above. Code default: 4096
        %% max_filters: configured above. Code default: 8
        %% max_filter_values: configured above. Code default: 256
        %% websocket_messages_per_minute: configured above. Code default: 120
        %% subscriber_queue_max: configured above. Code default: 256
        %% search_llm_enabled: configured above. Code default: false
        %% search_llm_opts: configured above. Code default: #{}; proplist or map accepted
        %% ae_event_store_auto_deploy: configured above. Code default: false
        %% ae_event_store_batch_size: configured above. Code default: 10
        %% ae_event_store_confirm_writes: configured above. Code default: true
        %% ae_event_store_contract: configured above. Code default: undefined
        %% ae_event_store_contract_file: configured above. Code default: "contracts/NostrEventStore.aes"
        %% ae_event_store_enabled: configured above. Code default: false
        %% ae_event_store_flush_ms: configured above. Code default: 2000
        %% ae_event_store_hydrate_page_size: configured above. Code default: 25
        %% ae_event_store_kinds: configured above. Code default: [1, 7, 30023]
        %% ae_event_store_max_event_bytes: configured above. Code default: 65536
        %% ae_event_store_pubkeys: configured above. Code default: all
        %% ae_event_store_queue_max: configured above. Code default: 5000
        %% ae_event_store_rehydrate: configured above. Code default: true
        %% ae_event_store_retry_ms: configured above. Code default: 5000
        %% ip: configured above. Code default: {127, 0, 0, 1}
        %% {nostr_private_key_hex, undefined}, %% SENSITIVE; default: required/no explicit call-site default
        %% pools: configured above. Code default: []
        %% port: configured above. Code default: 9001
        %% relays: configured above. Code default: required/no explicit call-site default
    ]}
].
