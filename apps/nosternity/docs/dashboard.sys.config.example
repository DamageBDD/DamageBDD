%% Merge these entries into your existing release sys.config.
%% Use your real public HTTPS origin and a persistent path writable by the VM.
[
 {nosternity, [
        %% Public node branding, managed by the operator. Restart after edits.
        {node_name, <<"Nosternity Search">>},
        {node_title, <<"Nosternity Search">>},
        {node_description, <<"DamageBDD verified events with ECAI text search. Public text kinds 0, 1, 30023. Single-node bounded storage.">>},
        %% Optional image URLs: HTTP(S) or /branding/<filename>.
        %% Put local images in apps/nosternity/priv/branding before release build.
        %% Use a public absolute logo URL to include the NIP-11 icon.
        {node_logo_url, <<>>},
        {node_favicon_url, <<>>},
        {node_accent_color, <<"#6750a4">>},


   {enabled, true},
   {http_enabled, true},
   {ip, {127,0,0,1}},
   {port, 9001},
   {dashboard_enabled, true},
   {browser_auth_origin, "https://nosternity.example.com"},
   {auth_store_file, "/var/lib/nosternity/accounts.dets"},
   {auth_signup_enabled, true},
   {auth_challenge_ttl_seconds, 180},
   {auth_session_ttl_seconds, 3600},
   {auth_max_challenges, 1000},
   {auth_max_sessions, 10000},
   {auth_max_accounts, 100000},
   {auth_attempts_per_minute, 120},
   {search_default_limit, 50},
   {search_max_limit, 200}
 ]},
 {damage, [
   {cookie_secure, true}
   %% Retain your existing browser_auth, email, identity, chain, NWC and
   %% nsecbunker configuration. This fragment does not provision those services.
 ]}
].
