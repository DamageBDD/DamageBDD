<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="referrer" content="no-referrer">
  <title>DamageBDD · {{action_label}} password</title>
  <link rel="icon" href="/static/img/favicon.ico">
  <link rel="stylesheet" href="/static/css/auth.css?theme=semantic-v2">
  <script type="module" src="/static/js/password-completion.js"></script>
</head>
<body class="password-completion-page">
  <div id="login-modal" class="auth-password-page">
    <section class="auth-modal" aria-labelledby="password-page-title">
      <main id="login_modal_content">
        <div class="auth-brand"><img src="/static/img/logo.png" alt="" width="36" height="36"><span>DamageBDD<span class="auth-brand-label">VERIFY WHAT MATTERS</span></span></div>
        <header class="auth-heading"><h1 id="password-page-title">{{action_label}} your password</h1><p>Complete your managed-account setup.<br>This does not connect or recover an external wallet.</p></header>
        <form id="resetPasswdForm" action="/accounts/{{action}}" method="post">
          <input type="hidden" name="token" value="{{token}}" required>
          <label for="new-password">New password</label>
          <div class="auth-password-field"><input id="new-password" type="password" name="new_password" autocomplete="new-password" minlength="8" maxlength="1024" aria-describedby="password-rules" required><button type="button" data-password-toggle="new-password" aria-label="Show new password" aria-pressed="false">Show</button></div>
          <label for="confirm-password">Confirm password</label>
          <div class="auth-password-field"><input id="confirm-password" type="password" name="new_password_confirm" autocomplete="new-password" minlength="8" maxlength="1024" required><button type="button" data-password-toggle="confirm-password" aria-label="Show confirmation password" aria-pressed="false">Show</button></div>
          <p id="password-rules">Use at least 8 characters, including upper- and lower-case letters, a number, and a special character.</p>
          <button class="auth-primary" id="resetPasswdBtn" type="submit">{{action_label}} password</button>
        </form>
        <p id="password-result" class="auth-status" role="status" aria-live="polite"></p>
        <a href="/" id="password-sign-in" class="auth-back" hidden>Continue to sign in →</a>
        <footer class="auth-footer"><p>Never use your seed phrase or private key as a password.</p><a href="/">Back to DamageBDD</a></footer>
      </main>
    </section>
  </div>
</body>
</html>
