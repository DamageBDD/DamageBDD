<!-- -*- mode: html -*- -->
<div class="modal micromodal-slide" id="logout-modal" aria-hidden="true">
  <div class="modal__overlay" tabindex="-1" data-micromodal-close>
    <div class="modal__container modal__container--sm" role="dialog" aria-modal="true" aria-labelledby="logout-modal-title">
      <header class="modal__header">
        <div>
          <p class="modal__eyebrow">Account</p>
          <h2 class="modal__title" id="logout-modal-title">Sign out of this browser?</h2>
        </div>
        <button class="modal__close" type="button" aria-label="Close dialog" data-micromodal-close></button>
      </header>
      <main class="modal__content">
        <p>This signs you out of DamageBDD on this browser and clears the local authenticated session.</p>
        <p class="modal__hint">Your wallet accounts, balances and funds are not deleted. Remote wallet permissions must be revoked in the wallet or signer that granted them.</p>
      </main>
      <footer class="modal__footer">
        <button class="modal__btn" type="button" data-micromodal-close>Cancel</button>
        <button id="logoutSubmitBtn" class="modal__btn modal__btn-danger" type="button">Sign out</button>
      </footer>
    </div>
  </div>
</div>
