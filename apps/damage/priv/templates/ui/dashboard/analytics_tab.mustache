<!-- -*- mode: html -*- -->
<section class="workspace-page analytics-workspace" aria-labelledby="analytics-heading">
  <div class="workspace-heading">
    <div>
      <p class="workspace-eyebrow">ON-CHAIN OBSERVABILITY</p>
      <h1 id="analytics-heading">DamageBDD analytics</h1>
      <p>Recent verification activity derived from Æternity middleware contract logs.</p>
    </div>
    <span id="lastUpdated" class="workspace-muted analytics-updated"></span>
  </div>

  <div id="kpis" class="analytics-kpis" aria-label="Analytics summary">
    <div class="workspace-card analytics-kpi"></div>
    <div class="workspace-card analytics-kpi"></div>
    <div class="workspace-card analytics-kpi"></div>
    <div class="workspace-card analytics-kpi"></div>
  </div>

  <div class="analytics-layout">
    <section class="workspace-card analytics-card" aria-labelledby="runs-chart-heading">
      <div class="workspace-section-heading">
        <div>
          <h2 id="runs-chart-heading">Runs / day</h2>
          <p>Last 30 days from the configured runs contract.</p>
        </div>
      </div>
      <canvas id="runsChart" width="800" height="220" aria-label="Runs, passes and failures over the last 30 days"></canvas>
      <div id="legend" class="analytics-legend"></div>
    </section>

    <section class="workspace-card analytics-card" aria-labelledby="analytics-recent-heading">
      <div class="workspace-section-heading">
        <div><h2 id="analytics-recent-heading">Recent</h2><p>Latest contract log records.</p></div>
      </div>
      <div id="recent" class="analytics-recent"></div>
    </section>
  </div>
</section>
