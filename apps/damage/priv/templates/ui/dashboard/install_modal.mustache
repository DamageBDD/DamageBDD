<div class="modal micromodal-slide" id="install-modal" aria-hidden="true">
      <div class="modal__overlay" tabindex="-1" data-micromodal-close>
        <div class="modal__container" role="dialog" aria-modal="true" aria-labelledby="install-modal-title">
          <header class="modal__header">
            <h2 class="modal__title" id="install-modal-title">Install a DamageBDD Node</h2>
            <button class="modal__close" aria-label="Close modal" data-micromodal-close></button>
          </header>
          <main class="modal__content">
            <form id="installRequestForm" class="wizard" method="POST">
              <aside class="wizard-content container">
                <div class="wizard-step" data-wz-title="Target">
                  <fieldset><legend>Target</legend>
                    <label>Domain (TLS host)</label><input id="inst-domain" name="domain" required placeholder="run.example.com">
                    <label>Admin Email (Let’s Encrypt)</label><input id="inst-email" name="email" type="email" required placeholder="admin@example.com">
                  </fieldset></div>
                <div class="wizard-step" data-wz-title="Platform">
                  <fieldset><legend>Platform</legend>
                    <div class="pure-g">
                      <div class="pure-u-1 pure-u-md-1-2">
                        <label>OS</label>
                        <select id="inst-os" class="on-active-required">
                          <option value="linux">Linux</option>
                          <option value="macos">macOS</option>
                          <option value="windows">Windows</option>
                          <option value="android">Android (Termux)</option>
                        </select>
                      </div>
                      <div class="pure-u-1 pure-u-md-1-2">
                        <label>Distro / Shell</label>
                        <select id="inst-variant" class="on-active-required"></select>
                      </div>
                    </div>
                  </fieldset></div>
                <div class="wizard-step" data-wz-title="Advanced">
                  <fieldset><legend>Advanced</legend>
                    <div class="pure-g">
                      <div class="pure-u-1 pure-u-md-1-3"><label>Port</label><input id="inst-port" name="port" value="8080"></div>
                      <div class="pure-u-1 pure-u-md-1-3"><label>Repo</label><input id="inst-repo" name="repo" value="https://github.com/DamageBDD/DamageBDD.git"></div>
                      <div class="pure-u-1 pure-u-md-1-3"><label>Branch</label><input id="inst-branch" name="branch" value="develop"></div>
                    </div>
                  </fieldset></div>
                <div class="wizard-step" data-wz-title="Generate">
                  <fieldset><legend>Signed Link</legend>
                    <div class="pure-g">
                      <div class="pure-u-1 pure-u-md-1-2"><button id="generateSignedInstallBtn" class="styled-btn" type="button">Generate Signed Link</button></div>
                      <div class="pure-u-1 pure-u-md-1-2"><span id="installStatus" class="note"></span></div>
                      <div><h3>One-liner</h3>
                        <div id="preview-linux-macos" style="display:none;"><pre><code id="cmd-bash"></code></pre><button class="styled-btn" type="button" data-copy="#cmd-bash">Copy</button></div>
                        <div id="preview-windows" style="display:none;"><pre><code id="cmd-ps1"></code></pre><button class="styled-btn" type="button" data-copy="#cmd-ps1">Copy</button></div>
                        <div id="preview-android" style="display:none;"><pre><code id="cmd-termux"></code></pre><button class="styled-btn" type="button" data-copy="#cmd-termux">Copy</button></div>
                      </div>
                    </div>
                  </fieldset></div>
              </aside></form>
          </main>
          <footer class="modal__footer">
            <button class="modal__btn modal__btn-primary" data-micromodal-close aria-label="Close">Close</button>
          </footer>
        </div>
      </div>
    </div>
