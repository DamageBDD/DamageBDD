<p data-wallet-only-note hidden></p>
<!-- -*- mode: html -*- -->
<section class="workspace-page settings-workspace" aria-labelledby="settings-title">
<div class="workspace-heading">
  <div><p class="workspace-eyebrow">MANAGE</p><h1 id="settings-title">Settings</h1><p>Account automation, webhooks and node-level execution context.</p></div>
</div>

<form data-requires-capability="account_context" action="submit_settings" method="post" class="workspace-card workspace-form settings-card">
  <fieldset class="workspace-fieldset">
    <legend>DNS auth token</legend>
    <button data-requires-capability="account_context" class="workspace-button" type="button" onclick="generateToken()">Generate Token</button>
    <div id="generatedToken"></div>
  </fieldset>
</form>

{{#node_admin}}
<section id="node-context-settings" class="workspace-card settings-card" aria-labelledby="node-context-title">
  <div class="workspace-card-body">
  <div class="workspace-section-heading"><div><h2 id="node-context-title">Node context</h2>
  <p>Node-level values are inherited by account runs according to their inheritance policy. Sensitive values stay encrypted and are returned redacted.</p></div></div>

  <div class="node-context-meta workspace-toolbar">
    <strong>Version:</strong> <span id="node-context-version">—</span>
    &nbsp;
    <strong>Root:</strong> <code id="node-context-root">—</code>
    <button data-requires-capability="account_context" class="workspace-button" type="button" id="node-context-refresh">Refresh</button>
  </div>

  <div id="node-context-status" class="workspace-status" role="status" aria-live="polite"></div>

  <div class="workspace-table-wrap node-context-table-wrap">
    <table class="workspace-table" id="node-context-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Value</th>
          <th>Sensitive</th>
          <th>Exposure</th>
          <th>Inheritance</th>
          <th>Locked</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody id="node-context-rows">
        <tr><td colspan="7">Loading node context…</td></tr>
      </tbody>
    </table>
  </div>

  <form data-requires-capability="account_context" id="node-context-editor" class="workspace-form node-context-editor">
    <fieldset class="workspace-fieldset">
      <legend>Add or update node context</legend>

      <label for="node-context-name">Name</label>
      <input
        type="text"
        id="node-context-name"
        maxlength="256"
        autocomplete="off"
        required
        placeholder="default_server">

      <label for="node-context-value">Value</label>
      <textarea
        id="node-context-value"
        rows="3"
        required
        placeholder="https://api.example.com"></textarea>

      <label for="node-context-type">Value type</label>
      <select id="node-context-type">
        <option value="string">String</option>
        <option value="integer">Integer</option>
        <option value="float">Float</option>
        <option value="boolean">Boolean</option>
        <option value="json">JSON</option>
      </select>

      <label class="workspace-check">
        <input type="checkbox" id="node-context-sensitive">
        Sensitive
      </label>

      <label for="node-context-exposure">Exposure</label>
      <select id="node-context-exposure">
        <option value="template">Template</option>
        <option value="step_only">Step only</option>
      </select>

      <label for="node-context-inheritance">Inheritance</label>
      <select id="node-context-inheritance">
        <option value="default">Default</option>
        <option value="locked">Locked</option>
        <option value="none">None</option>
      </select>

      <p class="node-context-help">
        Sensitive node values are normalized by the server to
        <code>step_only</code>, <code>none</code>, and locked.
      </p>

      <div class="workspace-form-actions">
        <button data-requires-capability="account_context" class="workspace-button workspace-primary" type="submit">Save</button>
        <button data-requires-capability="account_context" class="workspace-button" type="button" id="node-context-cancel">Clear</button>
      </div>
    </fieldset>
  </form>
  </div>
</section>




{{/node_admin}}

<form data-requires-capability="account_context" action="submit_webhook" method="post" class="workspace-card workspace-form settings-card">
  <fieldset id="webhook-settings-form" class="workspace-fieldset">
    <legend>Webhooks</legend>

    <label for="webhook-name">Name</label>
    <input type="text" id="webhook-name" name="variableName" placeholder="Webhook name">

    <label for="webhook-url">Webhook URL</label>
    <input type="url" id="webhook-url" name="value" placeholder="https://example.com/webhook">

    <label for="webhook-method">Method</label>
    <select id="webhook-method" name="method">
      <option value="POST">POST</option>
      <option value="GET">GET</option>
    </select>

    <button data-requires-capability="account_context" class="workspace-button" type="button" onclick="addWebhook()">Add Webhook</button>
    <div id="webhookVariables"></div>
  </fieldset>

  <div class="workspace-form-actions">
    <input class="workspace-button workspace-primary" type="submit" value="Save webhooks">
  </div>
</form>
</section>
