<!-- -*- mode: html -*- -->
<div class="modal micromodal-slide" id="login-modal" aria-hidden="true">
  <div class="modal__overlay" tabindex="-1">
    <div class="modal__container auth-modal" role="dialog" aria-modal="true" aria-labelledby="auth-modal-title">
      <main class="modal__content" id="login_modal_content">
        <div class="panel auth-panel-shell">

          <header class="modal__header login_modal_header">

            <img src="{{logo_image}}" alt="DamageBDD" />

            <div class="title-stack">
              <h2 class="modal__title" id="auth-modal-title">DamageBDD</h2>

            </div>

          </header>

          <!-- Auth tabs (Tabby) -->
          <nav class="auth-chooser" aria-label="Authentication method">
            <ul class="auth-tabs" data-auth-tabs>
              <li><a data-tabby-default href="#auth-email">Log In</a></li>
              <li><a href="#auth-signup">Sign Up</a></li>
              <li><a href="#auth-wallet">Wallet</a></li>
            </ul>
          </nav>

          <!-- Panels -->
	      <section class="auth-panel" data-auth-panel="login"  id="auth-email">
	        <!-- Use standard field names + autocomplete so password managers can offer save/fill -->
	        <form id="loginSignupForm" onsubmit="submitLoginForm(event)" autocomplete="on">
              <input type="email"
                     id="login-username"
	                 name="username"
	                 autocomplete="username"
                     required
                     placeholder="Email Address">
              <div class="password-wrapper">
                <input type="password"
                       name="password"
                       id="password"
                       autocomplete="current-password"
                       required
                       placeholder="Password">
                <button type="button" class="toggle-password" data-target="password" aria-label="Show or hide password">👁️</button>
              </div>

              <button id="loginSubmitBtn"
                      class="modal__btn modal__btn-primary styled-btn auth-primary"
                      aria-label="Login with email and password"
                      title="Login Submit">Login</button>

              <div class="login-links auth-links-row">
                <button id="loginResetPasswdBtn" class="buttonlink" aria-label="Forgot Password" title="Reset Password">Forgot Password</button>
              </div>
              <div class="terms">By logging in, you accept the <a href="/terms">Terms and Conditions</a>.</div>
            </form>
          </section>

          <section class="auth-panel" data-auth-panel="signup" id="auth-signup" hidden>
            <form id="signupForm" onsubmit="submitSignupForm(event)" autocomplete="on">
              <input type="email"
                     id="signup-username"
	                 name="username"
	                 autocomplete="username"
                     required
                     placeholder="Email Address">
              <button id="signupSubmitBtn"
                      class="modal__btn modal__btn-primary styled-btn auth-primary"
                      aria-label="Signup with email"
                      title="Sign Up Submit">Create Account</button>

              <div class="terms">By signing up, you accept the <a href="/terms">Terms and Conditions</a>.</div>
            </form>
          </section>

          <section class="auth-panel" data-auth-panel="wallet" id="auth-wallet" hidden>

            <!-- AE Wallet (L1) -->
            <div class="auth-wallet-block">
              <h3 class="auth-subtitle">Æternity Wallet (L1)</h3>

              <button id="connect-button"
                      class="modal__btn modal__btn-primary styled-btn auth-primary"
                      aria-label="Connect AE Wallet"
                      title="Connect Æternity Wallet">
                Connect AE Wallet
              </button>

              <p id="dont_have_wallet" class="auth-hint">
                Don’t have an AE wallet?
                <a href="https://www.superherowallet.com"
                   target="_blank"
                   rel="noreferrer">
                  Install Superhero Wallet
                </a>
              </p>
            </div>


            <hr class="auth-divider">

            <div class="auth-hint">
              Prefer email?
              <button type="button"
                      class="auth-link buttonlink"
                      data-auth-jump="login">
                Login
              </button>
            </div>

          </section>


          <div id="connect-status" class="auth-status" aria-live="polite"></div>

          <footer id="login_footer" class="modal__footer">
            <button
              id="open-node-wallet-btn-auth"
              class="node-wallet-cog"
              type="button"
              aria-label="Open node wallet"
              data-tooltip="Node Wallet">
              ⚙
              <span class="node-wallet-cog__label">Node Wallet</span>
            </button>
          </footer>

        </div>
      </main>
    </div>
  </div>
</div>

<div class="modal micromodal-slide" id="connect-wallet-modal" aria-hidden="true">
  <div class="modal__overlay" tabindex="-1" data-micromodal-close>
    <div class="modal__container" role="dialog" aria-modal="true" aria-labelledby="connect-wallet-title">
      <header class="modal__header">
        <h2 class="modal__title" id="connect-wallet-title">Connect Browser Wallet</h2>
      </header>
      <main class="modal__content">
        <p>We couldn’t find a connected browser wallet. Click “Connect now”.</p>
        <ol>
          <li>Have a <a href="https://damagebdd.com/supported_wallets" target="blank">compatible wallet</a> installed.</li>
          <li>Approve the connection request in your wallet popup.</li>
        </ol>
        <button id="connect-wallet-now" class="styled-btn">Connect now</button>
      </main>
    </div>
  </div>
</div>

<div class="modal micromodal-slide" id="email-login-modal" aria-hidden="true">
  <div class="modal__overlay" tabindex="-1" data-micromodal-close>
    <div class="modal__container" role="dialog" aria-modal="true" aria-labelledby="login-title">
      <header class="modal__header">
        <h2 class="modal__title" id="login-title">Email Login/Custodial Wallet</h2>
        <button class="modal__close" aria-label="Close modal" data-micromodal-close></button>
      </header>
      <main class="modal__content">
        <form id="login-form" class='panel' >
          <input type="email" id="email-login-username" autocomplete="username" required placeholder="Email Address"><br>
          <div class="password-wrapper">
            <input type="password" name="password" id="email-password" autocomplete="current-password" required placeholder="Password">
            <button type="button" class="toggle-password" data-target="password">👁️</button>
          </div>
        </form>
      </main>
      <footer class="modal__footer">
        <div class="login-links">
          <button id="email-login-submit-btn" class="modal__btn modal__btn-primary styled-btn" aria-label="Login with email and password" title="Login Submit">Login</button><br>
      </footer>
      </div>
    </div>
  </div>
