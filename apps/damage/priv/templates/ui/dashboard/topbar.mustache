<!-- -*- mode: html -*- -->
<div class="topbar">
  <div class="site-header">
    <img class="logo" src="/static/img/logo.png" alt="DamageBDD Logo" />
    <div class="brand-text">
      <div class="title">DamageBDD</div>
      <div class="subtitle">
        Behaviour Driven Development At Planetary Scale
      </div>
    </div>
  </div>
  <div class="toolbar-items">
    <div id="balanceDiv" class="token-cta" data-micromodal-trigger="wallet-modal">
      <div class="balance-column">
        <span id="balanceAddress" title="Wallet Address">ak_...</span>

        <div class="balance-row">
          <span id="balanceLabel">DAMAGE:</span>
          <span id="balanceAmount" class="damage-amount"></span>

          <span id="aeBalanceLabel" class="ae-sub">AE:</span>
          <span id="aeBalance" class="ae-balance"></span>

          <span id="satsBalanceLabel" class="sats-sub">SATS:</span>
          <span id="satsBalance" class="sats-balance"></span>

          <button id="balanceRefreshBtn"
                  type="button"
                  class="icon-btn"
                  title="Refresh balance"
                  aria-label="Refresh balance">
            ⟳
          </button>
        </div>
      </div>
    </div>
    <div id="toolbar-btns">
      <div id="installBtn" class="install-btn" data-micromodal-trigger="install-modal">Install Node</div>
      <div id="logoutBtn" class="logout-btn" data-micromodal-trigger="logout-modal">Logout</div>
    </div>
  </div>
</div>

