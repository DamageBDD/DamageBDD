<!-- -*- mode: html -*- -->

<html lang="en">

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/static/img/favicon.ico" />
    <title>DamageBDD - Behaviour Driven Development At Planetary Scale</title>

    <script src="/static/js/three.min.js"></script>
    <script src="/static/js/qrcode.min.js"></script>
    <script src="/static/js/micromodal.min.js"></script>
    <script src="/static/js/tabby.polyfills.min.js"></script>

    <script type="module" src="/static/js/sidekick.js"></script>

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/purecss@3.0.0/build/pure-min.css"
      integrity="sha384-X38yfunGUhNzHpBaEBsWLO+A0HDYOQi8ufWDkZ0k9e0eXz/tH3II7uKZ9msv++Ls"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/purecss@3.0.0/build/grids-responsive-min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/purecss@3.0.0/build/base-min.css"
    />

    <link rel="stylesheet" type="text/css" href="/static/css/micromodal.css" />
    <link
      rel="stylesheet"
      type="text/css"
      href="/static/css/tabby-ui.min.css"
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="/static/css/damage-lightning-ui.css"
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="/static/css/feature-picker.css"
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="/static/css/tango-steven-theme.css"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
      integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link rel="stylesheet" type="text/css" href="/static/css/prism.css" />
    <link rel="stylesheet" type="text/css" href="/static/css/main.css" />
    <link rel="stylesheet" type="text/css" href="/static/css/auth.css" />
    <link rel="stylesheet" type="text/css" href="/static/css/ecai-jobs.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/prismjs/themes/prism-tomorrow.min.css"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" type="text/css" href="/static/css/reports.css" />
    <link rel="stylesheet" href="/static/css/lightning-swap-demo.css" />
  </head>
  <body>
    <div id="background"></div>
    <div id="content">
      {{{topbar}}}
      {{{tabs_bar}}}
      <div id="lightning-swap-demo-tab" class="lightning-swap-demo-container">
        <div id="lightning-swap-demo" class="exp-swap">
          <div class="swap-card">
            <!-- Header / Step Indicator -->
            <div class="swap-header">
              <div class="swap-title">
                <span class="bolt">⚡</span>
                Lightning Swap
              </div>
              <div class="swap-steps">
                <span class="step active">Select</span>
                <span class="step">Confirm</span>
                <span class="step">Status</span>
              </div>
            </div>

            <!-- STEP: SELECT -->
            <div class="swap-step" data-step="select">
              <div class="asset-inputs">
                <div class="asset-input">
                  <label>You send</label>
                  <div class="asset-row">
                    <span class="token">BTC</span>
                    <input
                      type="number"
                      placeholder="0.00"
                      step="0.01"
                      min="0"
                    />
                  </div>
                </div>
                <div class="swap-arrow">↓</div>
                <div class="asset-input">
                  <label>You receive (est.)</label>
                  <div class="asset-row">
                    <span class="token">⚡ BTC</span>
                    <input type="text" placeholder="≈ 0.0098" disabled />
                  </div>
                </div>
                <div class="details">Details
                  <i class="details-icon fa-solid fa-chevron-right"></i></div>
                <hr />
              </div>
              <div class="select-grid swap-grid">

                <div class="label">Estimated time</div>
                <div class="value"><span class="value-text">&lt; 5 seconds</span></div>

                <div class="label">Lightning fee</div>
                <div class="value"><span class="value-text"> ~0.0002 BTC</span>
                </div>

                <div class="label">Route</div>
                <div class="value"><span class="value-text">2 hops</span></div>

                <div class="label">Status</div>
                <div class="value success"><span
                    class="value-text"
                  >Healthy</span></div>
              </div>

              <button class="primary-btn">Review swap</button>
            </div>

            <!-- STEP: CONFIRM -->
            <div class="swap-step hidden" data-step="confirm">
              <div class="summary-card">
                <div class="confirm-grid swap-grid">
                  <div class="label">From</div>
                  <div class="value"><span class="value-text">0.01 BTC</span></div>
                  <div class="label">To</div>
                  <div class="value"><span class="value-text">≈ 0.0098 ⚡ BTC</span></div>
                  <div class="label">Lightning fee</div>
                  <div class="value"><span class="value-text">0.0002 BTC</span></div>
                </div>
                <hr />
              </div>
              <div class="confirm-btns">
                <button class="primary-btn">Confirm swap</button>
                <button class="secondary-btn">Back</button></div>

            </div>

            <!-- STEP: STATUS -->
            <div class="swap-step hidden" data-step="status">
              <div class="status-card pending">
                <div class="status-icon">⏳</div>
                <h3>Processing swap</h3>
                <p>This usually takes a few seconds.</p>
              </div>

              <!-- swap .pending → .success / .error for demo -->
              <button class="primary-btn">Done</button>
            </div>

          </div>
        </div>
      </div>
      <div id="execution-tab" class="execute-container">
        {{{execution_tab}}}
      </div>
      <div id="history-tab">
        {{{history_tab}}}
      </div>
      <div id="analytics-tab">
        {{{analytics_tab}}}
      </div>
      <div id="schedules-tab">
        {{{schedules_tab}}}
      </div>
      <div id="settings-tab">
        {{{settings_tab}}}
      </div>
      <div id="swap-options-tab">
        {{{swap_options_tab}}}
      </div>
      <div id="ecai-jobs-tab">
        {{{ecai_jobs_tab}}}
      </div>
      {{{footer}}}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/prismjs/prism.min.js"></script>
    <script
      src="https://cdn.jsdelivr.net/npm/prismjs/components/prism-gherkin.min.js"
    ></script>
    <script
      type="module"
      src="https://unpkg.com/bitcoin-qr@1.4.1/dist/bitcoin-qr/bitcoin-qr.esm.js"
    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"
    ></script>

    <script src="/static/js/reports.js"></script>
    <script src="/static/js/schedules.js"></script>
    <script src="/static/js/lineNumbers.js"></script>
    <script src="/static/js/balances.js"></script>
    <script src="/static/js/lightning_swap_demo.js" defer></script>
    <script type="module" src="/static/js/damage-scheduler-ui.js"></script>
    <script type="module" src="/static/js/installer.js" defer></script>
    <script type="module" src="/static/js/wallet.js" defer></script>
    <script type="module" src="/static/js/wallet-switcher.js" defer></script>
    <script type="module" src="/static/js/main.js" defer></script>
  </body>
</html>