<!-- -*- mode: html -*- -->
<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- OpenGraph (Slack / LinkedIn / Nostr / Discord) -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="DamageBDD — Behaviour Driven Development at Planetary Scale">
    <meta property="og:description" content="DamageBDD turns behaviour into executable infrastructure. Define software expectations in plain language and verify them continuously with deterministic execution, Lightning payments, and cryptographic assurance.">
    <meta property="og:url" content="https://damagebdd.com">
    <meta property="og:site_name" content="DamageBDD">
    <meta property="og:image" content="https://damagebdd.com/static/img/og-damagebdd.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="DamageBDD — Behaviour Driven Development at Planetary Scale">
    <meta name="twitter:description" content="Behaviour becomes executable verification. DamageBDD runs plain-language expectations directly against software with deterministic execution and Lightning-native automation.">
    <meta name="twitter:image" content="https://damagebdd.com/static/img/og-damagebdd.png">
    <meta name="twitter:creator" content="@damagebdd">


    <link rel="icon" type="image/x-icon" href="/static/img/favicon.ico">
    <title>DamageBDD - Behaviour Driven Development At Planetary Scale</title>

    <script src="/static/js/three.min.js"></script>
