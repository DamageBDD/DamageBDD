<!-- -*- mode: html -*- -->
<div class="activity-panel">
  <div class="activity-toolbar">
    <div class="activity-filters">
      <div style="font-weight:600;">Account filters</div>

      <div id="activityAddrTags" class="addr-tags" aria-label="Known accounts">
        <!-- tags injected by JS -->
      </div>

      <div class="addr-add">
        <input id="activityAddrInput" type="text"
               placeholder="Add account (ak_... or ct_...)"
               spellcheck="false" autocomplete="off" inputmode="text"
               class="addr-add__input">
        <button id="activityAddrAddBtn" class="styled-btn" type="button">Add</button>
      </div>

      <div id="activityAddrHint" style="color:#9aa3b2; font-size:.85rem;"></div>
    </div>
  </div>

  <ul id="run-reports-list" class="activity-list"></ul>

  <div id="run-reports-pager" class="activity-pager" aria-label="Pagination">
    <button id="run-reports-prev" class="activity-btn" type="button">◀ Prev</button>
    <button id="run-reports-next" class="activity-btn" type="button">Next ▶</button>
    <span id="run-reports-info" class="activity-pagerinfo"></span>
  </div>
</div>

