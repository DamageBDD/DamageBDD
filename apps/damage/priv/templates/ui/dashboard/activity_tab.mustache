<!-- -*- mode: html -*- -->
<section class="workspace-page" aria-labelledby="activity-heading">
  <div class="workspace-heading">
    <div>
      <p class="workspace-eyebrow">EXECUTION EVIDENCE</p>
      <h1 id="activity-heading">Run history</h1>
      <p>Browse recent verification reports and filter by known account.</p>
    </div>
  </div>

  <div class="activity-panel workspace-card">
    <div class="activity-toolbar workspace-card-body">
      <div class="activity-filters">
        <strong>Account filters</strong>
        <div id="activityAddrTags" class="addr-tags" aria-label="Known accounts"></div>
        <div class="addr-add">
          <label class="visually-hidden" for="activityAddrInput">Add account filter</label>
          <input id="activityAddrInput" type="text"
                 placeholder="Add account (ak_... or ct_...)"
                 spellcheck="false" autocomplete="off" inputmode="text"
                 class="addr-add__input workspace-input">
          <button id="activityAddrAddBtn" class="workspace-button" type="button">Add</button>
        </div>
        <div id="activityAddrHint" class="workspace-helper"></div>
      </div>
    </div>

    <ul id="run-reports-list" class="activity-list"></ul>

    <div id="run-reports-pager" class="activity-pager" aria-label="Pagination">
      <button id="run-reports-prev" class="workspace-button" type="button">◀ Prev</button>
      <button id="run-reports-next" class="workspace-button" type="button">Next ▶</button>
      <span id="run-reports-info" class="activity-pagerinfo workspace-muted"></span>
    </div>
  </div>
</section>
