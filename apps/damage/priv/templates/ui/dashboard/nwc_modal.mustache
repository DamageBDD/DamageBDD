</style>

<script>
(function () {
  if (window.DamageNwcHistory && window.DamageNwcHistory.initialized) return;

  const state = {
    filter: 'active',
    sessions: [],
    accountBalanceSat: null,
    endpoint: '/api/nwc/sessions'
  };

  const $ = (id) => document.getElementById(id);
  const number = (v, fallback = 0) => Number.isFinite(Number(v)) ? Number(v) : fallback;
  const escapeHtml = (value) => String(value == null ? '' : value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');

  function currentAccount() {
    const selectors = [
      '#damage-address',
      '#wallet-address',
      '[data-wallet-address]',
      '[data-ae-account]'
    ];

    for (const selector of selectors) {
      const el = document.querySelector(selector);
      if (!el) continue;
      const value = el.value || el.dataset.walletAddress || el.dataset.aeAccount || el.textContent;
      if (value && value.trim().startsWith('ak_')) return value.trim();
    }

    if (window.damageAccount && String(window.damageAccount).startsWith('ak_')) {
      return String(window.damageAccount);
    }

    return 'unknown-account';
  }

  function shortId(value, left = 8, right = 6) {
    const text = String(value || '');
    if (!text) return 'unknown';
    if (text.length <= left + right + 3) return text;
    return `${text.slice(0, left)}…${text.slice(-right)}`;
  }

  function storageKey() {
    return `damage:nwc:sessions:${currentAccount()}`;
  }

  function readLocalSessions() {
    try {
      return JSON.parse(localStorage.getItem(storageKey()) || '[]');
    } catch (_err) {
      return [];
    }
  }

  function writeLocalSessions(sessions) {
    try {
      localStorage.setItem(storageKey(), JSON.stringify(sessions.slice(0, 100)));
    } catch (_err) {
      // Ignore storage errors; backend history remains the source of truth.
    }
  }

  function selectedRelays() {
    const presets = Array.from(document.querySelectorAll('.nwc-relay-preset:checked')).map((el) => el.value);
    const custom = (($('nwc-custom-relays') || {}).value || '')
      .split(/\n+/)
      .map((line) => line.trim())
      .filter(Boolean);
    return Array.from(new Set([...presets, ...custom]));
  }

  function normalizeSession(raw) {
    const maxTotal = number(raw.max_total_sat ?? raw.max_total ?? raw.maxTotalSat, 0);
    const spent = number(raw.spent_sat ?? raw.spent ?? 0, 0);
    const remaining = number(raw.remaining_sat ?? raw.remaining ?? (maxTotal > 0 ? Math.max(maxTotal - spent, 0) : 0), 0);
    const status0 = String(raw.status || (remaining > 0 ? 'active' : 'expired')).toLowerCase();
    const status = status0 === 'low' ? 'active' : status0;
    const events = Array.isArray(raw.events) ? raw.events : [];

    return {
      owner: raw.owner || currentAccount(),
      ledger_ct: raw.ledger_ct || raw.ledger || raw.ledgerContract || '',
      client_pubkey: raw.client_pubkey || raw.clientPubkey || raw.pubkey || raw.client || '',
      wallet_pubkey: raw.wallet_pubkey || raw.walletPubkey || '',
      relays: Array.isArray(raw.relays) ? raw.relays : (raw.relay ? [raw.relay] : []),
      status,
      created_at: number(raw.created_at || raw.createdAt || Date.now() / 1000),
      last_used_at: number(raw.last_used_at || raw.lastUsedAt || raw.updated_at || raw.created_at || Date.now() / 1000),
      max_single_sat: number(raw.max_single_sat ?? raw.max_single ?? raw.maxSingleSat, 0),
      max_total_sat: maxTotal,
      spent_sat: spent,
      remaining_sat: remaining,
      expires_height: number(raw.expires_height ?? raw.expiresHeight ?? 0),
      events: events.length ? events : [{ type: 'minted', at: raw.created_at || Date.now() / 1000, delta_sat: 0, balance_after_sat: remaining || maxTotal }]
    };
  }

  function saveMintedFromDom() {
    const uriEl = $('nwc-uri');
    const clientEl = $('nwc-client-pubkey');
    const uri = uriEl && uriEl.value ? uriEl.value.trim() : '';
    const clientPubkey = clientEl && clientEl.value ? clientEl.value.trim() : '';
    if (!uri || !clientPubkey) return;

    const maxTotal = number(($('nwc-max-total') || {}).value, 0);
    const minted = normalizeSession({
      owner: currentAccount(),
      client_pubkey: clientPubkey,
      status: 'active',
      created_at: Date.now() / 1000,
      last_used_at: Date.now() / 1000,
      relays: selectedRelays(),
      max_single_sat: number(($('nwc-max-single') || {}).value, 0),
      max_total_sat: maxTotal,
      spent_sat: 0,
      remaining_sat: maxTotal,
      expires_height: number(($('nwc-expires-height') || {}).value, 0),
      events: [{ type: 'minted', at: Date.now() / 1000, delta_sat: 0, balance_after_sat: maxTotal }]
    });

    const sessions = readLocalSessions().filter((s) => s.client_pubkey !== clientPubkey);
    writeLocalSessions([minted, ...sessions]);
    state.sessions = mergeSessions([minted], state.sessions);
    render();
  }

  function markCurrentRevoked() {
    const clientPubkey = (($('nwc-client-pubkey') || {}).value || '').trim();
    if (!clientPubkey) return;

    const sessions = readLocalSessions().map((session) => {
      if (session.client_pubkey !== clientPubkey) return session;
      return {
        ...session,
        status: 'revoked',
        last_used_at: Date.now() / 1000,
        events: [
          ...(session.events || []),
          { type: 'revoked', at: Date.now() / 1000, delta_sat: 0, balance_after_sat: number(session.remaining_sat, 0) }
        ]
      };
    });

    writeLocalSessions(sessions);
    setTimeout(load, 800);
  }

  function mergeSessions(primary, fallback) {
    const byKey = new Map();
    [...fallback, ...primary].forEach((session) => {
      const normalized = normalizeSession(session);
      const key = normalized.client_pubkey || `${normalized.created_at}:${normalized.wallet_pubkey}`;
      byKey.set(key, normalized);
    });
    return Array.from(byKey.values()).sort((a, b) => b.last_used_at - a.last_used_at);
  }

  async function fetchSessions() {
    const response = await fetch(state.endpoint, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'content-type': 'application/json', 'accept': 'application/json' },
      body: JSON.stringify({ limit: 50, include_events: true })
    });

    if (!response.ok) throw new Error(`history endpoint returned ${response.status}`);
    const payload = await response.json();
    return {
      accountBalanceSat: payload.account_balance_sat ?? payload.balance_sat ?? null,
      sessions: Array.isArray(payload.sessions) ? payload.sessions.map(normalizeSession) : []
    };
  }

  async function load() {
    const accountChip = $('nwc-account-chip');
    if (accountChip) {
      const account = currentAccount();
      accountChip.textContent = account === 'unknown-account' ? 'Account unknown' : shortId(account, 10, 8);
      accountChip.title = account;
    }

    const errorEl = $('nwc-history-error');
    if (errorEl) errorEl.hidden = true;

    const localSessions = readLocalSessions().map(normalizeSession);

    try {
      const remote = await fetchSessions();
      state.accountBalanceSat = remote.accountBalanceSat;
      state.sessions = mergeSessions(remote.sessions, localSessions);
      writeLocalSessions(state.sessions);
    } catch (err) {
      state.sessions = localSessions;
      if (errorEl && !localSessions.length) {
        errorEl.textContent = `Session history backend unavailable: ${err.message}.`;
        errorEl.hidden = false;
      }
    }

    render();
  }

  function sessionBadge(session) {
    const pct = session.max_total_sat > 0 ? (session.remaining_sat / session.max_total_sat) : 0;
    if (session.status === 'revoked') return ['REVOKED', 'nwc-badge-revoked'];
    if (session.status === 'expired') return ['EXPIRED', 'nwc-badge-expired'];
    if (pct > 0 && pct <= .2) return ['LOW FUNDS', 'nwc-badge-low'];
    return ['ACTIVE', 'nwc-badge-active'];
  }

  function formatSats(value) {
    const n = number(value, 0);
    return `${n.toLocaleString()} sats`;
  }

  function formatTime(seconds) {
    if (!seconds) return '—';
    const date = new Date(seconds * 1000);
    return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  }

  function formatDateTime(seconds) {
    if (!seconds) return '—';
    const date = new Date(seconds * 1000);
    return date.toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
  }

  function eventLabel(event) {
    const type = String(event.type || event.event || '').replace(/_/g, ' ');
    if (!type) return 'Event';
    return type.charAt(0).toUpperCase() + type.slice(1);
  }

  function visibleSessions() {
    return state.sessions.filter((session) => {
      if (state.filter === 'all') return true;
      if (state.filter === 'low') {
        return session.status === 'active' && session.max_total_sat > 0 && (session.remaining_sat / session.max_total_sat) <= .2;
      }
      return session.status === state.filter;
    });
  }

  function renderSummary() {
    const active = state.sessions.filter((s) => s.status === 'active');
    const remaining = active.reduce((sum, s) => sum + number(s.remaining_sat, 0), 0);

    const balanceEl = $('nwc-summary-account-balance');
    const activeEl = $('nwc-summary-active');
    const remainingEl = $('nwc-summary-remaining');

    if (balanceEl) balanceEl.textContent = state.accountBalanceSat == null ? '—' : formatSats(state.accountBalanceSat);
    if (activeEl) activeEl.textContent = String(active.length);
    if (remainingEl) remainingEl.textContent = formatSats(remaining);
  }

  function renderSession(session) {
    const [badgeText, badgeClass] = sessionBadge(session);
    const maxTotal = number(session.max_total_sat, 0);
    const remaining = number(session.remaining_sat, 0);
    const spent = number(session.spent_sat, 0);
    const pct = maxTotal > 0 ? Math.max(0, Math.min(100, Math.round((remaining / maxTotal) * 100))) : 0;
    const relays = session.relays.length ? session.relays.map((r) => r.replace('wss://', '')).join(', ') : 'no relays recorded';
    const events = session.events.slice(-5).reverse();

    return `
      <article class="nwc-session-card" data-client-pubkey="${escapeHtml(session.client_pubkey)}">
        <div class="nwc-session-head">
          <div>
            <strong>${escapeHtml(badgeText === 'ACTIVE' ? 'Active session' : badgeText.toLowerCase().replace(/^./, (c) => c.toUpperCase()) + ' session')}</strong>
            <code title="${escapeHtml(session.client_pubkey)}">${escapeHtml(shortId(session.client_pubkey, 12, 8))}</code>
          </div>
          <span class="nwc-badge ${badgeClass}">${badgeText}</span>
        </div>

        <div class="nwc-balance-bar" title="${escapeHtml(formatSats(remaining))} remaining from ${escapeHtml(formatSats(maxTotal))}">
          <div class="nwc-balance-fill" style="width:${pct}%"></div>
        </div>

        <div class="nwc-session-metrics">
          <span>Remaining <strong>${escapeHtml(formatSats(remaining))}</strong></span>
          <span>Used <strong>${escapeHtml(formatSats(spent))} / ${escapeHtml(formatSats(maxTotal))}</strong></span>
          <span>Max single <strong>${escapeHtml(formatSats(session.max_single_sat))}</strong></span>
        </div>

        <div class="nwc-session-meta">
          <span>Created <strong>${escapeHtml(formatDateTime(session.created_at))}</strong></span>
          <span>Last activity <strong>${escapeHtml(formatDateTime(session.last_used_at))}</strong></span>
          <span>Relays <code>${escapeHtml(relays)}</code></span>
          ${session.ledger_ct ? `<span>Ledger <code title="${escapeHtml(session.ledger_ct)}">${escapeHtml(shortId(session.ledger_ct, 8, 6))}</code></span>` : ''}
        </div>

        <ol class="nwc-mini-timeline">
          ${events.map((event) => `
            <li>
              <time>${escapeHtml(formatTime(number(event.at || event.created_at || session.created_at)))}</time>
              <span>${escapeHtml(eventLabel(event))}</span>
              <b>${event.delta_sat == null ? escapeHtml(formatSats(event.balance_after_sat ?? remaining)) : escapeHtml(`${number(event.delta_sat) > 0 ? '+' : ''}${number(event.delta_sat)} sats`)}</b>
            </li>`).join('')}
        </ol>

        <div class="nwc-session-actions">
          <button class="nwc-btn nwc-btn-secondary" type="button" data-copy-client="${escapeHtml(session.client_pubkey)}">Copy client pubkey</button>
          ${session.status === 'active' ? `<button class="nwc-btn nwc-btn-danger" type="button" data-revoke-client="${escapeHtml(session.client_pubkey)}">Revoke</button>` : ''}
        </div>
      </article>`;
  }

  function render() {
    renderSummary();
    const list = visibleSessions();
    const timeline = $('nwc-session-timeline');
    const empty = $('nwc-history-empty');

    if (!timeline || !empty) return;

    if (!list.length) {
      timeline.innerHTML = '';
      empty.hidden = false;
      return;
    }

    empty.hidden = true;
    timeline.innerHTML = list.map(renderSession).join('');
  }

  function setFilter(filter) {
    state.filter = filter;
    document.querySelectorAll('#nwc-modal .nwc-filter').forEach((button) => {
      button.classList.toggle('active', button.dataset.nwcFilter === filter);
    });
    render();
  }

  function bindEvents() {
    document.querySelectorAll('#nwc-modal .nwc-filter').forEach((button) => {
      button.addEventListener('click', () => setFilter(button.dataset.nwcFilter || 'active'));
    });

    const refresh = $('nwc-history-refresh-btn');
    if (refresh) refresh.addEventListener('click', load);

    const open = $('open-nwc-modal-btn');
    if (open) open.addEventListener('click', () => setTimeout(load, 120));

    const mint = $('nwc-mint-btn');
    if (mint) mint.addEventListener('click', () => setTimeout(saveMintedFromDom, 900));

    const revoke = $('nwc-revoke-btn');
    if (revoke) revoke.addEventListener('click', markCurrentRevoked);

    const uri = $('nwc-uri');
    const client = $('nwc-client-pubkey');
    [uri, client].filter(Boolean).forEach((el) => {
      el.addEventListener('change', saveMintedFromDom);
      el.addEventListener('input', saveMintedFromDom);
      new MutationObserver(saveMintedFromDom).observe(el, { attributes: true, childList: true, characterData: true, subtree: true });
    });

    const timeline = $('nwc-session-timeline');
    if (timeline) {
      timeline.addEventListener('click', async (event) => {
        const copyButton = event.target.closest('[data-copy-client]');
        if (copyButton) {
          await navigator.clipboard.writeText(copyButton.dataset.copyClient || '');
          copyButton.textContent = 'Copied';
          setTimeout(() => { copyButton.textContent = 'Copy client pubkey'; }, 1000);
          return;
        }

        const revokeButton = event.target.closest('[data-revoke-client]');
        if (revokeButton) {
          const clientPubkey = revokeButton.dataset.revokeClient;
          const currentClient = $('nwc-client-pubkey');
          if (currentClient) currentClient.value = clientPubkey;
          const mainRevoke = $('nwc-revoke-btn');
          if (mainRevoke) mainRevoke.click();
        }
      });
    }
  }

  window.DamageNwcHistory = {
    initialized: true,
    load,
    render,
    rememberMintedSession: saveMintedFromDom,
    markCurrentRevoked,
    setFilter
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => { bindEvents(); load(); });
  } else {
    bindEvents();
    load();
  }
})();
</script>
