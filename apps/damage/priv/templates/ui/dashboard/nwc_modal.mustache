<!-- -*- mode: html -*- -->
<div id="nwc-modal" class="modal micromodal-slide" aria-hidden="true">
  <div class="modal__overlay" tabindex="-1" data-micromodal-close>
    <div class="modal__container nwc-modal" role="dialog" aria-modal="true" aria-labelledby="nwc-title">
      <header class="modal__header nwc-modal-header">
        <div class="nwc-modal-header-copy">
          <div class="nwc-title-row">
            <h2 id="nwc-title" class="nwc-title">Nostr Wallet Connect</h2>
            <span id="nwc-account-chip" class="nwc-account-chip" title="Current AE account">Account loading…</span>
          </div>
          <p class="nwc-subtitle">
            Mint a wallet connection URI for Amethyst, Damus, Primal, and other NWC clients.
          </p>
        </div>

        <button class="modal__close nwc-close" data-micromodal-close type="button">&times;</button>
      </header>

      <div id="nwc-status" class="nwc-status" role="status" aria-live="polite"></div>

      <main class="nwc-modal-main">
        <div class="nwc-grid">
          <section class="nwc-card nwc-config-card" aria-labelledby="nwc-config-title">
            <div class="nwc-card-header">
              <span class="nwc-step-badge">1</span>
              <div>
                <h3 id="nwc-config-title">Configure connection</h3>
                <p>Pick 3–5 relays and set optional spending limits.</p>
              </div>
            </div>

            <div class="nwc-config-body">
              <div class="nwc-field">
                <label class="nwc-label">Session relays</label>

                <div class="nwc-relay-chips" id="nwc-relay-chips">
                  <label class="nwc-chip">
                    <input type="checkbox" class="nwc-relay-preset" value="wss://relay.damus.io" checked>
                    <span>Damus</span>
                  </label>

                  <label class="nwc-chip">
                    <input type="checkbox" class="nwc-relay-preset" value="wss://relay.primal.net" checked>
                    <span>Primal</span>
                  </label>

                  <label class="nwc-chip">
                    <input type="checkbox" class="nwc-relay-preset" value="wss://nos.lol" checked>
                    <span>nos.lol</span>
                  </label>

                  <label class="nwc-chip">
                    <input type="checkbox" class="nwc-relay-preset" value="wss://nostr-01.yakihonne.com">
                    <span>YakiHonne 01</span>
                  </label>

                  <label class="nwc-chip">
                    <input type="checkbox" class="nwc-relay-preset" value="wss://offchain.pub">
                    <span>Offchain</span>
                  </label>
                </div>

                <div id="nwc-relay-count" class="nwc-help">Using 3 relays.</div>
              </div>

              <div class="nwc-field">
                <label for="nwc-custom-relays" class="nwc-label">Custom relays</label>
                <textarea
                  id="nwc-custom-relays"
                  class="nwc-textarea nwc-custom-relays"
                  rows="3"
                  placeholder="One relay per line&#10;wss://relay.example.com"></textarea>
                <div class="nwc-help">Optional. These are added to the selected preset relays.</div>
              </div>

              <div class="nwc-limits">
                <div class="nwc-field">
                  <label for="nwc-max-single" class="nwc-label">Max single</label>
                  <div class="nwc-input-affix">
                    <input id="nwc-max-single" type="number" min="0" value="10" class="nwc-input">
                    <span>sats</span>
                  </div>
                </div>

                <div class="nwc-field">
                  <label for="nwc-max-total" class="nwc-label">Max total</label>
                  <div class="nwc-input-affix">
                    <input id="nwc-max-total" type="number" min="0" value="50" class="nwc-input">
                    <span>sats</span>
                  </div>
                </div>

                <div class="nwc-field">
                  <label for="nwc-expires-height" class="nwc-label">Expires height</label>
                  <input id="nwc-expires-height" type="number" min="0" value="0" class="nwc-input">
                  <div class="nwc-help">0 = never</div>
                </div>
              </div>

              <div class="nwc-actions">
                <button id="nwc-mint-btn" class="nwc-btn nwc-btn-primary" type="button">Mint NWC</button>
                <button id="nwc-clear-btn" class="nwc-btn nwc-btn-secondary" type="button">Clear</button>
              </div>
            </div>
          </section>

          <div class="nwc-result-column">
            <section class="nwc-card nwc-result-card" aria-labelledby="nwc-result-title">
              <div class="nwc-card-header">
                <span class="nwc-step-badge">2</span>
                <div>
                  <h3 id="nwc-result-title">Use connection</h3>
                  <p>Scan the QR or copy the URI into your wallet client.</p>
                </div>
              </div>

              <div id="nwc-empty-state" class="nwc-empty-state">
                <div class="nwc-empty-icon">⚡</div>
                <strong>No connection minted yet</strong>
                <p>Configure the limits and mint a fresh NWC URI.</p>
              </div>

              <div id="nwc-result-body" class="nwc-result-body" hidden>
                <div class="nwc-qr-wrap">
                  <div id="nwc-qr" class="nwc-qr"></div>
                </div>

                <div class="nwc-field">
                  <label for="nwc-uri" class="nwc-label">Connection URI</label>
                  <textarea id="nwc-uri" class="nwc-textarea nwc-uri-box" rows="4" readonly></textarea>
                </div>

                <div class="nwc-inline-actions">
                  <button id="nwc-copy-btn" class="nwc-btn nwc-btn-primary" type="button">Copy URI</button>
                  <button id="nwc-open-btn" class="nwc-btn nwc-btn-secondary" type="button">Open in app</button>
                </div>

                <div class="nwc-field nwc-client-field">
                  <label for="nwc-client-pubkey" class="nwc-label">Client pubkey</label>
                  <input id="nwc-client-pubkey" class="nwc-input nwc-mono" readonly>
                </div>
              </div>
            </section>

            <section class="nwc-card nwc-revoke-card" aria-labelledby="nwc-revoke-title">
              <div class="nwc-card-header nwc-card-header-compact">
                <span class="nwc-step-badge nwc-step-danger">3</span>
                <div>
                  <h3 id="nwc-revoke-title">Revoke connection</h3>
                  <p>Disable the currently displayed client pubkey.</p>
                </div>
              </div>

              <button id="nwc-revoke-btn" class="nwc-btn nwc-btn-danger" type="button">Revoke</button>
            </section>
          </div>

          <section class="nwc-card nwc-history-card" aria-labelledby="nwc-history-title">
            <div class="nwc-card-header nwc-card-header-compact nwc-history-header">
              <span class="nwc-step-badge">4</span>
              <div>
                <h3 id="nwc-history-title">Session history</h3>
                <p>Minted sessions and remaining sats allowance for this AE account.</p>
              </div>
              <button id="nwc-history-refresh-btn" class="nwc-btn nwc-btn-secondary nwc-refresh-small" type="button">Refresh</button>
            </div>

            <div id="nwc-session-summary" class="nwc-session-summary" aria-live="polite">
              <div class="nwc-summary-pill">
                <span>Account sats</span>
                <strong id="nwc-summary-account-balance">—</strong>
              </div>
              <div class="nwc-summary-pill">
                <span>Active sessions</span>
                <strong id="nwc-summary-active">—</strong>
              </div>
              <div class="nwc-summary-pill">
                <span>Session allowance</span>
                <strong id="nwc-summary-remaining">—</strong>
              </div>
            </div>

            <div class="nwc-history-toolbar" role="tablist" aria-label="NWC session filters">
              <button class="nwc-filter active" data-nwc-filter="active" type="button">Active</button>
              <button class="nwc-filter" data-nwc-filter="all" type="button">All</button>
              <button class="nwc-filter" data-nwc-filter="revoked" type="button">Revoked</button>
              <button class="nwc-filter" data-nwc-filter="expired" type="button">Expired</button>
              <button class="nwc-filter" data-nwc-filter="low" type="button">Low balance</button>
            </div>

            <div id="nwc-history-empty" class="nwc-history-empty" hidden>
              No minted NWC sessions found for this account yet.
            </div>

            <div id="nwc-history-error" class="nwc-history-error" hidden></div>
            <div id="nwc-session-timeline" class="nwc-session-timeline"></div>
          </section>
        </div>
      </main>
    </div>
  </div>
</div>

<style>
