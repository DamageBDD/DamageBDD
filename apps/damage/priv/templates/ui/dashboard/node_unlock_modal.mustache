<div class="modal micromodal-slide" id="admin-password-modal" aria-hidden="true">
  <div class="modal__overlay" tabindex="-1" data-micromodal-close>
    <div class="modal__container" role="dialog" aria-modal="true" aria-labelledby="admin-title">
      <header class="modal__header">
        <h2 class="modal__title" id="admin-title">Set Node Admin Password</h2>
      </header>
      <main class="modal__content">
        <form id="admin-password-form" class='panel' >
          <div class="password-wrapper">
            <input type="password" name="password" id="node-admin-password" autocomplete="current-password" required placeholder="Password">
            <button type="button" class="toggle-password" data-target="password">👁️</button>
          </div>
          <button id="admin-password-submit-btn" class="modal__btn modal__btn-primary styled-btn" aria-label="Set node admin password" title="Set Admin Password">Set Admin Password</button><br>
      </main>
    </div>
  </div>
</div>
