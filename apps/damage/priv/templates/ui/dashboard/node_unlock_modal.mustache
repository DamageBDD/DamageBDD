<!-- -*- mode: html -*- -->
<div class="modal micromodal-slide" id="node-unlock-modal" aria-hidden="true">
  <div class="modal__overlay" tabindex="-1" data-micromodal-close>
    <div class="modal__container" role="dialog" aria-modal="true" aria-labelledby="node-unlock-title">
      <header class="modal__header">
        <h2 class="modal__title" id="node-unlock-title">Enter Password to Unlock Node Wallet</h2>
      </header>
      <main class="modal__content">
        <form id="node-unlock-password-form" class='panel' >
          <div class="password-wrapper">
            <input type="password" name="password" id="node-unlock-password" autocomplete="current-password" required placeholder="Password">
            <button type="button" class="toggle-password" data-target="password">👁️</button>
          </div>
          <button id="node-unlock-password-submit-btn" class="modal__btn modal__btn-primary styled-btn" aria-label="Node unlock password" title="Node Unlock Password">Unlock Node</button><br>
        </form>
      </main>
    </div>
  </div>
</div>
