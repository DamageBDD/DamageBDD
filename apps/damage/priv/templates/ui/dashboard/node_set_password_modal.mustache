<!-- -*- mode: html -*- -->
<div class="modal micromodal-slide" id="node-set-password-modal" aria-hidden="true">
  <div class="modal__overlay" tabindex="-1">
    <div class="modal__container" role="dialog" aria-modal="true" aria-labelledby="modal-1-title">
      
      <header class="modal__header">
        <img src="/static/img/logo.png" />
        <h2 class="modal__title" id="modal-1-title">DamageBDD Node Setup</h2>
        <button class="modal__close" aria-label="Close modal" data-micromodal-close></button>
      </header>

      <main class="modal__content" id="modal-1-content">
        <div id="node-setup-tabs">
          <ul data-node-setup-tabs>
            <li><a data-tabby-default href="#set-password-tab">1. Set Password</a></li>
            <li><a href="#seed-phrase-backup-tab" id="seed-phrase-tab-link" style="display:none;">2. Backup Seed Phrase</a></li>
            <li><a href="#sweep-wallet-tab" id="sweep-wallet-tab-link" style="display:none;">3. Sweep Wallet (Optional)</a></li>
          </ul>

          <!-- Tab 1: Set Password -->
          <div id="set-password-tab" class="setup-tab-content">
            <div class="setup-step-header">
              <h3>Step 1: Set Your Node Password</h3>
              <p class="setup-description">Create a strong password to secure your DamageBDD node. You'll need this password to unlock your node. (Password must be at least 8 characters with uppercase, lowercase, digit, and special character)</p>
            </div>
            
            <form id="setNodePasswordForm" onsubmit="return false;">
              <div class="password-wrapper">
                <input type="password"
                       id="node-password"
                       name="node-password"
                       required
                       autocomplete="new-password"
                       placeholder="Enter Node Password">
                <button type="button" class="toggle-password" data-target="node-password">👁️</button>
              </div>

              <div class="password-wrapper">
                <input type="password"
                       id="node-password-confirm"
                       name="node-password-confirm"
                       required
                       autocomplete="new-password"
                       placeholder="Confirm Password">
                <button type="button" class="toggle-password" data-target="node-password-confirm">👁️</button>
              </div>

              <button type="button" id="node-set-password-submit-btn"
                      class="modal__btn modal__btn-primary setup-btn"
                      title="Set Node Password">
                Set Password & Continue
              </button>
            </form>
          </div>

          <!-- Tab 2: Seed Phrase Backup -->
          <div id="seed-phrase-backup-tab" class="setup-tab-content">
            <div class="setup-step-header">
              <h3>Step 2: Backup Your Seed Phrase</h3>
              <div class="warning-box">
                <strong>Important:</strong> Write down your seed phrase in a safe place. You will need it to recover your wallet if you lose access to your node.
              </div>
            </div>
            
            <div id="seed-phrase-container">
              <div id="seed-phrase-placeholder" class="seed-phrase-placeholder">
                <p>Click the button below to reveal your seed phrase.</p>
                <button id="reveal-seed-phrase-btn" class="modal__btn reveal-btn">
                  Reveal Seed Phrase
                </button>
              </div>
              
              <div id="seed-phrase-display" class="seed-phrase-display" style="display:none;">
                <div class="seed-phrase-words" id="seed-phrase-words"></div>
                <button id="copy-seed-phrase-btn" class="modal__btn copy-btn" style="display:none;">
                  📋 Copy to Clipboard
                </button>
              </div>
              
              <div id="seed-phrase-confirmation" style="display:none;">
                <label class="confirmation-checkbox">
                  <input type="checkbox" id="seed-phrase-confirmed" required>
                  <span>I have securely backed up my seed phrase</span>
                </label>
                <button id="seed-phrase-ok-btn" class="modal__btn modal__btn-primary setup-btn" disabled>
                  I've Backed Up My Seed Phrase
                </button>
              </div>
            </div>
          </div>

          <!-- Tab 3: Sweep Wallet (Optional) -->
          <div id="sweep-wallet-tab" class="setup-tab-content">
            <div class="setup-step-header">
              <h3>Step 3: Sweep Wallet (Optional)</h3>
              <p class="setup-description">Transfer all funds from your node wallet to an external address. This is optional and can be done later.</p>
            </div>
            
            <div id="wallet-balance-display" class="wallet-balance-display">
              <p>Loading wallet balance...</p>
            </div>
            
            <form id="sweep-wallet-form">
              <div class="form-group">
                <label for="sweep-wallet-address">Recipient Address</label>
                <input type="text" 
                       id="sweep-wallet-address" 
                       placeholder="Enter recipient address (ak_...)" 
                       required>
                <small class="form-hint">Enter the address where you want to send all funds</small>
              </div>
              
              <div class="form-group">
                <label for="sweep-wallet-password">Confirm Node Password</label>
                <div class="password-wrapper">
                  <input type="password"
                         id="sweep-wallet-password"
                         placeholder="Enter your node password to confirm"
                         required>
                  <button type="button" class="toggle-password" data-target="sweep-wallet-password">👁️</button>
                </div>
                <small class="form-hint">Password required to authorize the transaction</small>
              </div>
              
              <button type="button" id="sweep-wallet-btn" class="modal__btn modal__btn-primary setup-btn">
                Sweep All Funds
              </button>
              
              <button type="button" id="skip-sweep-btn" class="modal__btn skip-btn">
                Skip This Step
              </button>
            </form>
          </div>
        </div>
      </main>

      <footer class="modal__footer">
        <div class="terms">
          By setting up your node, you acknowledge and agree to the 
          <a href="/terms">Terms and Conditions</a>.
        </div>
      </footer>
    </div>
  </div>
</div>

