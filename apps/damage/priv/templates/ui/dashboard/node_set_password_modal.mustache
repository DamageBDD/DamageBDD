<!-- -*- mode: html -*- -->
<div class="modal micromodal-slide" id="node-set-password-modal" aria-hidden="true">
  <div class="modal__overlay" tabindex="-1">
    <div class="modal__container" role="dialog" aria-modal="true" aria-labelledby="modal-1-title">
      
      <header class="modal__header">
        <img src="/static/img/logo.png" />
        <h2 class="modal__title" id="modal-1-title">DamageBDD Node Setup – Set Node Password</h2>
      </header>

      <main class="modal__content" id="modal-1-content">

        <!-- POST directly to cowboy handler -->
        <form id="setNodePasswordForm" 
              method="post" 
              action="/secrets/set_password">
          <br>
          <div class="password-wrapper">
            <input type="password"
                   id="node-password"
                   name="node-password"
                   required
                   autocomplete="new-password"
                   placeholder="Node Password">
            <button type="button" class="toggle-password" data-target="node-password">👁️</button>
          </div>

          <div class="password-wrapper">
          <input type="password"
                 id="node-password-confirm"
                 name="node-password-confirm"
                 required
                 autocomplete="new-password"
                 placeholder="Confirm Password">
            <button type="button" class="toggle-password" data-target="node-password-confirm">👁️</button>
          </div>
          <br>

          <button id="node-set-password-submit-btn"
                  class="modal__btn modal__btn-primary"
                  title="Set Node Password">
            Set Password
          </button>
        </form>

      </main>

      <footer class="modal__footer">
        <div class="terms">
          By setting a password, you acknowledge and agree to the 
          <a href="/terms">Terms and Conditions</a>.
        </div>
      </footer>
    </div>
  </div>
</div>

