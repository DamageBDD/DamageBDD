<!-- -*- mode: html -*- -->
<div class="pure-g">
  <div class="pure-u-1 pure-u-md-1-2">
    <form id="damageForm">
      <div>
        <h3>Create/Edit Feature</h3>
        <button id="picker-dialog-btn" class="styled-btn" aria-label="Select Feature." title="Select a Feature to begin">Select Sample Feature To Begin</button>
      </div>
      <p>Edit Feature in the textarea below.</p>
      <div class="damage-editor">
        <div id="damageLineNumbers" aria-hidden="true"></div>
        <textarea id="damageTextArea" language="gherkin" template="syntax-highlighted" placeholder="Enter test case here ..." rows="20"></textarea>
      </div>
      <div>
        <button type="submit" class="styled-btn" id="execute-feature-btn">Execute Feature</button>
      </div>
    </form>
  </div>
  <div class="pure-u-1 pure-u-md-1-2">
    <div id="run-reports-panel">
      <h3>Run Report</h3>
      <p>Result of the run will be streamed here.</p>
      <p>You can see previous results in the <a id="activity-link" href="#activity-tab">activity tab</a>.</p>
      <div id="run-reports"><ul id="run-reports-ul" data-tabs-reports></ul></div>
    </div>
  </div>
</div>

