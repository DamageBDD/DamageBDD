<!-- -*- mode: html -*- -->
<div class="modal micromodal-slide" id="wallet-modal" aria-hidden="true">
  <div class="modal__overlay" tabindex="-1" data-micromodal-close>
    <div class="modal__container" role="dialog" aria-modal="true" aria-labelledby="modal-1-title">
      <header class="modal__header">
        <h2 class="modal__title" id="modal-1-title">Manage Damage Tokens</h2>
        <button class="modal__close" aria-label="Close modal" data-micromodal-close></button>
      </header>
      <main class="modal__content" id="modal-1-content">
        <section class="session-identity" aria-label="Signed-in identity">
          <strong data-session-kind>Checking session…</strong>
          <code data-session-address></code>
          <p data-wallet-only-note hidden></p>
          <button type="button" class="styled-btn" data-switch-account>Switch account</button>
          <button type="button" class="buttonlink" data-disconnect-wallet>Disconnect and sign out</button>
          <p data-session-feedback role="status" aria-live="polite"></p>
          <small>Save your draft before switching. Switching signs into a separate identity; it does not link or merge accounts.</small>
        </section>
        <select id="walletSelector" hidden>
          <optgroup label="Wallet Type">
            <option value="custodial">Custodial (email)</option>
            <option value="extension">Browser Wallet (AE Extension)</option>
          </optgroup>
        </select>
        <ul data-token-tabs>
          <li><a data-tabby-default href="#ae-wallet-tab">🟠 Aeternity Wallet</a></li>
          <li><a href="#lightning-wallet-tab">⚡ Lightning Wallet</a></li>
        </ul>
        <div id="ae-wallet-tab">

          <h3>Your AE Address</h3>

          <div class="click-copy">
            <input type="text" id="damage-address" readonly>
            <span class="copy-icon" onclick="copyToClipboard('damage-address')"> ⧉</span>
          </div>

          <div id="qrcode-damage"></div>

          <hr>
          <h3>Buy DAMAGE Tokens (Lightning)</h3>

          <form id="invoice-form" data-requires-capability="nwc">
            <label>Amount in Sats</label>
            <input type="number" step="10" value="1000" id="invoice-amount">
            <button class="styled-btn" id="generate-invoice-btn" data-requires-capability="nwc">Generate Lightning Invoice</button>
          </form>

          <hr>

          <h3>Transfer DAMAGE Tokens</h3>

          <form id="transfer-out-form" data-requires-capability="transfer">
            <input type="text"
                   id="damage-transfer-out-address"
                   placeholder="Recipient AE address (ak_...)">

            <input type="number"
                   step="10"
                   id="damage-transfer-out-amount"
                   placeholder="Amount">

            <button class="styled-btn" id="damage-transfer-out-btn" data-requires-capability="transfer">
              Transfer Tokens
            </button>
          </form>

        </div>
        <div id="lightning-wallet-tab">


          <h3>Deposit Sats Credits</h3>

          <form id="ledger-invoice-form" data-requires-capability="nwc">
            <label>Credit Amount (Sats)</label>
            <input type="number" step="10" value="100" id="ledger-invoice-amount">
            <button class="styled-btn" id="generate-ledger-invoice-btn" data-requires-capability="nwc">Generate Credit Invoice</button>
          </form>

          <hr>

          <h3>Nostr Wallet Connect (NWC)</h3>

          <button id="open-nwc-modal-btn" data-requires-capability="nwc"
                  class="styled-btn auth-primary">
            ⚡ Generate NWC Session
          </button>

        </div>
      </main>
      <footer class="modal__footer">
        <!--<button class="modal__btn modal__btn-primary" data-micromodal-close aria-label="Close this dialog window">Close</button>-->
      </footer>
    </div>
  </div>
</div>
