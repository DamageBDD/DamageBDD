<div class="auth-container">
  <div class="auth-card">
    
    <div class="auth-header">
      <h2>Password Reset</h2>
      <p class="auth-subtle">{{message}}</p>
    </div>

    <div class="auth-actions">
      <a href="{{login_url}}" class="pure-button pure-button-primary auth-btn">
        Go to Login →
      </a>

      <div class="auth-divider">or</div>

      <button class="pure-button auth-btn secondary" onclick="window.close()">
        Close Window
      </button>
    </div>

  </div>
</div>
