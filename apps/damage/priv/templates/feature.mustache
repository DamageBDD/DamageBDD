<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>DamageBDD Feature — {{feature_title}}</title>

    <!-- OpenGraph (Discord/Slack/Telegram/etc) -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content="{{feature_title}}" />
    <meta property="og:description" content="{{feature_preview}}" />
    <meta property="og:url" content="{{feature_url}}" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{{feature_title}}" />
    <meta name="twitter:description" content="{{feature_preview}}" />

    <style>
      body { font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; margin: 24px; }
      h1 { font-size: 20px; margin: 0 0 16px 0; }
      pre { background: #0b0f14; color: #e6edf3; padding: 16px; border-radius: 10px; overflow: auto; }
      code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 13px; }
      .sub { opacity: 0.7; font-size: 12px; margin-bottom: 14px; }
      .sub a { color: inherit; }
    </style>
  </head>
  <body>
    <h1>DamageBDD Feature — {{feature_title}}</h1>
    <div class="toolbar">
      <button id="execute-feature-btn" class="btn" type="button">Execute this feature</button>
      <button id="copy-feature-link-btn" class="btn secondary" type="button">Copy feature link</button>
      <span id="feature-action-hint" class="hint"></span>
      <div class="sub">
        Link: <a href="{{feature_url}}">{{feature_url}}</a>
      </div>
    </div>
    <pre><code id="feature-body" class="language-gherkin">{{body}}</code></pre>
    <script>
      (function () {
          const btn = document.getElementById('execute-feature-btn');
          const codeEl = document.getElementById('feature-body');

          const featureText = () => (codeEl && codeEl.textContent ? codeEl.textContent : '').trim();

          if (btn) {
              btn.addEventListener('click', () => {
                  const txt = featureText();
                  if (!txt) return;

                  localStorage.setItem('damagebdd_feature_draft', txt);
                  localStorage.setItem('damagebdd_feature_autorun', '1');

                  window.location.href = '/';
              });
          }
      })();
    </script>
  </body>
</html>



