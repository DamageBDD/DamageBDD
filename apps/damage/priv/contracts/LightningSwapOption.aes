// LightningSwapOption.aes
// Offer book + option registry for DAMAGE ↔ Lightning SAT swaps.
//
// Flow:
//  - Sellers publish OFFERS (with lnaddress, amounts, ttl).
//  - Buyer EXECUTES an offer -> creates an OPTION (Open, no payment hash yet).
//  - Orchestrator resolves lnaddress, fetches invoice, obtains payment_hash.
//  - Orchestrator ATTACHES payment_hash to the option.
//  - Once invoice is paid, orchestrator MARKS option exercised.
//
// @compiler >= 6

// LightningSwapOption.aes
// Offer book + option registry for DAMAGE ↔ Lightning SAT swaps.
//
// @compiler >= 6
include "List.aes"

contract LightningSwapOption =

  datatype option_state =
    Open
    | Exercised
    | Expired
    | Cancelled

  record offer =
    { id            : int,
      seller        : address,
      lnaddress     : string,
      damage_amount : int,
      sats_amount   : int,
      premium       : int,
      ttl_seconds   : int,
      created_at    : int,
      active        : bool}

  // IMPORTANT: don't name this record `option` (Sophia has built-in option('a))
  record swap_option =
    { id              : int,
      buyer           : address,
      seller          : address,
      lnaddress       : string,
      damage_amount   : int,
      sats_amount     : int,
      premium         : int,
      created_at      : int,
      expiry          : int,
      ln_payment_hash : option(hash),
      state           : option_state}

  datatype event =
    OfferAdded(indexed int, indexed address)
    | OfferDeactivated(indexed int, indexed address)
    | OfferReactivated(indexed int, indexed address)
    | OptionCreated(indexed int, indexed address, indexed address)
    | OptionPaymentHashAttached(indexed int, indexed address)
    | OptionExercised(indexed int, indexed address, indexed address)
    | OptionCancelled(indexed int, indexed address, indexed address)
    | OptionExpired(indexed int, indexed address, indexed address)

  record state =
    { next_option_id : int,
      next_offer_id  : int,
      options        : map(int, swap_option),
      offers         : map(int, offer),
      admin          : address}

  stateful entrypoint init(admin : address) : state =
    { next_option_id = 0,
      next_offer_id  = 0,
      options        = {},
      offers         = {},
      admin          = admin}

  function require_admin() =
    require(Call.caller == state.admin, "ONLY_ADMIN")

  function get_offer_unsafe(id : int) : offer =
    switch(Map.lookup(id, state.offers))
      None    => abort("OFFER_NOT_FOUND")
      Some(o) => o

  function get_option_unsafe(id : int) : swap_option =
    switch(Map.lookup(id, state.options))
      None    => abort("OPTION_NOT_FOUND")
      Some(o) => o

  stateful function put_offer(o : offer) =
    put(state{ offers[o.id] = o })


  stateful function put_option(o : swap_option) =
    put(state{ options[o.id] = o })

  // -----------------------------
  // Offers (read)
  // -----------------------------
  entrypoint get_offer(id : int) : offer =
    get_offer_unsafe(id)

            
  function offer_k(p : (int * offer)) : int =
    let (k, _v) = p
    k

  entrypoint list_offer_ids() : list(int) =
    List.map(offer_k, Map.to_list(state.offers))


  function offer_v(p : (int * offer)) : offer =
    let (_k, v) = p
    v

  entrypoint list_offers() : list(offer) =
    List.map(offer_v, Map.to_list(state.offers))


  // -----------------------------
  // Options (read)
  // -----------------------------
  entrypoint get_option(id : int) : swap_option =
    get_option_unsafe(id)

  function option_k(p : (int * swap_option)) : int =
    let (k, _v) = p
    k
  
  entrypoint list_option_ids() : list(int) =
    List.map(option_k, Map.to_list(state.options))

            

  entrypoint get_admin() : address =
    state.admin

  // -----------------------------
  // Offer mutation
  // -----------------------------
  stateful entrypoint add_offer(
      lnaddress     : string,
      damage_amount : int,
      sats_amount   : int,
      premium       : int,
      ttl_seconds   : int
    ) : int =
    require(lnaddress != "", "LNADDRESS_EMPTY")

    require(damage_amount > 0, "DAMAGE_ZERO")
    require(sats_amount > 0, "SATS_ZERO")
    require(ttl_seconds > 0, "TTL_ZERO")

    let id  = state.next_offer_id
    let now = Chain.timestamp

    let o : offer =
      { id            = id,
        seller        = Call.caller,
        lnaddress     = lnaddress,
        damage_amount = damage_amount,
        sats_amount   = sats_amount,
        premium       = premium,
        ttl_seconds   = ttl_seconds,
        created_at    = now,
        active        = true}

    put(state{ next_offer_id = id + 1, offers[id] = o })
    Chain.event(OfferAdded(id, Call.caller))
    id

  stateful entrypoint add_offer_for(
      seller        : address,
      lnaddress     : string,
      damage_amount : int,
      sats_amount   : int,
      premium       : int,
      ttl_seconds   : int
    ) : int =
    require_admin()
    require(lnaddress != "", "LNADDRESS_EMPTY")
    require(damage_amount > 0, "DAMAGE_ZERO")
    require(sats_amount > 0, "SATS_ZERO")
    require(ttl_seconds > 0, "TTL_ZERO")

    let id  = state.next_offer_id
    let now = Chain.timestamp

    let o : offer =
      { id            = id,
        seller        = seller,
        lnaddress     = lnaddress,
        damage_amount = damage_amount,
        sats_amount   = sats_amount,
        premium       = premium,
        ttl_seconds   = ttl_seconds,
        created_at    = now,
        active        = true}

    put(state{ next_offer_id = id + 1, offers[id] = o })
    Chain.event(OfferAdded(id, seller))
    id

  stateful entrypoint set_offer_active(id : int, active : bool) : unit =
    let o = get_offer_unsafe(id)
    require((Call.caller == o.seller) || (Call.caller == state.admin), "UNAUTHORISED_OFFER_EDIT")

    if(active)
      Chain.event(OfferReactivated(id, o.seller))
    else
      Chain.event(OfferDeactivated(id, o.seller))

    put_offer(o{ active = active })

  // -----------------------------
  // Option creation from offer
  // -----------------------------
  stateful entrypoint execute_offer(offer_id : int, buyer : address) : int =
    let off = get_offer_unsafe(offer_id)
    require(off.active, "OFFER_INACTIVE")

    let now    = Chain.timestamp
    let expiry = now + off.ttl_seconds
    require(expiry > now, "EXPIRY_IN_PAST")

    let id = state.next_option_id

    let opt : swap_option =
      { id              = id,
        buyer           = buyer,
        seller          = off.seller,
        lnaddress       = off.lnaddress,
        damage_amount   = off.damage_amount,
        sats_amount     = off.sats_amount,
        premium         = off.premium,
        created_at      = now,
        expiry          = expiry,
        ln_payment_hash = None,
        state           = Open}

    put(state{ next_option_id = id + 1, options[id] = opt })
    Chain.event(OptionCreated(id, buyer, off.seller))
    id

  // Attach hash after LNURL invoice fetched off-chain
  stateful entrypoint attach_payment_hash(id : int, payment_hash : hash) : unit =
    require_admin()
    let o = get_option_unsafe(id)

    require(o.state == Open, "NOT_OPEN")
    require(Chain.timestamp =< o.expiry, "EXPIRED")

    switch(o.ln_payment_hash)
      None =>
        put_option(o{ ln_payment_hash = Some(payment_hash) })
        Chain.event(OptionPaymentHashAttached(id, o.seller))
      Some(_) =>
        abort("HASH_ALREADY_SET")

  stateful entrypoint mark_exercised(id : int, payment_hash : hash) : unit =
    require_admin()
    let o = get_option_unsafe(id)

    require(o.state == Open, "NOT_OPEN")
    require(Chain.timestamp =< o.expiry, "EXPIRED")

    switch(o.ln_payment_hash)
      None        => abort("NO_PAYMENT_HASH")
      Some(h) =>
        require(h == payment_hash, "HASH_MISMATCH")
        put_option(o{ state = Exercised })
        Chain.event(OptionExercised(id, o.buyer, o.seller))

  stateful entrypoint mark_expired(id : int) : unit =
    let o = get_option_unsafe(id)
    require(o.state == Open, "NOT_OPEN")
    require(Chain.timestamp > o.expiry, "NOT_YET_EXPIRED")

    put_option(o{ state = Expired })
    Chain.event(OptionExpired(id, o.buyer, o.seller))

  stateful entrypoint cancel(id : int) : unit =
    let o = get_option_unsafe(id)
    require(o.state == Open, "NOT_OPEN")
    require((Call.caller == o.seller) || (Call.caller == state.admin), "UNAUTHORISED_CANCEL")

    put_option(o{ state = Cancelled })
    Chain.event(OptionCancelled(id, o.buyer, o.seller))

