@compiler >= 6

include "String.aes"

contract interface IAEX141Receiver =
  entrypoint on_aex141_received : (option(address), int, option(string)) => bool

contract InvoiceSettlementNFT =

  datatype metadata_type = URL | OBJECT_ID | MAP
  datatype metadata = MetadataIdentifier(string) | MetadataMap(map(string, string))

  record meta_info =
    { name : string,
      symbol : string,
      base_url : option(string),
      metadata_type : metadata_type }

  record settlement_info =
    { token_id : int,
      attestation_hash : string,
      original_recipient : address,
      paid_on : string,
      reward_class : string,
      issued_height : int }

  datatype event
    = Transfer(address, address, int)
    | Approval(address, address, int, string)
    | ApprovalForAll(address, address, string)
    | Mint(address, int)
    | SettlementRewardMinted(indexed int, indexed address, string)

  record state =
    { admin : address,
      meta_info : meta_info,
      token_to_owners : map(int, address),
      balances : map(address, int),
      approvals : map(int, address),
      operators : map(address, map(address, bool)),
      metadata : map(int, metadata),
      settlements : map(int, settlement_info),
      settlement_ids : map(string, int),
      total_supply : int,
      counter : int }

  entrypoint init() : state =
    { admin = Contract.creator,
      meta_info = { name = "DamageBDD Settlement Rewards", symbol = "DBDDSET", base_url = None, metadata_type = MAP },
      token_to_owners = {},
      balances = {},
      approvals = {},
      operators = {},
      metadata = {},
      settlements = {},
      settlement_ids = {},
      total_supply = 0,
      counter = 1 }

  entrypoint aex141_extensions() : list(string) =
    ["damagebdd_settlement_attestation"]

  entrypoint meta_info() : meta_info =
    state.meta_info

  entrypoint metadata(token_id : int) : option(metadata) =
    Map.lookup(token_id, state.metadata)

  entrypoint total_supply() : int =
    state.total_supply

  entrypoint balance(owner : address) : option(int) =
    Map.lookup(owner, state.balances)

  entrypoint owner(token_id : int) : option(address) =
    Map.lookup(token_id, state.token_to_owners)

  stateful entrypoint transfer(to : address, token_id : int, data : option(string)) =
    let from = require_authorized(token_id)
    require(from != to, "SENDER_MUST_NOT_BE_RECEIVER")
    remove_approval(token_id)
    put(state{ balances[from] @from_balance = from_balance - 1,
               balances[to = 0] @to_balance = to_balance + 1,
               token_to_owners[token_id] = to })
    switch(invoke_nft_receiver(Some(from), to, token_id, data))
      (true, false) => abort("SAFE_TRANSFER_FAILED")
      _ => Chain.event(Transfer(from, to, token_id))

  stateful entrypoint transfer_to_contract(token_id : int) =
    let to = Call.caller
    require(Address.is_contract(to), "CALLER_MUST_BE_A_CONTRACT")
    let from = require_authorized(token_id)
    require(from != to, "SENDER_MUST_NOT_BE_RECEIVER")
    remove_approval(token_id)
    put(state{ balances[from] @from_balance = from_balance - 1,
               balances[to = 0] @to_balance = to_balance + 1,
               token_to_owners[token_id] = to })
    Chain.event(Transfer(from, to, token_id))

  stateful entrypoint approve(approved : address, token_id : int, enabled : bool) =
    let token_owner = require_token_owner(token_id)
    require(Call.caller == token_owner || is_approved_for_all(token_owner, Call.caller),
            "ONLY_OWNER_OR_OPERATOR_CALL_ALLOWED")
    if(enabled)
      put(state{approvals[token_id] = approved})
    else
      remove_approval(token_id)
    Chain.event(Approval(token_owner, approved, token_id, bool_string(enabled)))

  stateful entrypoint approve_all(operator : address, enabled : bool) =
    let owner_ops = Map.lookup_default(Call.caller, state.operators, {})
    let owner_ops1 = owner_ops{[operator] = enabled}
    put(state{operators[Call.caller] = owner_ops1})
    Chain.event(ApprovalForAll(Call.caller, operator, bool_string(enabled)))

  entrypoint get_approved(token_id : int) : option(address) =
    Map.lookup(token_id, state.approvals)

  entrypoint is_approved(token_id : int, approved : address) : bool =
    switch(Map.lookup(token_id, state.approvals))
      None => false
      Some(a) => a == approved

  entrypoint is_approved_for_all(owner : address, operator : address) : bool =
    switch(Map.lookup(owner, state.operators))
      None => false
      Some(owner_ops) => Map.lookup_default(operator, owner_ops, false)

  // The attestation hash is unique. Retrying the same paid invoice cannot mint
  // a second reward, even if a node crashed after submitting the first mint.
  stateful entrypoint mint_settlement(to : address, attestation_hash : string, paid_on : string, reward_class : string) : int =
    require_admin()
    require(String.length(attestation_hash) == 64, "ATTESTATION_HASH_REQUIRED")
    require(String.length(paid_on) == 10, "PAID_ON_REQUIRED")
    require(String.length(reward_class) > 0, "REWARD_CLASS_REQUIRED")
    require(!Map.member(attestation_hash, state.settlement_ids), "SETTLEMENT_ALREADY_MINTED")
    let token_id = state.counter
    let info =
      { token_id = token_id,
        attestation_hash = attestation_hash,
        original_recipient = to,
        paid_on = paid_on,
        reward_class = reward_class,
        issued_height = Chain.block_height }
    let md = MetadataMap(
      { ["name"] = String.concat("DamageBDD Settlement Reward #", Int.to_str(token_id)),
        ["description"] = "Transferable proof-of-settlement reward. Ownership does not transfer the invoice, payment, or receivable.",
        ["image"] = "https://damagebdd.com/static/img/settlement-reward.svg",
        ["external_url"] = "https://damagebdd.com",
        ["attestation_sha256"] = attestation_hash,
        ["paid_on"] = paid_on,
        ["reward_class"] = reward_class,
        ["issuer"] = "DamageBDD" })
    put(state{ counter = token_id + 1,
               total_supply = state.total_supply + 1,
               balances[to = 0] @to_balance = to_balance + 1,
               token_to_owners[token_id] = to,
               metadata[token_id] = md,
               settlements[token_id] = info,
               settlement_ids[attestation_hash] = token_id })
    switch(invoke_nft_receiver(None, to, token_id, None))
      (true, false) => abort("SAFE_TRANSFER_FAILED")
      _ => Chain.event(Mint(to, token_id))
    Chain.event(SettlementRewardMinted(token_id, to, attestation_hash))
    token_id

  entrypoint settlement(token_id : int) : option(settlement_info) =
    Map.lookup(token_id, state.settlements)

  entrypoint settlement_token(attestation_hash : string) : option(int) =
    Map.lookup(attestation_hash, state.settlement_ids)

  entrypoint verifies(token_id : int, attestation_hash : string) : bool =
    switch(Map.lookup(token_id, state.settlements))
      None => false
      Some(value) => value.attestation_hash == attestation_hash

  function require_admin() =
    require(Call.caller == state.admin, "ONLY_ADMIN_CALL_ALLOWED")

  function require_token_owner(token_id : int) : address =
    switch(owner(token_id))
      None => abort("TOKEN_NOT_EXISTS")
      Some(a) => a

  function require_authorized(token_id : int) : address =
    let token_owner = require_token_owner(token_id)
    require(Call.caller == token_owner || is_approved(token_id, Call.caller) || is_approved_for_all(token_owner, Call.caller),
            "ONLY_OWNER_APPROVED_OR_OPERATOR_CALL_ALLOWED")
    token_owner

  stateful function remove_approval(token_id : int) =
    if(Map.member(token_id, state.approvals))
      put(state{approvals = Map.delete(token_id, state.approvals)})

  function invoke_nft_receiver(from : option(address), to : address, token_id : int, data : option(string)) : (bool * bool) =
    if(Address.is_contract(to))
      let receiver : IAEX141Receiver = Address.to_contract(to)
      switch(receiver.on_aex141_received(from, token_id, data, protected = true) : option(bool))
        None => (true, false)
        Some(value) => (true, value)
    else
      (false, false)

  function bool_string(value : bool) : string =
    if(value) "true" else "false"
