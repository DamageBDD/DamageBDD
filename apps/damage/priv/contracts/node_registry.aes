@compiler >= 6

contract NodeRegistry =

  // -----------------------------------------------------------------
  // Damage network NodeRegistry v3
  //
  // One canonical contract is deployed per Aeternity network.  Nodes
  // are globally discoverable by stable node address.  Expensive and
  // fast-changing telemetry (heartbeats, load, benchmark samples) stays
  // off-chain and is signed by the node identity; this registry stores
  // durable identity, routing, compatibility and policy anchors only.
  // -----------------------------------------------------------------

  // Node lifecycle status values:
  //   0 = disabled   (operator disabled; not selected for new work)
  //   1 = active     (eligible for work)
  //   2 = draining   (finish current work; do not accept new work)
  //   3 = suspended  (network governance suspension)
  //   4 = retired    (operator-retired identity; governance may recover)

  record node_meta = {
    name            : string,
    endpoint        : string,
    location        : string,
    version         : string,
    profile_uri     : string,
    capability_hash : string,
    release_hash    : string
    }

  record node_cfg = {
    max_conc      : int,
    protocol_min  : int,
    protocol_max  : int,
    pricing_hash  : string
    }

  record node_info = {
    owner_account : address,
    registered_at : int,
    updated_at    : int,
    status        : int,
    meta          : node_meta,
    cfg           : node_cfg
    }

  record user_info = {
    registry   : address,
    joined     : int,
    tier       : string,
    active     : bool,

    // Historical/candidate ownership index.  The authoritative owner is
    // always nodes[node_id].owner_account.  Keeping this append-only makes
    // reassignment bounded and cheap while middleware/clients can verify it.
    node_ids   : list(address),
    node_count : int
    }

  record state = {
    governance       : address,
    network_id       : string,
    protocol_version : int,
    registry_version : int,
    paused           : bool,
    successor        : option(address),

    users      : map(address, user_info),
    nodes      : map(address, node_info),

    // Append-only global index.  This gives deterministic bounded discovery
    // without scanning map state or relying on recent middleware transactions.
    node_index : map(int, address),
    node_count : int
    }

  datatype event =
      GovernanceChanged(address, address)
    | RegistryPaused(bool)
    | ProtocolVersionChanged(int)
    | SuccessorSet(address)
    | OperatorRegistered(address, address)
    | OperatorUpdated(address)
    | NodeRegistered(address, address, int)
    | NodeUpdated(address, int)
    | NodeReassigned(address, address)

  entrypoint init(network_id : string, protocol_version : int) : state =
    require(String.length(network_id) > 0, "BAD_NETWORK_ID")
    require(protocol_version >= 0, "BAD_PROTOCOL_VERSION")
    { governance       = Call.caller
    , network_id       = network_id
    , protocol_version = protocol_version
    , registry_version = 3
    , paused           = false
    , successor        = None
    , users            = {}
    , nodes            = {}
    , node_index       = {}
    , node_count       = 0
    }

  // -----------------------------------------------------------------
  // Network / registry identity
  // -----------------------------------------------------------------

  entrypoint governance() : address = state.governance
  entrypoint network_id() : string = state.network_id
  entrypoint protocol_version() : int = state.protocol_version
  entrypoint registry_version() : int = state.registry_version
  entrypoint paused() : bool = state.paused
  entrypoint successor() : option(address) = state.successor
  entrypoint node_count() : int = state.node_count

  entrypoint get_node_at(index : int) : address =
    require(index >= 0 && index < state.node_count, "NODE_INDEX_OOB")
    state.node_index[index]

  stateful entrypoint set_governance(new_governance : address) : bool =
    require_governance()
    let old = state.governance
    put(state{ governance = new_governance })
    Chain.event(GovernanceChanged(old, new_governance))
    true

  stateful entrypoint set_paused(paused : bool) : bool =
    require_governance()
    put(state{ paused = paused })
    Chain.event(RegistryPaused(paused))
    true

  stateful entrypoint set_protocol_version(protocol_version : int) : bool =
    require_governance()
    require(protocol_version >= 0, "BAD_PROTOCOL_VERSION")
    put(state{ protocol_version = protocol_version })
    Chain.event(ProtocolVersionChanged(protocol_version))
    true

  stateful entrypoint set_successor(successor : address) : bool =
    require_governance()
    put(state{ successor = Some(successor) })
    Chain.event(SuccessorSet(successor))
    true

  stateful entrypoint clear_successor() : bool =
    require_governance()
    put(state{ successor = None })
    true

  // -----------------------------------------------------------------
  // Operator/account directory
  // -----------------------------------------------------------------

  // Administrative registration remains available for Damage account
  // provisioning.  The registry is shared; this is not per-node deployment.
  stateful entrypoint register_account(account : address, registry : address, tier : string) : bool =
    require_governance()
    require(!Map.member(account, state.users), "ALREADY_REGISTERED")
    let info : user_info =
      { registry   = registry
      , joined     = Chain.timestamp
      , tier       = tier
      , active     = true
      , node_ids   = []
      , node_count = 0
      }
    put(state{ users[account] = info })
    Chain.event(OperatorRegistered(account, registry))
    true

  // Self-service operator registration is deliberately low-privilege.
  // Governance controls tier/activation separately.
  stateful entrypoint register_operator(registry : address) : bool =
    require_write_enabled()
    require(!Map.member(Call.caller, state.users), "ALREADY_REGISTERED")
    let info : user_info =
      { registry   = registry
      , joined     = Chain.timestamp
      , tier       = "community"
      , active     = true
      , node_ids   = []
      , node_count = 0
      }
    put(state{ users[Call.caller] = info })
    Chain.event(OperatorRegistered(Call.caller, registry))
    true

  entrypoint get_user_info(account : address) : user_info =
    require_registered(account)
    state.users[account]

  entrypoint is_registered(account : address) : bool =
    Map.member(account, state.users)

  entrypoint get_registry(account : address) : address =
    require_registered(account)
    state.users[account].registry

  stateful entrypoint update_tier(account : address, tier : string) : bool =
    require_governance()
    require_registered(account)
    let user = state.users[account]
    put(state{ users[account] = user{ tier = tier } })
    Chain.event(OperatorUpdated(account))
    true

  stateful entrypoint set_operator_active(account : address, active : bool) : bool =
    require_governance()
    require_registered(account)
    let user = state.users[account]
    put(state{ users[account] = user{ active = active } })
    Chain.event(OperatorUpdated(account))
    true

  stateful entrypoint update_registry(account : address, registry : address) : bool =
    require_write_enabled()
    require_registered(account)
    require(Call.caller == account || Call.caller == state.governance, "ONLY_OPERATOR_OR_GOVERNANCE")
    let user = state.users[account]
    put(state{ users[account] = user{ registry = registry } })
    Chain.event(OperatorUpdated(account))
    true

  // Candidate/history index.  Clients MUST verify get_node(id).owner_account
  // because reassignment intentionally does not filter historical lists.
  entrypoint get_nodes_for(account : address) : list(address) =
    require_registered(account)
    state.users[account].node_ids

  // -----------------------------------------------------------------
  // Node directory
  // -----------------------------------------------------------------

  stateful entrypoint register_node(
    owner_account : address,
    node_id       : address,
    meta          : node_meta,
    cfg           : node_cfg
    ) : bool =
    require_write_enabled()
    require_registered(owner_account)
    require(state.users[owner_account].active, "OPERATOR_DISABLED")
    require(!Map.member(node_id, state.nodes), "NODE_ALREADY_REGISTERED")

    // A node normally registers with its own AE account.  Governance retains
    // an emergency/provisioning path, but an arbitrary operator cannot claim
    // another node address without possession of that key.
    require(Call.caller == node_id || Call.caller == state.governance, "NODE_ID_MUST_SIGN")
    validate_meta(meta)
    validate_cfg(cfg)

    let index = state.node_count
    let ninfo : node_info =
      { owner_account = owner_account
      , registered_at = Chain.timestamp
      , updated_at    = Chain.timestamp
      , status        = 1
      , meta          = meta
      , cfg           = cfg
      }

    let u0 = state.users[owner_account]
    let u1 = u0{
      node_ids   = node_id :: u0.node_ids,
      node_count = u0.node_count + 1
      }

    put(state{
      nodes[ node_id ] = ninfo,
      users[ owner_account ] = u1,
      node_index[ index ] = node_id,
      node_count = index + 1
      })
    Chain.event(NodeRegistered(node_id, owner_account, index))
    true

  entrypoint get_node(node_id : address) : node_info =
    require_node(node_id)
    state.nodes[node_id]

  entrypoint get_node_owner(node_id : address) : address =
    require_node(node_id)
    state.nodes[node_id].owner_account

  entrypoint is_node_registered(node_id : address) : bool =
    Map.member(node_id, state.nodes)

  stateful entrypoint update_node_meta(node_id : address, meta : node_meta) : bool =
    require_write_enabled()
    let n0 = require_node_info(node_id)
    require_node_manager(node_id, n0)
    validate_meta(meta)
    let n1 = n0{ meta = meta, updated_at = Chain.timestamp }
    put(state{ nodes[node_id] = n1 })
    Chain.event(NodeUpdated(node_id, n1.status))
    true

  stateful entrypoint update_node_cfg(node_id : address, cfg : node_cfg) : bool =
    require_write_enabled()
    let n0 = require_node_info(node_id)
    require_node_manager(node_id, n0)
    validate_cfg(cfg)
    let n1 = n0{ cfg = cfg, updated_at = Chain.timestamp }
    put(state{ nodes[node_id] = n1 })
    Chain.event(NodeUpdated(node_id, n1.status))
    true

  stateful entrypoint set_node_status(node_id : address, status : int) : bool =
    require_write_enabled()
    require(valid_status(status), "BAD_NODE_STATUS")
    let n0 = require_node_info(node_id)

    // Suspension is a network-governance action.  A retired node cannot be
    // reactivated by a compromised node key; governance may recover it.
    if (status == 3 || n0.status == 4)
      require_governance()
    else
      require_node_manager(node_id, n0)

    let n1 = n0{ status = status, updated_at = Chain.timestamp }
    put(state{ nodes[node_id] = n1 })
    Chain.event(NodeUpdated(node_id, status))
    true

  // Compatibility convenience for callers that only need an availability bit.
  stateful entrypoint set_node_enabled(node_id : address, enabled : bool) : bool =
    require_write_enabled()
    let n0 = require_node_info(node_id)
    if (n0.status == 3 || n0.status == 4)
      require_governance()
    else
      require_node_manager(node_id, n0)
    let next_status = if (enabled) 1 else 0
    let n1 = n0{ status = next_status, updated_at = Chain.timestamp }
    put(state{ nodes[node_id] = n1 })
    Chain.event(NodeUpdated(node_id, next_status))
    true

  // Ownership transfer is controlled by the operator account or governance,
  // not merely by the node service key.  This limits damage from a compromised
  // runner key.
  stateful entrypoint reassign_node(node_id : address, new_owner_account : address) : bool =
    require_write_enabled()
    let n0 = require_node_info(node_id)
    require(Call.caller == n0.owner_account || Call.caller == state.governance, "ONLY_OWNER_OR_GOVERNANCE")
    require_registered(new_owner_account)
    require(state.users[new_owner_account].active, "NEW_OPERATOR_DISABLED")

    let old_owner = n0.owner_account
    let old_user = state.users[old_owner]
    let new_user0 = state.users[new_owner_account]
    let old_count = if (old_user.node_count > 0) old_user.node_count - 1 else 0
    let old_user1 = old_user{ node_count = old_count }
    let new_user1 = new_user0{
      node_ids   = node_id :: new_user0.node_ids,
      node_count = new_user0.node_count + 1
      }
    let n1 = n0{
      owner_account = new_owner_account,
      updated_at = Chain.timestamp
      }

    put(state{
      nodes[node_id] = n1,
      users[old_owner] = old_user1,
      users[new_owner_account] = new_user1
      })
    Chain.event(NodeReassigned(node_id, new_owner_account))
    true

  // -----------------------------------------------------------------
  // Internal policy/validation
  // -----------------------------------------------------------------

  function require_governance() =
    require(Call.caller == state.governance, "ONLY_GOVERNANCE")

  function require_write_enabled() =
    if (state.paused)
      require(Call.caller == state.governance, "REGISTRY_PAUSED")

  function require_registered(account : address) =
    require(Map.member(account, state.users), "ACCOUNT_NOT_REGISTERED")

  function require_node(node_id : address) =
    require(Map.member(node_id, state.nodes), "NODE_NOT_REGISTERED")

  function require_node_info(node_id : address) : node_info =
    switch(Map.lookup(node_id, state.nodes))
      None => abort("NODE_NOT_REGISTERED")
      Some(n) => n

  function require_node_manager(node_id : address, n : node_info) =
    require(
      Call.caller == node_id ||
      Call.caller == n.owner_account ||
      Call.caller == state.governance,
      "ONLY_NODE_OWNER_OR_GOVERNANCE")

  function valid_status(status : int) : bool =
    status >= 0 && status =< 4

  function validate_meta(meta : node_meta) =
    require(String.length(meta.name) =< 128, "NAME_TOO_LONG")
    require(String.length(meta.endpoint) =< 512, "ENDPOINT_TOO_LONG")
    require(String.length(meta.location) =< 64, "LOCATION_TOO_LONG")
    require(String.length(meta.version) =< 64, "VERSION_TOO_LONG")
    require(String.length(meta.profile_uri) =< 512, "PROFILE_URI_TOO_LONG")
    require(String.length(meta.capability_hash) =< 128, "CAPABILITY_HASH_TOO_LONG")
    require(String.length(meta.release_hash) =< 128, "RELEASE_HASH_TOO_LONG")

  function validate_cfg(cfg : node_cfg) =
    require(cfg.max_conc >= 0, "BAD_MAX_CONC")
    require(cfg.protocol_min >= 0, "BAD_PROTOCOL_MIN")
    require(cfg.protocol_max >= cfg.protocol_min, "BAD_PROTOCOL_RANGE")
    require(String.length(cfg.pricing_hash) =< 128, "PRICING_HASH_TOO_LONG")
