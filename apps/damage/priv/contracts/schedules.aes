@compiler >= 6

main contract Schedules =
  record schedule =
    { id_hash                  : hash
    , id_plain                 : string
    , cron                     : string
    , feature_hash             : string
    , concurrency              : int
    , created                  : int
    , last_execution_timestamp : option(int)
    , execution_counter        : int
    }

  record state =
    { owner     : address
    , schedules : map(address, map(hash, schedule))
    }

  datatype event =
    ScheduleAdded(address, hash)
    | ScheduleDeleted(address, hash)
    | ScheduleExecuted(address, hash, int)

  stateful entrypoint init() : state =
    { owner = Call.caller
      , schedules = {} }

  function mk_id_hash(id_plain : string) : hash =
    Crypto.blake2b(id_plain)

  function get_user_map(who : address) : map(hash, schedule) =
    Map.lookup_default(who, state.schedules, {})

  stateful entrypoint add_schedule(
      id_plain : string,
      cron : string,
      feature_hash : string,
      concurrency : int) : hash =
    let h = mk_id_hash(id_plain)
    let user_map = get_user_map(Call.caller)
    let sch : schedule =
      { id_hash = h
        , id_plain = id_plain
        , cron = cron
        , feature_hash = feature_hash
        , concurrency = concurrency
        , created = Chain.timestamp
        , last_execution_timestamp = None
        , execution_counter = 0 }
    put(state{ schedules[Call.caller] = user_map{ [h] = sch } })
    Chain.event(ScheduleAdded(Call.caller, h))
    h

  stateful entrypoint delete_schedule(id_plain : string) : bool =
    let h = mk_id_hash(id_plain)
    let user_map = get_user_map(Call.caller)
    let existed = Map.member(h, user_map)
    put(state{ schedules[Call.caller] = Map.delete(h, user_map) })
    if(existed)
      Chain.event(ScheduleDeleted(Call.caller, h))
    existed

  stateful entrypoint delete_schedule_by_hash(id_hash : hash) : bool =
    let user_map = get_user_map(Call.caller)
    let existed = Map.member(id_hash, user_map)
    put(state{ schedules[Call.caller] = Map.delete(id_hash, user_map) })
    if(existed)
      Chain.event(ScheduleDeleted(Call.caller, id_hash))
    existed

  stateful entrypoint mark_executed(id_hash : hash, ts : int) : bool =
    let user_map = get_user_map(Call.caller)
    switch(Map.lookup(id_hash, user_map))
      None => false
      Some(sch) =>
        let updated =
          sch{
            last_execution_timestamp = Some(ts),
            execution_counter = sch.execution_counter + 1
            }
        put(state{ schedules[Call.caller] = user_map{ [id_hash] = updated } })
        Chain.event(ScheduleExecuted(Call.caller, id_hash, updated.execution_counter))
        true

  entrypoint get_schedules() : map(hash, schedule) =
    get_user_map(Call.caller)

  entrypoint get_schedules_for(who : address) : map(hash, schedule) =
    get_user_map(who)

  entrypoint get_all_schedules() : map(address, map(hash, schedule)) =
    state.schedules
