%% Merge these keys into the EXISTING {damage, [...]} entry of config/sys.config.
%% Do not replace the rest of your node configuration. All objects are tuples.
%% Managed downloads/servers run as the unprivileged Damage service account.
[
 {damage, [
   {webdriver_runtime, [
     {enabled, true},
     {data_dir, "/var/lib/damage/webdriver"},
     {python, "python3"},
     {bootstrap, true},             % Explicit permission to fetch/install
     {offline, false},              % true: reuse a complete verified installation
     {bootstrap_timeout_ms, 900000},
     {ready_timeout_ms, 60000},
     {health_interval_ms, 5000},
     {health_failures, 3},
     {restart_delay_ms, 5000},
     {max_restart_delay_ms, 60000},
     {max_failures, 5},
     {chromedriver, [
       {enabled, true},
       {source, download},
       {version, stable},           % Resolve once, then reuse the recorded version
       {port, 9515},
       {base_path, "/"},
       {max_sessions, 1}
       %% For a pinned build: {version, "MAJOR.MINOR.BUILD.PATCH"}, plus
       %% {chrome_sha256, "64_HEX_DIGITS"}, {driver_sha256, "64_HEX_DIGITS"}.
       %% Or source=system with absolute executable and browser paths.
     ]},
     {appium, [
       {enabled, false},            % Enable after selecting the SDK/JDK/device
       {source, download},
       {version, latest},           % Appium 3; fail closed on a different major
       {port, 4723},
       {base_path, "/"},
       {max_sessions, 1},
       {node, [{source, download}, {version, lts}]},
       {drivers, [{uiautomator2, latest}]},
       {doctor, true},
       %% Set these paths to existing installations; alternatively use the
       %% checked-download recipe in webdriver-android-downloads.config.example.
       {java, [{source, system}, {home, "/usr/lib/jvm/java-17-openjdk-amd64"}]},
       {android, [
         {enabled, true}, {source, system},
         {home, "/var/lib/damage/android-sdk"}
       ]},
       %% Android's Chrome version differs from desktop Chrome for Testing.
       %% This opt-in permits ONLY UiAutomator2's matching-driver downloader.
       %% It is forcibly disabled when offline=true or bootstrap=false.
       {chromedriver_autodownload, true}
       %% For offline Android: {android_chromedriver, "/absolute/path/chromedriver"}
     ]},
     %% Source-tree UI fixture only; live-node profiles do not need this server.
     {fixture, [{enabled, false}, {port, 8765}]}
   ]},
   {webdriver, [
     {managed, chromedriver},
     {managed_wait_ms, 960000},
     {dashboard_url, <<"http://127.0.0.1:8080">>},
     {fixture, false},
     {wait_ms, 15000},
     {command_timeout_ms, 30000},
     {session_start_timeout_ms, 120000},
     {idle_timeout_ms, 120000},
     {session_lifetime_ms, 900000},
     {credentials, [
       {username, {env, "DAMAGE_DASHBOARD_TEST_USERNAME"}},
       {password, {env, "DAMAGE_DASHBOARD_TEST_PASSWORD"}}
     ]},
     {capabilities, [
       {browserName, <<"chrome">>},
       {'goog:chromeOptions', [{args, [<<"--headless=new">>, <<"--window-size=1440,1200">>]}]}
     ]}
   ]},
   {webdriver_profiles, [
     {desktop, [
       {managed, chromedriver},
       {dashboard_url, <<"http://127.0.0.1:8080">>},
       {fixture, false},
       {credentials, [
         {username, {env, "DAMAGE_DASHBOARD_TEST_USERNAME"}},
         {password, {env, "DAMAGE_DASHBOARD_TEST_PASSWORD"}}
       ]},
       {capabilities, [
         {browserName, <<"chrome">>},
         {'goog:chromeOptions', [{args, [<<"--headless=new">>, <<"--window-size=1440,1200">>]}]}
       ]}
     ]},
     {android, [
       {managed, appium},
       %% 10.0.2.2 is the standard Android emulator's host, not a real device.
       %% Use the node's reachable address for USB/remote devices.
       {dashboard_url, <<"http://10.0.2.2:8080">>},
       {fixture, false},
       {session_start_timeout_ms, 180000},
       {credentials, [
         {username, {env, "DAMAGE_DASHBOARD_TEST_USERNAME"}},
         {password, {env, "DAMAGE_DASHBOARD_TEST_PASSWORD"}}
       ]},
       {capabilities, [
         {platformName, <<"Android">>}, {browserName, <<"Chrome">>},
         {'appium:automationName', <<"UiAutomator2">>},
         {'appium:udid', <<"emulator-5554">>},
         {'appium:deviceName', <<"DamageBDD test device">>},
         {'appium:newCommandTimeout', 120}
       ]}
     ]}
   ]}
 ]}
].
