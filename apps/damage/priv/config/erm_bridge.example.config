%% Merge this entry into the existing /etc/damage/damage.config Damage options.
%% The socket is provided by damage.service RuntimeDirectory=damage-erm.
%% Credentials are separate from Erlang cookies, wallet keys and node admins.
[{damage, [{erm_bridge, #{
    enabled => true,
    socket => "/run/damage-erm/bridge.sock",
    grants_file => "/etc/damage/erm-users.config",
    max_clients => 8,
    request_timeout_ms => 3000
}}]}].
