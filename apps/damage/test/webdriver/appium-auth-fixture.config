%% Appium mobile-web profile. Provision Appium with the existing managed runtime
%% and review driver, JDK, SDK and dedicated device settings in that sys.config.
%% Set webdriver_sys_config to your reviewed local config; no global npm install.
{webdriver_sys_config, "config/sys.config"}.
{webdriver_suites, [auth_fixture]}.
{webdriver_fixture, auth}.
%% Only fixture override: uses Appium endpoint from the node's managed runtime.
%% Do not override webdriver_runtime here, or you would lose the Appium config.
%% Enable {fixture,[{enabled,true},{port,8766}]} in webdriver_runtime. The CT harness
%% resolves auth_webdriver_fixture.py unless you explicitly supplied a script.
{webdriver, [
    {managed, appium}, {managed_fixture, true}, {fixture, true}, {managed_wait_ms, 960000},
    %% Android emulator reaches the host via 10.0.2.2. For a physical device use
    %% a reviewed host address or adb reverse and set this URL accordingly.
    {dashboard_url, <<"http://10.0.2.2:8766">>}, {session_start_timeout_ms, 180000},
    {capabilities, [{platformName, <<"Android">>}, {browserName, <<"Chrome">>},
        {'appium:automationName', <<"UiAutomator2">>}, {'appium:deviceName', <<"DamageBDD-test-device">>}]}
]}.
