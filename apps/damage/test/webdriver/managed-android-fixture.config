%% Full mobile-web fixture suite with Damage-owned Appium + fixture processes.
%% Set the SDK/JDK paths and device id for a dedicated, provisioned Android host.
{webdriver_suites, [navigation, mobile, composer_fixture]}.
{webdriver_runtime, [
    {enabled,true}, {bootstrap,true}, {offline,false},
    {appium,[
        {enabled,true}, {source,download}, {version,latest}, {port,4723},
        {node,[{source,download},{version,lts}]},
        {drivers,[{uiautomator2,latest}]}, {doctor,true},
        {java,[{source,system},{home,"/usr/lib/jvm/java-17-openjdk-amd64"}]},
        {android,[{enabled,true},{source,system},{home,"/var/lib/damage/android-sdk"}]},
        {chromedriver_autodownload,true}
    ]},
    {fixture,[{enabled,true},{port,8765}]}
]}.
{webdriver,[
    {managed,appium}, {managed_fixture,true}, {fixture,true},
    {dashboard_url,<<"http://10.0.2.2:8765">>},
    {managed_wait_ms,960000}, {session_start_timeout_ms,180000},
    {capabilities,[
        {platformName,<<"Android">>}, {browserName,<<"Chrome">>},
        {'appium:automationName',<<"UiAutomator2">>},
        {'appium:udid',<<"emulator-5554">>},
        {'appium:deviceName',<<"DamageBDD test device">>},
        {'appium:newCommandTimeout',120}
    ]}
]}.
