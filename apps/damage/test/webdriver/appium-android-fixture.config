%% Appium 3 + UiAutomator2, Chrome installed on the emulator/device.
%% On an Android emulator, 10.0.2.2 is the host. For a physical device, override
%% DAMAGE_DASHBOARD_URL with a reachable trusted-LAN host or use adb reverse.
{webdriver_suites, [navigation, mobile, composer_fixture]}.
{webdriver, [
    {endpoint, <<"http://127.0.0.1:4723">>},
    {dashboard_url, <<"http://10.0.2.2:8765">>},
    {fixture, true},
    {command_timeout_ms, 60000},
    {capabilities, [
        {platformName, <<"Android">>},
        {browserName, <<"Chrome">>},
        {'appium:automationName', <<"UiAutomator2">>},
        {'appium:deviceName', <<"Android Emulator">>},
        {'appium:noReset', false},
        {'appium:newCommandTimeout', 120}
        %% Multiple devices: add {'appium:udid', <<"emulator-5554">>}.
        %% Set 'appium:chromedriverExecutable' to a matching, provisioned driver
        %% when required; the suite does not enable automatic binary downloads.
    ]}
]}.
