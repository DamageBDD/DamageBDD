%% One CT command: DamageBDD owns the driver AND the source-tree fixture.
%% Run the test VM as a non-root user. Python 3.10+ and Chrome OS libraries needed.
{webdriver_suites, [navigation, desktop, composer_fixture, composer_keyboard]}.
{webdriver_runtime, [
    {enabled, true}, {bootstrap, true}, {offline, false},
    %% Cache defaults to the node's existing Damage state directory.
    {chromedriver, [{enabled, true}, {source, download}, {version, stable}, {port, 9515}]},
    %% The CT harness resolves the fixture script from its own source tree.
    {fixture, [{enabled, true}, {port, 8765}]}
]}.
{webdriver, [
    {managed, chromedriver}, {managed_fixture, true}, {fixture, true},
    {managed_wait_ms, 960000},
    {capabilities, [
        {browserName, <<"chrome">>},
        {'goog:chromeOptions', [{args, [<<"--headless=new">>, <<"--window-size=1440,1200">>]}]}
    ]}
]}.
