%% Common Test config (not sys.config). Capabilities are nested proplists.
{webdriver_suites, [navigation, desktop, composer_fixture, composer_keyboard]}.
{webdriver, [
    {endpoint, <<"http://127.0.0.1:9515">>},
    {dashboard_url, <<"http://127.0.0.1:8765">>},
    {fixture, true},
    {wait_ms, 15000},
    {command_timeout_ms, 30000},
    {idle_timeout_ms, 120000},
    {session_lifetime_ms, 900000},
    {capabilities, [
        {browserName, <<"chrome">>},
        {'goog:chromeOptions', [{args, [<<"--headless=new">>, <<"--window-size=1440,1200">>]}]}
    ]}
]}.
