%% Responsive Chrome emulation is NOT an Appium/device run.
{webdriver_suites, [navigation, mobile, composer_fixture]}.
{webdriver, [
    {endpoint, <<"http://127.0.0.1:9515">>},
    {dashboard_url, <<"http://127.0.0.1:8765">>},
    {fixture, true},
    {capabilities, [
        {browserName, <<"chrome">>},
        {'goog:chromeOptions', [
            {args, [<<"--headless=new">>]},
            {mobileEmulation, [{deviceMetrics, [
                {width, 390}, {height, 844}, {pixelRatio, 1.0}, {mobile, true}, {touch, true}
            ]}]}
        ]}
    ]}
]}.
