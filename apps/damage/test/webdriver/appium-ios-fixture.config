%% Appium 3 + XCUITest on macOS. Select an installed iPhone simulator/device.
%% On a physical device the fixture host must be reachable over the trusted LAN.
{webdriver_suites, [navigation, mobile, composer_fixture]}.
{webdriver, [
    {endpoint, <<"http://127.0.0.1:4723">>},
    {dashboard_url, <<"http://127.0.0.1:8765">>},
    {fixture, true},
    {command_timeout_ms, 60000},
    {capabilities, [
        {platformName, <<"iOS">>},
        {browserName, <<"Safari">>},
        {'appium:automationName', <<"XCUITest">>},
        {'appium:deviceName', <<"REPLACE_WITH_INSTALLED_IPHONE_SIMULATOR">>},
        {'appium:noReset', false},
        {'appium:newCommandTimeout', 120}
        %% Add the exact simulator/device udid and platformVersion as needed.
    ]}
]}.
