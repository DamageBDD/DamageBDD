%% Imports ONLY the three WebDriver environment keys from the bundled example.
%% Change this to an absolute /path/to/your/sys.config for deployment parity.
{webdriver_sys_config, {priv, "config/webdriver.sys.config"}}.
{webdriver_profile, desktop}.
%% Read-only UI checks (generation/billing remain explicit opt-ins).
{webdriver_suites, [navigation, desktop, live_auth]}.
%% For Android set webdriver_profile=android and select navigation/mobile/live_auth.
%% The referenced sys.config must have appium.enabled=true and correct SDK/device.
