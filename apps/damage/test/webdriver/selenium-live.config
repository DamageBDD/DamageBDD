%% Use an isolated staging node, never a production wallet/account.
%% live_generation invokes the actual ECAI model and is deliberately opt-in.
%% Add live_billing only for a separate invoice-authorised test account.
{webdriver_suites, [navigation, desktop, live_auth]}.
{webdriver, [
    {endpoint, <<"http://127.0.0.1:9515">>},
    {dashboard_url, <<"http://127.0.0.1:8080">>},
    {fixture, false},
    {wait_ms, 30000},
    {credentials, [
        {username, {env, "DAMAGE_UI_USERNAME"}},
        {password, {env, "DAMAGE_UI_PASSWORD"}}
    ]},
    {capabilities, [
        {browserName, <<"chrome">>},
        {'goog:chromeOptions', [{args, [<<"--headless=new">>, <<"--window-size=1440,1200">>]}]}
    ]}
]}.
