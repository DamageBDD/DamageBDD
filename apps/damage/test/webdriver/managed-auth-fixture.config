%% Run on an unprivileged test VM; managed runtime installs a matching Chrome pair.
{webdriver_suites, [auth_fixture]}.
{webdriver_fixture, auth}.
{webdriver_runtime, [
    {enabled, true}, {bootstrap, true}, {offline, false},
    {chromedriver, [{enabled, true}, {source, download}, {version, stable}, {port, 9515}]},
    {fixture, [{enabled, true}, {port, 8766}]}
]}.
{webdriver, [
    {managed, chromedriver}, {managed_fixture, true}, {fixture, true},
    {managed_wait_ms, 960000},
    {capabilities, [{browserName, <<"chrome">>},
        {'goog:chromeOptions', [{args, [<<"--headless=new">>, <<"--window-size=1440,1200">>]}]}]}
]}.
