@compiler >= 6

include "String.aes"
include "token.aes"

main contract IdentityRegistry =
  
  record identity =
    { account  : address,
      meta : string}

  record email_identity =
    { account  : address,
      password : string,
      priv_key : string}

  record state =
    { emails       : map(string, email_identity),   // Email → Account
      npubs        : map(string, identity),   // Nostr PubKey → Account
      lightning    : map(string, identity) }  // Lightning Auth → Account

  stateful entrypoint init() : state =
    { emails = {}, npubs = {}, lightning = {} }

  // Register Email → Account (One-to-One)
  stateful entrypoint register_email(email : string, account: address, password: string, priv_key: string) =
    require(Map.lookup(email, state.emails) == None, "Email already registered.")
    put(state{emails[email] = { account = account, password = password, priv_key = priv_key }})
    true

  stateful entrypoint set_email_password(email : string, password: string) =
    require(Map.lookup(email, state.emails) != None, "Email not registered.")
    put(state{emails[email].password = password})
    true

  // Register Npub → Account (One-to-One)
  stateful entrypoint register_npub(npub : string) =
    require(Map.lookup(npub, state.npubs) == None, "Nostr PubKey already registered")
    put(state{npubs[npub] = { account = Call.caller, meta = "" }})
    true

  // Register Lightning Auth → Account (One-to-One)
  stateful entrypoint register_lightning(auth_key : string) =
    require(Map.lookup(auth_key, state.lightning) == None, "Lightning auth key already registered")
    put(state{lightning[auth_key] = { account = Call.caller, meta = "" }})

  // Get Account by Email
  stateful entrypoint get_account_by_email(email : string) : option(email_identity) =
    switch(Map.lookup(email, state.emails))
      Some(entry) => Some(entry)
      None => None

  // Get Account by Npub
  stateful entrypoint get_account_by_npub(npub : string) : option(address) =
    switch(Map.lookup(npub, state.npubs))
      Some(entry) => Some(entry.account)
      None => None

  // Get Account by Lightning Auth
  stateful entrypoint get_account_by_lightning(auth_key : string) : option(address) =
    switch(Map.lookup(auth_key, state.lightning))
      Some(entry) => Some(entry.account)
      None => None
