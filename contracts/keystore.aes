contract KeypairStorage =

  record keypair = {
    public_key : string,
    encrypted_private_key : string}

  record state = {
    keypairs : map(string, keypair)}

  entrypoint init() : state =
    {keypairs = {}}

  stateful entrypoint store_keypair(username : string, public_key : string, encrypted_private_key : string) =
    require(!Map.member(username, state.keypairs), "Keypair already exists for this user")
    let new_keypair = { public_key = public_key, encrypted_private_key = encrypted_private_key }
    put(state{ keypairs[username] = new_keypair })

  entrypoint get_keypair(username : string) : keypair =
    require(Map.member(username, state.keypairs), "Keypair not found")
    state.keypairs[username]
