@compiler >= 6

include "String.aes"
include "token.aes"

contract KeypairStorage =

  record state = {
    keypairs : map(address, string)}

  entrypoint init() : state =
    {keypairs = {}}

  stateful entrypoint store_key(public_key : address, private_key : string) =
    require(!Map.member(public_key, state.keypairs), "Keypair already exists.")
    put(state{ keypairs[public_key] = private_key })

  entrypoint get_key(public_key : address) :  string =
    require(Map.member(public_key, state.keypairs), "Keypair not found")
    state.keypairs[public_key]
