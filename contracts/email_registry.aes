@compiler >= 6

include "String.aes"
include "token.aes"

main contract EmailRegistry =
  record identity =
    { public_key  : address,
      private_key : string,
      password : string}

  record state =
    { emails       : map(string, identity), // Email → Account
      accounts     : map(address, string)}   // Account → Email

  stateful entrypoint init() : state =
    { emails = {}, accounts = {}}

  // Register Email → Account (One-to-One)
  stateful entrypoint register_email(
      email : string,
      account: address,
      password: string,
      private_key: string ) =
    require(
        Map.lookup(email, state.emails) == None,
        "Email already registered.")
    put(
        state{
            emails[email] = {
                public_key = account,
                password = password,
                private_key = private_key },
            accounts[account] = email} )
    true

  entrypoint get_account(email : string) : identity =
    require(Map.lookup(email, state.emails) != None, "Email not registered.")
    state.emails[email]

  entrypoint get_email(account : address) : identity =
    require(Map.lookup(account, state.accounts) != None, "Account not registered.")
    state.emails[state.accounts[account]]

  stateful entrypoint set_password(email : string, password: string) =
    require(Map.lookup(email, state.emails) != None, "Email not registered.")
    put(state{emails[email].password = password})
