@compiler >= 6

include "String.aes"
include "token.aes"

contract interface KeyStoreType =
  stateful entrypoint store_key: (address, string) => unit
  entrypoint get_key: (address) => string

main contract EmailRegistry =
  record identity =
    { account  : address,
      meta : string}

  record state =
    { emails       : map(string, identity)}   // Email → Account

  stateful entrypoint init() : state =
    { emails = {}}

  // Register Email → Account (One-to-One)
  stateful entrypoint register_email(keystore: KeyStoreType, email : string, account: address, meta: string, priv_key: string) =
    require(Map.lookup(email, state.emails) == None, "Email already registered.")
    keystore.store_key(account, priv_key)
    put(state{emails[email] = { account = account, meta = meta }})

  entrypoint get_account(keystore: KeyStoreType, email : string) : string =
    require(Map.lookup(email, state.emails) != None, "Email not registered.")
    let  ident = state.emails[email]
    keystore.get_key(ident.account)
    //{ ["account"] = Address.to_str(ident.account),
    //  ["private_key"] = keystore.get_key(ident.account),
    //  ["meta"] = ident.meta}

  stateful entrypoint set_meta(email : string, meta: string) =
    require(Map.lookup(email, state.emails) != None, "Email not registered.")
    put(state{emails[email].meta = meta})
