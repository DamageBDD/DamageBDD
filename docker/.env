# .env
#
# Never commit real secrets.

DAMAGE_API_URL=http://localhost:4888/api

# Bitcoin / Lightning network pairing:
#   mainnet: BITCOIN_CHAIN=main    CLN_NETWORK=bitcoin
#   testnet: BITCOIN_CHAIN=test    CLN_NETWORK=testnet
#   signet:  BITCOIN_CHAIN=signet  CLN_NETWORK=signet
#   regtest: BITCOIN_CHAIN=regtest CLN_NETWORK=regtest
BITCOIN_CHAIN=main
CLN_NETWORK=bitcoin

BITCOIN_RPC_USER=damage
BITCOIN_RPC_PASSWORD=change_me_with_openssl_rand_hex_32

# 0 = archival/full node.
# Example pruned value: 55000
BITCOIN_PRUNE=0

CLN_LOG_LEVEL=info
CLN_RUNE=

AE_FEE_MULTIPLIER=2
AE_GAS_MULTIPLIER=2
AE_GAS_PRICE_MULTIPLIER=3

# Tor / SOCKS5 sidecar
# DamageBDD can translate these into Erlang app env:
#   {proxy, {socks5, "tor", 9050}}
#   {proxy_exclude, ["localhost", "127.0.0.1", "ipfs", "ae_mdw", "bitcoin", "lightning", "tor", ".local", ".lan"]}
DAMAGE_PROXY=socks5://tor:9050
DAMAGE_PROXY_HOST=tor
DAMAGE_PROXY_PORT=9050
DAMAGE_PROXY_EXCLUDE=localhost,127.0.0.1,ipfs,ae_mdw,bitcoin,lightning,tor,.local,.lan
TOR_SOCKS_HOST=tor
TOR_SOCKS_PORT=9050

# Core Lightning Tor mode.
CLN_ALWAYS_USE_PROXY=true

# Set after first Tor startup if you want CLN to announce onion inbound:
#   docker compose exec tor cat /var/lib/tor/lightning/hostname
# The value should include the port, for example:
#   abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijkl.onion:9735
CLN_ANNOUNCE_ADDR=

# Bitcoin Core uses Tor for outbound onion/proxy egress in docker-compose.yaml.
# For onion-only Bitcoin P2P, uncomment -onlynet=onion in the bitcoin command.
