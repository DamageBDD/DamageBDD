# .env
#
# Never commit real secrets.

DAMAGE_API_URL=http://localhost:4888/api

# Bitcoin / Lightning network pairing:
#   mainnet: BITCOIN_CHAIN=main    CLN_NETWORK=bitcoin
#   testnet: BITCOIN_CHAIN=test    CLN_NETWORK=testnet
#   signet:  BITCOIN_CHAIN=signet  CLN_NETWORK=signet
#   regtest: BITCOIN_CHAIN=regtest CLN_NETWORK=regtest
BITCOIN_CHAIN=main
CLN_NETWORK=bitcoin

BITCOIN_RPC_USER=damage
BITCOIN_RPC_PASSWORD=change_me_with_openssl_rand_hex_32

# 0 = archival/full node.
# Example pruned value: 55000
BITCOIN_PRUNE=0

CLN_LOG_LEVEL=info
CLN_RUNE=

AE_FEE_MULTIPLIER=2
AE_GAS_MULTIPLIER=2
AE_GAS_PRICE_MULTIPLIER=3
