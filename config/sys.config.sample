            {x11, [
                {socket_dir, "/tmp/.X11-unix"}, {probe_timeout_ms, 1500},
                {probe_commands, ["xdpyinfo", "xset", "xprop"]},
                {authority_paths, [
                    "/run/user/%UID%/xauth_*", "/run/user/%UID%/Xauthority*",
                    "/run/user/%UID%/gdm/Xauthority", "%HOME%/.Xauthority"
                ]}
            ]}
        ]},

        %% DPMS/screensaver integration
        {dpms, [
            {enabled, false}, {poll_ms, 100}, {screensaver_timeout, keep},
            {dpms_timeouts, keep}, {dpms_on_saver, off},
            {on_start_delay, 0}, {on_start, undefined}, {on_stop, undefined}
