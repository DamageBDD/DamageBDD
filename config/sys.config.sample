            {binary, undefined}, {model, undefined}, {config, undefined},
            {espeak_data, undefined}, {player, undefined}
        ]},

        {whisper_trigger, [
            %% Native capture is deliberately disabled in the portable sample.
            %% Before setting enabled=true, install the native backend and ensure
            %% binary, whisper_model, vad_model, speaker_model, arecord and
            %% profile_file are absolute paths. speaker_model must already exist:
            %% erm_native_voice hashes it synchronously during init.
            {enabled, false}, {backend, native}, {bin, auto}, {model, auto},
            {auto_start, true}, {echo_output, true}, {cleanup_existing, true},
            {output_dedupe_ms, 3000}, {capture, -1}, {hostname, "damage"},
            {trigger_phrases, ["bob"]}, {debounce_ms, 3000},
            {step_ms, 500}, {length_ms, 5000}, {keep_ms, 200},
            {threads, 4}, {max_tokens, 32}, {audio_ctx, 0}, {beam_size, 5},
            {vad_threshold, 0.60}, {freq_threshold, 100.0}, {language, "en"},
            {use_gpu, true}, {flash_attention, true}, {temperature_fallback, true},
            {extra_args, []},
            %% trigger_handler may be a fun in runtime API; static sys.config normally
            %% leaves it unset to use the built-in handler.
            {voice, [
                {enabled, false}, {require_final, false}, {settle_ms, 1100},
                {urgent_settle_ms, 300}, {command_window_ms, 8000},
                {rearm_silence_ms, 6000}, {command_dedupe_ms, 6000},
                {max_command_bytes, 512}, {planning_timeout_ms, 30000},
                {action_timeout_ms, 30000}, {ollama_timeout_ms, 12000},
                {ecai_timeout_ms, 4000}, {auto_pull_model, true},
                {model_pull_timeout_ms, 600000}, {actions, []},
                {model, "qwen3:1.7b"}, {keep_alive, "10m"},
                {ollama_host, "127.0.0.1"}, {ollama_port, 11434},
                {ecai_base_dir, undefined}, {model_pull_notify, true},
                {debug_utterances, false}
            ]},
            {native, [
                {binary, "/opt/damage/lib/erm/priv/erm_native_voice"},
                {whisper_model, "/opt/models/whisper/ggml-base.en.bin"},
                {vad_model, "/opt/models/silero_vad.onnx"},
                {speaker_model, "/opt/models/speaker.onnx"},
                {arecord, "/usr/bin/arecord"}, {profile_file, "/var/lib/damage/voice/owner.profile"},
                {device, "default"}, {language, "en"}, {threads, 4},
                {silence_ms, 700}, {max_segment_ms, 8000}, {min_speaker_ms, 1200},
                {require_speaker, true}, {startup_timeout_ms, 120000},
                {inference_timeout_ms, 30000}, {trigger_phrases, ["bob"]},
                {debug_utterances, false}, {observe_only, true}, {speaker_threshold, 0.7}
            ]}
        ]},

        %% ERM Lens
        {lens, [
