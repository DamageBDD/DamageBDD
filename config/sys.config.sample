%%% -*- mode: erlang; erlang-indent-level: 4; -*-
%% ---------------------------------------------------------------------------
%% DamageBDD exhaustive sys.config sample
%% ---------------------------------------------------------------------------
%% This file is the single documented configuration reference for the in-tree
%% DamageBDD applications. It supersedes the old config/*fragment* snippets.
%%
%% Coverage policy:
%%   * every current canonical application:get_env/app.src option consumed by
%%     damage, ecai, erm, erm_pay, nosternity and bop is listed;
%%   * structured application-owned configuration is shown as tuple/proplist
%%     data; runtime modules normalize it to internal maps where required;
%%   * compatibility aliases remain accepted by code where migration requires
%%     them, but are intentionally not presented as canonical options here;
%%   * OTP/library-owned schemas (Logger and cowboy_swagger) retain maps because
%%     those APIs define map-shaped configuration;
%%   * commented options are documented overrides, not requirements. Leaving
%%     them commented uses the source default shown beside the option;
%%   * secrets/private keys/tokens should use the encrypted secrets layer even
%%     where a legacy application-env option still exists.
%%
%% Erlang term files do not expand ${ENVIRONMENT_VARIABLES}. Paths beginning
%% with ~/ are expanded only by DamageBDD modules that explicitly support it.
[
    {
        kernel,
        [
            %% Logger primary threshold. Development keeps debug available to
            %% file handlers; production sample uses info.
            {logger_level, info},
            {module_level, info, [damage_reload]},
            {
                logger,
                [
                    {module_level, debug, [
                        erm_voice,
                        erm_voice_intent,
                        erm_voice_media,
                        whisper_trigger_srv,
                        erm_tts
                    ]},
                    {handler, erm_voice_file, logger_std_h, #{
                        level => debug,
                        filter_default => stop,
                        filters => [
                            {only_erm_voice, {
                                fun logger_filters:domain/2, {log, sub, [erm, voice]}
                            }}
                        ],
                        config => #{
                            type => file,
                            file => "/var/log/damage/erm_voice.log",
                            max_no_bytes => 10485760,
                            max_no_files => 5,
                            compress_on_rotate => true,
                            filesync_repeat_interval => 1000
                        },
                        formatter =>
                            {logger_formatter, #{
                                single_line => true,
                                chars_limit => 8192,
                                template => [time, " ", level, " ", pid, " ", msg, "\n"]
                            }}
                    }},
                    {handler, erm_whisper_file, logger_std_h, #{
                        level => debug,
                        filter_default => stop,
                        filters => [
                            {only_erm_whisper, {
                                fun logger_filters:domain/2, {log, sub, [erm, whisper]}
                            }}
                        ],
                        config => #{
                            type => file,
                            file => "/var/log/damage/erm_whisper.log",
                            max_no_bytes => 10485760,
                            max_no_files => 5,
                            compress_on_rotate => true,
                            filesync_repeat_interval => 1000
                        },
                        formatter =>
                            {logger_formatter, #{
                                single_line => true,
                                chars_limit => 8192,
                                template => [time, " ", level, " ", pid, " ", msg, "\n"]
                            }}
                    }},
                    {handler, erm_tts_file, logger_std_h, #{
                        level => debug,
                        filter_default => stop,
                        filters => [
                            {only_erm_tts, {
                                fun logger_filters:domain/2, {log, sub, [erm, tts]}
                            }}
                        ],
                        config => #{
                            type => file,
                            file => "/var/log/damage/erm_tts.log",
                            max_no_bytes => 10485760,
                            max_no_files => 5,
                            compress_on_rotate => true,
                            filesync_repeat_interval => 1000
                        },
                        formatter =>
                            {logger_formatter, #{
                                single_line => true,
                                chars_limit => 8192,
                                template => [time, " ", level, " ", pid, " ", msg, "\n"]
                            }}
                    }},

                    %% Console: warnings/errors only, excluding explicitly
                    %% routed subsystem domains.
                    {
                        handler,
                        default,
                        logger_std_h,
                        #{
                            level => warning,
                            filter_default => log,
                            filters => [
                                {exclude_erm_voice, {
                                    fun logger_filters:domain/2, {stop, sub, [erm, voice]}
                                }},
                                {exclude_erm_whisper, {
                                    fun logger_filters:domain/2, {stop, sub, [erm, whisper]}
                                }},
                                {exclude_erm_tts, {
                                    fun logger_filters:domain/2, {stop, sub, [erm, tts]}
                                }},
                                {exclude_erm_lens, {
                                    fun logger_filters:domain/2, {stop, sub, [erm, lens]}
                                }},
                                {exclude_nsecbunker, {
                                    fun logger_filters:domain/2, {stop, sub, [damage, nsecbunker]}
                                }},
                                {exclude_nwc, {
                                    fun logger_filters:domain/2, {stop, sub, [damage, nwc]}
                                }},
                                {exclude_nostr_relay, {
                                    fun logger_filters:domain/2, {stop, sub, [damage, nostr, relay]}
                                }}
                            ],
                            config => #{type => standard_io},
                            formatter => {pretty_logger, #{}}
                        }
                    },

                    %% Exact debug events outside dedicated subsystem domains.
                    {
                        handler,
                        debug_file,
                        logger_std_h,
                        #{
                            level => debug,
                            filter_default => stop,
                            filters => [
                                {exclude_erm_voice, {
                                    fun logger_filters:domain/2, {stop, sub, [erm, voice]}
                                }},
                                {exclude_erm_whisper, {
                                    fun logger_filters:domain/2, {stop, sub, [erm, whisper]}
                                }},
                                {exclude_erm_tts, {
                                    fun logger_filters:domain/2, {stop, sub, [erm, tts]}
                                }},
                                {exclude_erm_lens, {
                                    fun logger_filters:domain/2, {stop, sub, [erm, lens]}
                                }},
                                {exclude_nsecbunker, {
                                    fun logger_filters:domain/2, {stop, sub, [damage, nsecbunker]}
                                }},
                                {exclude_nwc, {
                                    fun logger_filters:domain/2, {stop, sub, [damage, nwc]}
                                }},
                                {exclude_nostr_relay, {
                                    fun logger_filters:domain/2, {stop, sub, [damage, nostr, relay]}
                                }},
                                {debug_only, {fun logger_filters:level/2, {log, eq, debug}}}
                            ],
                            config => #{
                                type => file,
                                file => "/var/log/damage/debug.log",
                                max_no_bytes => 10485760,
                                max_no_files => 5,
                                compress_on_rotate => true
                            },
                            formatter => {pretty_logger, #{}}
                        }
                    },

                    %% Operational timeline outside dedicated subsystem domains.
                    {
                        handler,
                        info_file,
                        logger_std_h,
                        #{
                            level => info,
                            filter_default => log,
                            filters => [
                                {exclude_erm_voice, {
                                    fun logger_filters:domain/2, {stop, sub, [erm, voice]}
                                }},
                                {exclude_erm_whisper, {
                                    fun logger_filters:domain/2, {stop, sub, [erm, whisper]}
                                }},
                                {exclude_erm_tts, {
                                    fun logger_filters:domain/2, {stop, sub, [erm, tts]}
                                }},
                                {exclude_erm_lens, {
                                    fun logger_filters:domain/2, {stop, sub, [erm, lens]}
                                }},
                                {exclude_nsecbunker, {
                                    fun logger_filters:domain/2, {stop, sub, [damage, nsecbunker]}
                                }},
                                {exclude_nwc, {
                                    fun logger_filters:domain/2, {stop, sub, [damage, nwc]}
                                }},
                                {exclude_nostr_relay, {
                                    fun logger_filters:domain/2, {stop, sub, [damage, nostr, relay]}
                                }}
                            ],
                            config => #{
                                type => file,
                                file => "/var/log/damage/info.log",
                                max_no_bytes => 10485760,
                                max_no_files => 5,
                                compress_on_rotate => true
                            },
                            formatter => {pretty_logger, #{}}
                        }
                    },

                    %% Warning/error triage outside dedicated subsystem domains.
                    {
                        handler,
                        error_file,
                        logger_std_h,
                        #{
                            level => warning,
                            filter_default => log,
                            filters => [
                                {exclude_erm_voice, {
                                    fun logger_filters:domain/2, {stop, sub, [erm, voice]}
                                }},
                                {exclude_erm_whisper, {
                                    fun logger_filters:domain/2, {stop, sub, [erm, whisper]}
                                }},
                                {exclude_erm_tts, {
                                    fun logger_filters:domain/2, {stop, sub, [erm, tts]}
                                }},
                                {exclude_erm_lens, {
                                    fun logger_filters:domain/2, {stop, sub, [erm, lens]}
                                }},
                                {exclude_nsecbunker, {
                                    fun logger_filters:domain/2, {stop, sub, [damage, nsecbunker]}
                                }},
                                {exclude_nwc, {
                                    fun logger_filters:domain/2, {stop, sub, [damage, nwc]}
                                }},
                                {exclude_nostr_relay, {
                                    fun logger_filters:domain/2, {stop, sub, [damage, nostr, relay]}
                                }}
                            ],
                            config => #{
                                type => file,
                                file => "/var/log/damage/error.log",
                                max_no_bytes => 10485760,
                                max_no_files => 10,
                                compress_on_rotate => true,
                                filesync_repeat_interval => 1000
                            },
                            formatter =>
                                {pretty_logger, #{
                                    max_event_chars => 12000,
                                    max_text_chars => 4096,
                                    max_binary => 128,
                                    max_string => 512,
                                    max_list => 24,
                                    max_map => 32,
                                    max_tuple => 24,
                                    depth => 6
                                }}
                        }
                    },

                    %% ERM Lens owns a hierarchical Logger domain. Subdomains
                    %% such as [erm,lens,relay] route here automatically.
                    {
                        handler,
                        erm_lens_file,
                        logger_std_h,
                        #{
                            level => debug,
                            filter_default => stop,
                            filters => [
                                {only_erm_lens, {
                                    fun logger_filters:domain/2, {log, sub, [erm, lens]}
                                }}
                            ],
                            config => #{
                                type => file,
                                file => "/var/log/damage/erm_lens.log",
                                max_no_bytes => 10485760,
                                max_no_files => 5,
                                compress_on_rotate => true,
                                filesync_repeat_interval => 1000
                            },
                            formatter => {pretty_logger, #{}}
                        }
                    },
                    {
                        handler,
                        blossom_file,
                        logger_std_h,
                        #{
                            level => debug,
                            filter_default => stop,
                            filters => [
                                {only_damage_blossom, {
                                    fun logger_filters:domain/2,
                                    {log, sub, [damage, blossom]}
                                }}
                            ],
                            config => #{
                                type => file,
                                file => "/var/log/damage/blossom.log",
                                max_no_bytes => 10485760,
                                max_no_files => 10,
                                compress_on_rotate => true,
                                filesync_repeat_interval => 1000
                            },
                            formatter =>
                                {pretty_logger, #{
                                    max_event_chars => 12000,
                                    max_text_chars => 4096,
                                    max_binary => 256,
                                    max_string => 1024,
                                    max_list => 32,
                                    max_map => 48,
                                    max_tuple => 24,
                                    depth => 8
                                }}
                        }
                    },

                    %% NIP-46 bunker runtime and relay transport.
                    {
                        handler,
                        nsecbunker_file,
                        logger_std_h,
                        #{
                            level => debug,
                            filter_default => stop,
                            filters => [
                                {only_nsecbunker, {
                                    fun logger_filters:domain/2,
                                    {log, sub, [damage, nsecbunker]}
                                }}
                            ],
                            config => #{
                                type => file,
                                file => "/var/log/damage/nsecbunker.log",
                                max_no_bytes => 10485760,
                                max_no_files => 10,
                                compress_on_rotate => true,
                                filesync_repeat_interval => 1000
                            },
                            formatter => {pretty_logger, #{}}
                        }
                    },

                    %% NIP-47 / Nostr Wallet Connect listener.
                    {
                        handler,
                        nwc_file,
                        logger_std_h,
                        #{
                            level => debug,
                            filter_default => stop,
                            filters => [
                                {only_nwc, {
                                    fun logger_filters:domain/2,
                                    {log, sub, [damage, nwc]}
                                }}
                            ],
                            config => #{
                                type => file,
                                file => "/var/log/damage/nwc.log",
                                max_no_bytes => 10485760,
                                max_no_files => 10,
                                compress_on_rotate => true,
                                filesync_repeat_interval => 1000
                            },
                            formatter => {pretty_logger, #{}}
                        }
                    },

                    %% Generic Nostr relay-pool workers.
                    {
                        handler,
                        nostr_relay_file,
                        logger_std_h,
                        #{
                            level => debug,
                            filter_default => stop,
                            filters => [
                                {only_nostr_relay, {
                                    fun logger_filters:domain/2,
                                    {log, sub, [damage, nostr, relay]}
                                }}
                            ],
                            config => #{
                                type => file,
                                file => "/var/log/damage/nostr_relay.log",
                                max_no_bytes => 10485760,
                                max_no_files => 10,
                                compress_on_rotate => true,
                                filesync_repeat_interval => 1000
                            },
                            formatter => {pretty_logger, #{}}
                        }
                    },

                    %% damage_gun is project-owned and emits [damage,gun].
                    {
                        handler,
                        damage_gun_file,
                        logger_std_h,
                        #{
                            level => debug,
                            filter_default => stop,
                            filters => [
                                {only_damage_gun, {
                                    fun logger_filters:domain/2, {log, sub, [damage, gun]}
                                }}
                            ],
                            config => #{
                                type => file,
                                file => "/var/log/damage/damage_gun.log",
                                max_no_bytes => 10485760,
                                max_no_files => 5,
                                compress_on_rotate => true
                            },
                            formatter => {pretty_logger, #{}}
                        }
                    }
                ]
            }
        ]
    },
    {damage, [
        %% Core node / HTTP
        {feature_dirs, ["./features/"]},
        {contracts_dir, "apps/damage/priv/contracts"},
        {run_user, "damage"},
        {api_url, "http://127.0.0.1:4888"},
        {ip, {127, 0, 0, 1}},
        {port, 4888},
        {cookie_secure, false},
        {allowance, 0},
        {node_admins, []},
        {strict_no_catchall, true},
        {cmd_allowed, []},

        %% State / secrets
        {state_dir, "~/.local/state/damage"},
        {secrets_state_dir, "~/.local/state/damage"},
        {runtime_data_dir, "~/.local/state/damage/runtime/data"},
        {runs_dir, "~/.local/state/damage/runtime/runs"},
        %% {keystore, "~/.local/state/damage/keys/damage.key"},
        %% {secrets_dets_file, "~/.local/state/damage/dets/damage.dets"},

        %% Outbound proxy / Tor
        {proxy, none},
        {proxy_exclude, [
            "localhost", "127.0.0.1", "::1", ".local", ".lan", ".internal"
        ]},
        %% {tor_control_host, "127.0.0.1"},
        %% {tor_control_port, 9051},
        %% {tor_control_timeout, 5000},
        %% {tor_control_cookie_file, "/run/tor/control.authcookie"},
        %% {tor_control_password, "DO_NOT_STORE_PLAINTEXT_PASSWORDS_HERE"},
        %% {tor_socks_host, "127.0.0.1"},
        %% {tor_socks_port, 9050},
        %% {tor_hidden_service_hostname_file, "/var/lib/damage/tor/hostname"},

        %% Aeternity
        {ae_network_id, "ae_mainnet"},
        {ae_tls, true},
        {ae_nodes, [{"mainnet.aeternity.io", 443, "/"}]},
        {ae_mdw_nodes, [{"mainnet.aeternity.io", 443, "/mdw/"}]},
        {ae_mdw_ws_nodes, [{"mainnet.aeternity.io", 443, "/mdw/v3/websocket"}]},
        {ae_fee_multiplier, 2},
        {ae_gas_price_multiplier, 3},
        %% ae_gas_multiplier is deprecated/ignored by the current contract path.
        %% Contract execution gas is estimated through dry-run; do not configure it.
        {ae_nonce_strategy, chain},
        %% Deployment contract overrides. These were present in the old full
        %% profiles but should only be set to real deployed contracts.
        %% {account_registry_ct, "ct_REPLACE_ME"},
        %% {node_registry_ct, "ct_REPLACE_ME"},

        %% Nostr relay entries accept a URL string or a tuple/proplist.
        {nostr_relays, [
            [{url, "wss://nos.lol"}],
            [{url, "wss://relay.primal.net"}, {profile, primal}, {proxy, direct}]
        ]},
        {nostr_relay_proxy_policy, [
            {cloudflare_browser, direct},
            {primal, direct},
            {yakihonne, direct},
            {default, auto}
        ]},
        %% {nostr_npub, "npub1_REPLACE_ME"},

        %% Nostr Wallet Connect
        {nwc_ledger_mode, operator_signed},
        {nwc_relays, ["wss://nos.lol", "wss://relay.primal.net"]},
        {nwc_balance_cache_ttl_ms, 5000},

        %% Bitcoin / Lightning. Credentials are intentionally not included.
        {bitcoin_rpc_host, "127.0.0.1"},
        {bitcoin_rpc_port, 8332},
        {bitcoin_rpc_user, "damage"},
        {bitcoin_wallet, "damage"},
        {cln_enabled, false},
        {cln_websocket_enabled, true},
        {cln_restart_backoff_ms, 30000},
        {cln_host, "127.0.0.1"},
        {cln_port, 3010},
        {cln_wspath, "/"},
        {cln_cacertfile, "/var/lib/damage/lightning/ca.pem"},
        {cln_certfile, "/var/lib/damage/lightning/client.pem"},
        {cln_keyfile, "/var/lib/damage/lightning/client-key.pem"},
        {l402_price_msat, 1000},
        {l402_min_sats, 1},
        {l402_invoice_expiry, 600},
        {l402_uses, 1},

        %% Monero wallet RPC; spending is off by default.
        {monero_wallet_rpc_host, "127.0.0.1"},
        {monero_wallet_rpc_port, 18083},
        {monero_wallet_rpc_timeout, 120000},
        {monero_wallet_rpc_transport, tcp},
        {monero_wallet_rpc_allow_remote, false},
        {monero_account_index, 0},
        {monero_min_confirmations, 10},
        {monero_poll_interval_ms, 10000},
        {monero_store_after_invoice, true},
        {monero_steps_require_admin, true},
        {monero_allow_spend, false},
        {monero_transfer_priority, 0},
        {monero_do_not_relay, false},

        %% Canonical IPFS runtime/client configuration. The legacy flat ipfs_*
        %% aliases are intentionally omitted. `ipfs` below is reserved for Kubo
        %% config entries consumed by ipfs_util.
        {ipfs_runtime, [
            {managed_kubo, false},
            {kubo_repo, "~/.local/state/damage/runtime/ipfs/kubo"},
            {kubo_api_port, 5002},
            {kubo_gateway_port, 8081},
            {kubo_swarm_port, 4002},
            {kubo_start_timeout_ms, 15000},
            {kubo_retry_ms, 5000},
            {kubo_gc, true},
            {kubo_binary, "ipfs"},
            %% Leave ipfs_api unset unless connecting to an externally managed Kubo.
            %% unmanaged_kubo=false defaults to http://127.0.0.1:5001; when
            %% managed_kubo=true the runtime derives it from kubo_api_port.
            {ipfs_peers, []},
            %% Structured peers may group several transports under one peer id:
            %% {ipfs_peers, [
            %%     [{peer_id, <<"12D3KooW...">>},
            %%      {addrs, ["/ip4/127.0.0.1/tcp/4001/p2p/12D3KooW..."]}]
            %% ]},
            {peer_interval_ms, 30000},
            {backend, damage_ipfs_backend},
            {data_dir, "~/.local/state/damage/runtime/ipfs"},
            {request_timeout_ms, 50000},
            {connect_timeout_ms, 5000},
            {http_timeout_ms, 15000},
            {client_concurrency, 8},
            {client_queue_limit, 64},
            {fetch_concurrency, 4},
            {fetch_queue_limit, 32},
            {max_request_bytes, 67108864},
            {max_response_bytes, 67108864},
            {max_intents, 100000},
            {pin_poll_ms, 1000},
            {retry_base_ms, 2000},
            {retry_max_ms, 300000},
            {health_interval_ms, 30000},
            {reconcile_interval_ms, 60000},
            {reconcile_batch, 32},
            {max_peers, 128},
            {loop_timeout_ms, 120000},
            {headers, []}
        ]},
        {ipfs, [
            {"Addresses.Gateway", "/ip4/127.0.0.1/tcp/8081"}
        ]},

        %% Blossom / NIP-96
        {blossom_public_base_url, "http://127.0.0.1:4888"},
        {blossom_max_bytes, 67108864},
        {blossom_max_serve_bytes, 67108864},
        {blossom_upload_timeout_ms, 120000},
        {blossom_pin_uploads, true},
        {blossom_auth_clock_skew_seconds, 20},
        {blossom_auth_max_age_seconds, 300},
        {blossom_auth_max_ttl_seconds, 900},
        {blossom_allowed_content_types, [
            "image/jpeg", "image/png", "image/gif", "image/webp", "image/avif",
            "image/heic", "image/heif", "video/mp4", "video/quicktime",
            "video/webm", "audio/mpeg", "audio/ogg", "audio/wav", "application/pdf"
        ]},
        {blossom_allow_octet_stream, false},
        {blossom_upload_ip_requests_per_minute, 60},
        {blossom_upload_pubkey_requests_per_minute, 20},
        {blossom_delete_ip_requests_per_minute, 60},
        {blossom_delete_pubkey_requests_per_minute, 30},
        {blossom_download_ip_requests_per_minute, 600},
        {blossom_list_ip_requests_per_minute, 60},
        {blossom_rate_max_keys, 100000},
        {nip96_public_base_url, "http://127.0.0.1:4888"},
        {nip96_max_bytes, 67108864},
        {nip96_upload_timeout_ms, 120000},
        {nip96_pin_uploads, true},

        %% Build-release NFT publication. These settings were previously kept
        %% in sys.config.nft-release.fragment.config. Leave contract/account
        %% identifiers commented until a deployment has real values.
        %% {build_release_nft_contract, "ct_REPLACE_WITH_EXISTING_NFT_CONTRACT"},
        %% {build_release_reader_account, "ak_REPLACE_WITH_PUBLIC_READER_ACCOUNT"},
        {build_release_query_timeout, 10000},
        {build_release_ipfs_gateway, "https://ipfs.io/ipfs"},
        {build_release_publish_timeout, 300000},
        {build_release_require_installation, true},
        {build_release_announce_oracle, false},

        %% SMTP metadata; password is the encrypted smtp_pass secret.
        {smtp_host, "127.0.0.1"},
        {smtp_hostname, "localhost"},
        {smtp_from, {"DamageBDD Node", "damage@localhost"}},
        {smtp_user, ""},
        {smtp_port, 25},

        %% Worker pools and external supervised commands.
        {pools, [
            {damage, [{size, 4}, {max_overflow, 8}], []},
            {damage_ai, [{size, 1}, {max_overflow, 2}], []},
            {formatter, [{size, 4}, {max_overflow, 16}], []}
        ]},
        {abduco_workers, []},
        %% Market and systemd shapes retained from the retired full profiles.
        %% {market_rules, [
        %%     {"DAMAGEUSDT", [{price_precision, 4}, {min_qty, 100.0}]}
        %% ]},
        %% {systemd, [
        %%     {nginx, {admins, ["ak_REPLACE_ME"]}}
        %% ]},
        %% {abduco_workers, [
        %%     [{name, lightpanda},
        %%      {cmd, ["bin/lightpanda-x86_64-linux", "--verbose"]},
        %%      {env, [{"EXAMPLE", "value"}]}]
        %% ]},

        %% fs-based operator code reload (replacement for the removed Sync app).
        {code_reload, [
            {enabled, false},              %% false | dev | true
            {mode, sources},               %% sources | rebar
            {root, "/absolute/path/to/DamageBDD"},
            {apps, [damage, nosternity, erm, ecai, vanillae, bop]},
            {source_dirs, ["/var/lib/damage/custom/src"]},
            {include_dirs, ["/var/lib/damage/custom/include"]},
            {modules, [steps_local]},
            {erl_opts, [debug_info]},
            {reuse_compile_opts, true},
            {profile, "default"},
            {rebar3, "rebar3"},
            {build_dir, "/absolute/path/to/DamageBDD/_build/damage_reload"},
            {debounce_ms, 300},
            {retry_ms, 1000},
            {rescan_ms, 5000},
            {build_timeout_ms, 300000},
            {load_on_start, false},
            {exclude_modules, []}
        ]},

        {operator_hotcode, [
            {enabled, false},
            {allowed_modules, [steps_http, text_formatter, html_formatter]}
        ]},
        {operator_source_dir, "/var/lib/damage/overrides/src"},

        %% SSH services. ssh_subsystems is the canonical enable switch; the
        %% nested enabled flags are retained for standalone/legacy starts.
        {ssh_subsystems, []},
        {ssh_git, [
            {enabled, false},
            {listen_addr, {127, 0, 0, 1}},
            {port, 2222},
            {system_dir, "~/.local/state/damage/ssh/git/system"},
            {user_dir, "~/.local/state/damage/ssh/git/user"},
            {repos_root, "~/.local/state/damage/git"},
            {allow_push, []},
            {git_exec_timeout_ms, 600000}
        ]},
        {ssh_tunnel, [
            {enabled, false},
            {ip, {127, 0, 0, 1}},
            {port, 2223},
            {system_dir, "~/.local/state/damage/ssh/tunnel/system"},
            {user_dir, "~/.local/state/damage/ssh/tunnel/user"},
            {hello_timeout, 5000},
            {negotiation_timeout, 30000},
            {max_sessions, 16},
            {tunnel_start_port, 8888},
            {tunnel_end_port, 9000},
            {tunnel_target_host, "localhost"},
            {tunnel_target_port, 8888}
        ]},

        %% NIP-46 custody. Disabled by default. Canonical keys are shown; old
        %% aliases such as bunker_pubkey, bdd_contract_sha, rate_limit_backend
        %% and limits.rate_limit_* are intentionally omitted.
        {nsecbunker, [
            {enabled, false},
            {mode, development},
            {secret_provider, local},
            {state_dir, "~/.local/state/damage"},
            {vault_mode, create_if_missing},
            {vault_path, "~/.local/state/damage/keys/nsecbunker/node.vault"},
            {audit_log, "~/.local/state/damage/logs/nsecbunker_audit.log"},
            {crypto_backend_cmd, "/opt/damage/bin/damage-nsecbunker-crypto-c"},
            {crypto_init_timeout_ms, 5000},
            {crypto_timeout_ms, 10000},
            {crypto_unlock_timeout_ms, 15000},
            {vault_passphrase, nsecbunker_vault_passphrase},
            {bunker_pubkey_hex, "REPLACE_WITH_64_HEX_PUBKEY"},
            {bunker_npub, "npub1_REPLACE_ME"},
            {contract_sha, "REPLACE_WITH_RATIFIED_CONTRACT_SHA"},
            {authorized_clients, []},
            {allowed_methods, [connect, ping, get_public_key, sign_event]},
            {allowed_kinds, [1, 30023]},
            {relays, ["wss://relay.damus.io", "wss://relay.primal.net", "wss://nos.lol"]},
            {relay_client_enabled, false},
            {relay_autosubscribe, true},
            {relay_publication_mode, return_only},
            {require_inbound_p_tag, true},
            {bunker_publishes, false},
            {signing_timeout_ms, 10000},
            {bootstrap_retry_min_ms, 1000},
            {bootstrap_retry_max_ms, 30000},
            {relay_connect_timeout_ms, 15000},
            {relay_publish_timeout_ms, 15000},
            {relay_reconnect_ms, 5000},
            {relay_max_reconnect_ms, 300000},
            {relay_max_retries, 8},
            {relay_circuit_open_ms, 900000},
            {relay_subscribe_mfa, {damage_nsecbunker_relay, subscribe}},
            {relay_publish_mfa, {damage_nsecbunker_relay, publish_event}},
            {limits, [
                {created_at_skew_seconds, 600},
                {max_kind_1_bytes, 4096},
                {max_kind_30023_bytes, 131072}
            ]},
            {max_event_bytes, [{1, 4096}, {30023, 131072}]},
            {required_tags, [{30023, ["d", "title", "published_at"]}]},
            {reject_active_content, true},
            {kind_30023, [
                {require_tags, ["d", "title", "published_at"]},
                {reject_html, true}
            ]},
            {rate_backend, ets},
            {rate_limit, [{max_requests, 30}, {window_seconds, 60}]},
            {genesis, [{enabled, false}, {allowed_content_sha256, []}]},
            {report_dir, "/var/lib/damage/nsecbunker/reports"},
            {phase4a_dev_vault_path, "/var/lib/damage/nsecbunker/dev_damagebdd_rehearsal.vault"},
            {phase4b_prod_vault_path, "/var/lib/damage/nsecbunker/damagebdd_node_production.vault"},
            {phase4b_production_key_script,
                "scripts/nsecbunker/phase4b_create_production_damagebdd_node_key.sh"},
            {backend_owner, damage_nsecbunker_secret_owner},
            {backend_module, damage_nsecbunker_port}
            %% AWS Secrets Manager is production-only and must be explicitly selected.
            %% Never enable this on a generic workstation: the provider intentionally
