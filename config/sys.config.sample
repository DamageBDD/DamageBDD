%%% -*- mode: erlang; erlang-indent-level: 2; -*-

[
    {sasl, [{sasl_error_logger, false}, {errlog_type, error}]},
    %{error_logger, [
    %    {report_module, [gen_smtp_client]}
    %]},
    {
        kernel,
        [
            {logger_level, debug},
            {
                logger,
                [
                    {
                        handler,
                        default,
                        logger_std_h,
                        #{
                            filters =>
                                [
                                    {
                                        default,
                                        {fun logger_filters:domain/2, {stop, super, [otp, sasl]}}
                                    },
                                    {debug, {fun logger_filters:level/2, {log, gt, debug}}}
                                ]
                        }
                    },
                    {
                        handler,
                        debug,
                        logger_std_h,
                        #{
                            filters =>
                                [{debug, {fun logger_filters:level/2, {stop, neq, debug}}}],
                            config => #{file => "logs/debug.log"}
                        }
                    },
                    {
                        handler,
                        error,
                        logger_std_h,
                        #{
                            single_line => false,
                            filters =>
                                [{error, {fun logger_filters:level/2, {stop, neq, error}}}],
                            config => #{file => "logs/error.log"}
                        }
                    },
                    {
                        handler,
                        info,
                        logger_std_h,
                        #{
                            filters =>
                                [{info, {fun logger_filters:level/2, {stop, neq, info}}}],
                            config => #{file => "logs/info.log"}
                        }
                    }
                ]
            }
        ]
    },
    {
        throttle,
        [
            {
                rates,
                [
                    {damage_global_scope, 10, per_second},
                    {damage_api_rate, 10, per_minute}
                ]
            }
        ]
    },
    {mustache, [{templates_dir, "priv/templates"}]},
    {erlexec, [root, {user, "damage"}, {limit_users, ["damage"]}]},
    {
        damage,
        [
            {api_url, "https://run.staging.damagebdd.com"},
            {allowance, 1000},
            {lnpay_host, "https://asyncmind.xyz"},
            {token_contract, "ct_2taq2WPRer6pkVV7JjiYrkTNr8vr61nLAHQFWbJ3jpX6iyCeBi"},
            {account_contract, "ct_aBXwRhTXYXyD6Gqz7Vk7Nq3U1QhMsZuxFyZ2GvoiroKavxW6B"},
            {identity_contract, "ct_aBXwRhTXYXyD6Gqz7Vk7Nq3U1QhMsZuxFyZ2GvoiroKavxW6B"},
            {
                node_admins,
                [
                    "ak_2eu6yAH46eu9T88WN7MDnyr1QzW6GLWAc667Z93U44wLewuhLN",
                    "ak_2E6i569eKpWuRYP9CsAUgDthWG8C9VVMrs8UrzAem5AMQ3RXkk"
                ]
            },
            {port, 8080},
            {smtp_host, "smtp.sendgrid.net"},
            {smtp_hostname, "damagebdd.com"},
            {smtp_from, {"DamageBDD Staging", "staging@damagebdd.com"}},
            {smtp_user, "apikey"},
            {smtp_port, 587},
            {nostr_relay, "nos.lol"},
            {data_dir, "/var/lib/damagebdd/"},
            {bitcoin_rpc_port, 8332},
            %{bitcoin_rpc_user, "damagebdd_prod"},
            {bitcoin_rpc_user, "asyncmind"},
            {bitcoin_wallet, "damagebdd_prod"},
            {lnd_host, "localhost"},
            {lnd_port, 8011},
            {lnd_wspath, "/v1/invoices/subscribe?method=GET"},
            {lnd_certfile, "/var/lib/lnd/tls.cert"},
            {lnd_keyfile, "/var/lib/lnd/tls.key"},
            {cln_host, "localhost"},
            {cln_port, 3010},
            {cln_wspath, "/"},
            {cln_cacertfile, "~/.lightning/bitcoin/ca.pem"},
            {cln_certfile, "~/.lightning/bitcoin/client.pem"},
            {cln_keyfile, "~/.lightning/bitcoin/client-key.pem"},
            {ae_network_id, "ae_mainnet"},
            {
                ae_nodes,
                [
                    {"localhost", 3013, "/"}
                    %{"testnet.aeternity.io", 443, "/"}
                    %{"mainnet.aeternity.io", 443, ""}
                ]
            },
            {
                ae_mdw_nodes,
                [
                    {"localhost", 4000, "/"}
                    %{"testnet.aeternity.io", 443, "/mdw/"}
                    %{"mainnet.aeternity.io", 443, "/mdw/"}
                ]
            },
            {ae_mdw_ws_nodes, [{"localhost", 4002, "/"}]},
            {cmd_allowed, ["zx list deps"]},
            {chromedriver, "http://localhost:9515/"},
            {
                pools,
                [
                    {damage, [{size, 10}, {max_overflow, 100}], []},
                    {damage_ai, [{size, 2}, {max_overflow, 5}], []},
                    {formatter, [{size, 3}, {max_overflow, 500}], []},
                    {lnd, [{size, 1}, {max_overflow, 0}], []},
                    {cln, [{size, 1}, {max_overflow, 0}], []},
                    {ecai_chat, [{size, 1}, {max_overflow, 0}], []},
                    %{damage_ssh, [{size, 1}, {max_overflow, 0}], []},
                    {
                        damage_ipfs,
                        [{size, 2}, {max_overflow, 5}],
                        [
                            {"ipfs0.lan", 5001},
                            {"ipfs1.lan", 5001},
                            {"ipfs2.lan", 5001}
                        ]
                    }
                ]
            },
            {abduco_workers, [
                #{
                    name => "lightningd",
                    cmd =>
                        "/usr/sbin/lightningd"
                },

                #{name => "lightpanda", cmd => "bin/lightpanda-x86_64-linux --verbose"},
                #{name => "chromedriver", cmd => "chromedriver --port=9515"},
                #{name => "ipfs", cmd => "ipfs daemon"},
                #{name => "epmd", cmd => "epmd"}
            ]},
            {market_rules, #{
                <<"DAMAGEUSDT">> => #{price_precision => 4, min_qty => 100.0}
            }}
        ]
    },
    {
        damage_ssh,
        [
            {user_dir, "/var/lib/damagebdd/sshtest_user/.ssh"},
            {system_dir, "/var/lib/damagebdd/ssh_daemon/"}
        ]
    },
    {
        damage_systemd,
        [
            {
                nginx,
                {admins, ["ak_2eu6yAH46eu9T88WN7MDnyr1QzW6GLWAc667Z93U44wLewuhLN"]}
            }
        ]
    },
    {
        cowboy_swagger,
        [
            %% `static_files`: Static content directory. This is where Swagger-UI
            %% is located. Default: `priv/swagger`.
            %% Remember that Swagger-UI is embedded into `cowboy-swagger` project,
            %% within `priv/swagger` folder. BUT you have to reference that path,
            %% and depending on how youre using `cowboy-swagger` it will be different.
            %% For example, assuming that you want to run your app which has
            %% `cowboy-swagger` as dependency from the console, `static_files` will be:
            {static_files, "./_build/default/lib/cowboy_swagger/priv/swagger"},
            %% `global_spec`: Global fields for Swagger specification.
            %% If these fields are not set, `cowboy_swagger` will set default values.
            {
                global_spec,
                #{
                    swagger => "2.0",
                    info => #{title => "DamageBDD API"},
                    basePath => "/api-docs"
                }
            }
        ]
    },
    {bcrypt, [{mechanism, "port"}]},
    {sync, [{src_dirs, {replace, [{"./src"}]}}]}
].
