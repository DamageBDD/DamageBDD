    {nosternity, [
        %% Service controls. HTTP API and WebSocket share this listener.
        {enabled, true},
        {http_enabled, true},
        {websocket_enabled, true},
        %% Loopback by default; use {0,0,0,0} for all IPv4 interfaces,
        %% or a specific local interface address. WebSocket path: /nostr.
        {ip, {127, 0, 0, 1}},
        {port, 9001},
        {http_num_acceptors, 10},
        {http_max_connections, 1024},
        {http_idle_timeout_ms, 60000},
        {http_request_timeout_ms, 10000},
        {websocket_idle_timeout_ms, 120000},

        %% A search relay needs no signing identities. Enable only when
        %% nosternity_nostr_nsec and inglorious_nostr_nsec are configured.
        {nostr_clients_enabled, false},

        %% Durable event store and ECAI query limits. Preserve this DETS
        %% file across restarts: it also retains deletion tombstones.
        {search_store_file, "data/nosternity/search.dets"},
        {search_max_events, 10000},
        {search_default_limit, 50},
        {search_max_limit, 200},
        {max_subscriptions, 32},
        {max_total_subscriptions, 4096},
        {max_filters, 8},
        {max_filter_values, 256},
        {websocket_messages_per_minute, 120},
        {subscriber_queue_max, 256},

        %% /context works without inference. /ask additionally requires
