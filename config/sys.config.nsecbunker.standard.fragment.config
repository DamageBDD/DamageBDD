%% Standard sys.config fragment.
%% Merge under the existing {damage, [...]} application environment.
%% No maps (#{}) and no binary strings (<<"...">>) are used here.

{nsecbunker, [
    {enabled, false},
    {relay_client_enabled, false},
    {mode, phase4a_dev_rehearsal},

    {crypto_backend_cmd, "/opt/damage/bin/damage-nsecbunker-crypto-c"},
    {crypto_timeout_ms, 5000},

    {vault_path, "/var/lib/damage/nsecbunker/dev_damagebdd.vault"},
    {audit_log, "/var/log/damage/nsecbunker_audit.log"},

    %% DEV/DISPOSABLE until Phase 4B. Replace after dev key creation.
    {bunker_pubkey_hex, "REPLACE_WITH_DEV_DAMAGEBDD_PUBKEY_HEX"},
    {bunker_npub, "REPLACE_WITH_DEV_DAMAGEBDD_NPUB"},

    %% Fill with Brain/ClawDog/dev client pubkey hex strings.
    {authorized_clients, [
        "REPLACE_WITH_AUTHORISED_DEV_CLIENT_PUBKEY_HEX"
    ]},

    {allowed_methods, [connect, ping, get_public_key, sign_event]},
    {allowed_kinds, [1, 30023]},

    {relays, [
        "wss://relay.damus.io",
        "wss://relay.primal.net",
        "wss://nos.lol"
    ]},

    {limits, [
        {created_at_skew_seconds, 600},
        {created_at_window_seconds, 600},
        {max_kind_1_bytes, 4096},
        {max_kind_30023_bytes, 131072},
        {rate_limit_per_minute, 12},
        {rate_limit_window_seconds, 60},
        {request_timeout_ms, 10000}
    ]},

    %% Optional explicit max-by-kind override. Integer keys are accepted.
    {max_event_bytes, [
        {1, 4096},
        {30023, 131072}
    ]},

    {kind_30023, [
        {require_tags, ["d", "title", "published_at"]},
        {reject_html, true}
    ]},

    {reject_active_content, true},
    {bunker_publishes, false},
    {signing_timeout_ms, 10000},

    {rate_limit, [
        {max_requests, 30},
        {window_seconds, 60}
    ]},

    %% Phase 4A dev rehearsal should not hash-lock Genesis content.
    {genesis, [
        {enabled, false},
        {allowed_content_sha256, []}
    ]},

    {secret_hint, "<out-of-band-secret>"}
]}.
