%% Merge under the existing {damage, [...]} application env.
%% Phase 2C is vector hardening: real NIP44 is enabled in backend, relay remains off.

{nsecbunker, #{
    enabled => true,
    relay_client_enabled => false,

    crypto_backend_cmd => "priv/crypto/damage-nsecbunker-crypto-c/damage-nsecbunker-crypto-c",
    crypto_timeout_ms => 10000,

    %% Phase 2C must not use plain loopback in production/key-ceremony mode.
    phase => crypto_vector_hardening,
    production_mode => false,

    vault_path => "/tmp/damage-nsecbunker-phase2c-vector.vault",
    bunker_pubkey_hex => undefined,

    authorized_clients => [
        %% <<"CLIENT_PUBKEY_HEX">>
    ],

    allowed_methods => [connect, ping, get_public_key, sign_event],
    allowed_kinds => [1, 30023],

    relays => [
        <<"wss://relay.damus.io">>,
        <<"wss://relay.primal.net">>,
        <<"wss://nos.lol">>
    ],

    limits => #{
        created_at_window_seconds => 600,
        max_kind_1_bytes => 4096,
        max_kind_30023_bytes => 131072,
        rate_limit_per_minute => 12,
        request_timeout_ms => 10000
    },

    kind_30023 => #{
        require_tags => [<<"d">>, <<"title">>, <<"published_at">>],
        reject_html => true
    },

    genesis => #{
        enabled => true,
        allowed_content_sha256 => []
    }
}}.
