%% Merge these entries into the existing {damage, [...]} application config.
%% This client deliberately refuses non-loopback wallet RPC hosts unless
%% monero_wallet_rpc_allow_remote is explicitly set to true.
[
    {damage, [
        {monero_wallet_rpc_host, "127.0.0.1"},
        {monero_wallet_rpc_port, 18083},
        {monero_wallet_rpc_timeout, 120000},
        {monero_wallet_rpc_transport, tcp},
        {monero_wallet_rpc_allow_remote, false},

        {monero_account_index, 0},
        {monero_min_confirmations, 10},
        {monero_poll_interval_ms, 10000},
        {monero_store_after_invoice, true},

        %% Keep true on a networked DamageBDD node. For a local developer
        %% feature run without an admin identity, temporarily set false.
        {monero_steps_require_admin, true},

        %% Outbound transfer step is inert until explicitly enabled.
        {monero_allow_spend, false},
        {monero_transfer_priority, 0},
        {monero_do_not_relay, false}
    ]}
].
