                            config => #{
                                type => file,
                                file => "/var/log/damage/error.log",
                                max_no_bytes => 10485760,
                                max_no_files => 10,
                                compress_on_rotate => true,
                                filesync_repeat_interval => 1000
                            },
                            formatter =>
                                {pretty_logger, #{
                                    max_event_chars => 12000,
                                    max_text_chars => 4096,
                                    max_binary => 128,
                                    max_string => 512,
                                    max_list => 24,
                                    max_map => 32,
                                    max_tuple => 24,
                                    depth => 6
                                }}
                        }
                    },

                    {handler, erm_voice_file, logger_std_h, #{
                        level => debug,
                        filter_default => stop,
                        filters => [{only_erm_voice, {
                            fun logger_filters:domain/2, {log, sub, [erm, voice]}
