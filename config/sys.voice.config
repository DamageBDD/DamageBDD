            file => "/var/log/damage/blossom.log",
            max_no_bytes => 10485760,
            max_no_files => 10,
            compress_on_rotate => true,
            filesync_repeat_interval => 1000
        },
        formatter =>
            {pretty_logger, #{
                max_event_chars => 12000,
                max_text_chars => 4096,
                max_binary => 256,
                max_string => 1024,
                max_list => 32,
                max_map => 48,
                max_tuple => 24,
                depth => 8
            }}
