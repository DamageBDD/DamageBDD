%% Merge under the existing {damage, [...]} application environment.
%% Use disposable keys only during Phase 3.

{nsecbunker, #{
    enabled => true,
    relay_client_enabled => true,
    relay_autosubscribe => false,

    %% For BDD/local completion use return_only or test_fail.
    %% For live disposable relay testing switch to normal and configure MFA if needed.
    relay_publication_mode => return_only,

    %% Optional explicit relay integration. If omitted the client tries:
    %% nosternity_relay:subscribe(Filter)
    %% nosternity_relay:publish_event(Event)
    %% nosternity_relay:broadcast_event(Relays, Event)
    %% relay_subscribe_mfa => {nosternity_relay, subscribe},
    %% relay_publish_mfa => {nosternity_relay, publish_event},

    require_inbound_p_tag => true,

    relays => [
        <<"wss://relay.damus.io">>,
        <<"wss://relay.primal.net">>,
        <<"wss://nos.lol">>
    ],

    allowed_methods => [connect, ping, get_public_key, sign_event],
    allowed_kinds => [1, 30023],

    bunker_publishes => false,
    signing_timeout_ms => 10000,

    crypto_backend_cmd => "/opt/damage/bin/damage-nsecbunker-crypto-c",
    crypto_timeout_ms => 5000
}}.
