%% Phase 4A DEV rehearsal fragment, standard sys.config format.
%% Merge under existing {damage, [...]} only for dev rehearsal.
%% No maps and no binary strings.

{nsecbunker, [
    {enabled, true},
    {relay_client_enabled, false},
    {mode, phase4a_dev_rehearsal},

    {crypto_backend_cmd, "/opt/damage/bin/damage-nsecbunker-crypto-c"},
    {crypto_timeout_ms, 5000},

    {vault_path, "/var/lib/damage/nsecbunker/dev_damagebdd.vault"},
    {audit_log, "/var/log/damage/nsecbunker_audit.log"},

    %% DEV/DISPOSABLE ONLY. Fill from PHASE4A_DEV_DAMAGEBDD_KEY.md.
    {bunker_pubkey_hex, "REPLACE_WITH_DEV_DAMAGEBDD_PUBKEY_HEX"},
    {bunker_npub, "REPLACE_WITH_DEV_DAMAGEBDD_NPUB"},

    {authorized_clients, [
        "REPLACE_WITH_DEV_CLIENT_PUBKEY_HEX"
    ]},

    {allowed_methods, [connect, ping, get_public_key, sign_event]},
    {allowed_kinds, [1, 30023]},

    {relays, [
        "wss://relay.damus.io",
        "wss://relay.primal.net",
        "wss://nos.lol"
    ]},

    {limits, [
        {created_at_skew_seconds, 600},
        {max_kind_1_bytes, 4096},
        {max_kind_30023_bytes, 131072},
        {rate_limit_per_minute, 12},
        {rate_limit_window_seconds, 60}
    ]},

    {kind_30023, [
        {require_tags, ["d", "title", "published_at"]},
        {reject_html, true}
    ]},

    {reject_active_content, true},
    {bunker_publishes, false},
    {signing_timeout_ms, 10000},

    {genesis, [
        {enabled, false},
        {allowed_content_sha256, []}
    ]}
]}.
