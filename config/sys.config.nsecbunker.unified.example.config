%% Complete example shape for release sys.config.
%% Merge the {nsecbunker, [...]} entry into the existing {damage, [...]} env.
%% Keep values as standard Erlang strings/lists, not maps and not binary strings.
[
 {damage, [
   {nsecbunker, [
     {enabled, false},
     {relay_client_enabled, false},
     {relay_publication_mode, "return_only"},
     {mode, "phase4b_damagebdd_production"},

     {crypto_backend_cmd, "/opt/damage/bin/damage-nsecbunker-crypto-c"},
     {crypto_timeout_ms, 5000},

     {vault_path, "/var/lib/damage/nsecbunker/damagebdd_node_production.vault"},
     {audit_log, "/var/log/damage/nsecbunker_audit.log"},

     {bunker_pubkey_hex, "REPLACE_WITH_PRODUCTION_DAMAGEBDD_NODE_PUBKEY_HEX"},
     {bunker_npub, "REPLACE_WITH_PRODUCTION_DAMAGEBDD_NODE_NPUB"},
     {contract_sha, "REPLACE_WITH_CLAWDOG_CONTRACT_OR_FEATURE_SHA"},

     {authorized_clients, [
       "REPLACE_WITH_AUTHORIZED_CLIENT_PUBKEY_HEX"
     ]},

     {allowed_methods, ["connect", "ping", "get_public_key", "sign_event"]},
     {allowed_kinds, [1, 30023]},

     {relays, [
       "wss://relay.damus.io",
       "wss://relay.primal.net",
       "wss://nos.lol"
     ]},

     {limits, [
       {created_at_skew_seconds, 600},
       {created_at_window_seconds, 600},
       {max_kind_1_bytes, 4096},
       {max_kind_30023_bytes, 131072},
       {rate_limit_per_minute, 12},
       {rate_limit_window_seconds, 60}
     ]},

     {kind_30023, [
       {require_tags, ["d", "title", "published_at"]},
       {reject_html, true}
     ]},

     {genesis, [
       {enabled, false},
       {allowed_content_sha256, []}
     ]},

     %% Ceremony/BDD script paths. Absolute release paths are preferred on host.
     {phase4a_dev_key_script, "/opt/damage/scripts/nsecbunker/phase4a_create_dev_damagebdd_key.sh"},
     {phase4b_production_key_script, "/opt/damage/scripts/nsecbunker/phase4b_create_production_damagebdd_node_key.sh"}
   ]}
 ]}
].
