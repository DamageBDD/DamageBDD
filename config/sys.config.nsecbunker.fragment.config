%% Merge this under the existing {damage, [...]} application environment.
%% Do not add a separate OTP application for the bunker.

{nsecbunker, #{
    %% Start false. Flip true only after ClawDog signs off the BDD contract
    %% and the crypto backend has been installed.
    enabled => false,

    mode => lodgeit_genesis,
    relay_client_enabled => false,

    vault_path => "/var/lib/damage/nsecbunker/lodgeit_genesis.vault",
    audit_log => "/var/log/damage/nsecbunker_audit.log",

    %% External reviewed backend. If this is missing or not executable, the
    %% bunker starts but the vault remains sealed and signing fails closed.
    crypto_backend_cmd => "/opt/damage/bin/damage-nsecbunker-crypto",
    crypto_timeout_ms => 5000,

    %% Fill after identity generation or pre-provisioning.
    bunker_pubkey_hex => <<"BUNKER_PUBKEY_HEX">>,
    bunker_npub => undefined,

    %% Phase 0 BDD signoff / ClawDog contract commit SHA.
    contract_sha => <<"PHASE0_GHERKIN_SIGNOFF_COMMIT_SHA">>,

    %% Brain / LodgeiT authorised client pubkey(s), hex encoded.
    authorized_clients => [
        %% <<"AUTHORISED_CLIENT_PUBKEY_HEX">>
    ],

    allowed_methods => [connect, ping, get_public_key, sign_event],
    allowed_kinds => [1, 30023],
    bunker_publishes => false,

    relays => [
        <<"wss://relay.damus.io">>,
        <<"wss://relay.primal.net">>,
        <<"wss://nos.lol">>
    ],

    limits => #{
        created_at_skew_seconds => 600,
        max_kind_1_bytes => 4096,
        max_kind_30023_bytes => 131072,
        rate_limit_per_minute => 30,
        rate_limit_window_seconds => 60
    },

    kind_30023 => #{
        require_tags => [<<"d">>, <<"title">>, <<"published_at">>],
        reject_html => true
    },

    signing_timeout_ms => 10000,
    secret_hint => <<"<out-of-band-secret>">>
}}.

%% Optional if you want to force the ETS limiter instead of throttle:
{nsecbunker_rate_backend, ets}.
