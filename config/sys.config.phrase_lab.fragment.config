%% MERGE these two options into the EXISTING whisper_trigger -> phrases list.
%% Preserve the current native models, owner profile, calibrated threshold,
%% phrase profile path, voice coordinator and other application options.
%% Restart the release; do not load only a single changed module.
[{erm, [
    {whisper_trigger, [
        {backend, phrases},
        {phrases, [
            {lab_enabled, true},
            {observe_only, true}
        ]}
    ]}
]}].
%% Then use erm_phrase_lab:start/0 from the trusted local Erlang shell.
%% The lab's helper path, playback device and corpus_file are start/1 options,
%% not additional entries accepted in the phrases configuration.
