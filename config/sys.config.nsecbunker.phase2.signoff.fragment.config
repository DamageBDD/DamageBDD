%% Merge under the existing {damage, [...]} app env for Phase 2A signoff.
%% This is not production/live signing config.

{nsecbunker, #{
    enabled => true,
    relay_client_enabled => false,

    mode => lodgeit_genesis_signoff,

    %% Placeholder until ClawDog approves the feature file hash.
    contract_sha => <<"PHASE2A_CLAWDOG_FEATURE_SHA256_PENDING">>,

    bunker_pubkey_hex => <<"BUNKER_PUBKEY_HEX">>,
    authorized_clients => [<<"AUTHORISED_CLIENT_PUBKEY_HEX">>],

    allowed_methods => [connect, ping, get_public_key, sign_event],
    allowed_kinds => [1, 30023],

    bunker_publishes => false,
    reject_active_content => true,
    signing_timeout_ms => 10000,

    limits => #{
        created_at_skew_seconds => 600,
        max_kind_1_bytes => 4096,
        max_kind_30023_bytes => 131072,
        rate_limit_per_minute => 30,
        rate_limit_window_seconds => 60
    },

    kind_30023 => #{
        require_tags => [<<"d">>, <<"title">>, <<"published_at">>],
        reject_html => true
    },

    rate_limit => #{max_requests => 30, window_seconds => 60},

    relays => [
        <<"wss://relay.damus.io">>,
        <<"wss://relay.primal.net">>,
        <<"wss://nos.lol">>
    ],

    audit_log => "/tmp/damage-nsecbunker-phase2a-audit.log",

    %% Deliberately absent/non-executable during Phase 2A.
    %% BDD signoff exercises policy/gate behaviour before live signing.
    crypto_backend_cmd => "/opt/damage/bin/damage-nsecbunker-crypto-NOT-INSTALLED"
}}.
