%% Separate desktop runtime configuration. Never read /etc/damage/damage.config
%% or the Damage service user's XDG configuration in this process.
[
    {kernel, [
        %% Optional local GTK C-node distribution must remain host-local and
        %% use a private, per-boot cookie created by erm_user, never Damage's.
        {inet_dist_use_interface, {127, 0, 0, 1}},
        {dist_auto_connect, never}
    ]},
    {sasl, [{sasl_error_logger, false}]},
    {erm, [
        {enabled, true},
        {http_enabled, false},
        {display_manager, [{mode, disabled}]},
        {gtknode4, [{enabled, false}]}
    ]},
    {erm_user, [
        {bridge_socket, "/run/damage-erm/bridge.sock"},
        {bridge_token_file, default},
        {bridge_server_user, "damage"},
        {local_distribution, false}
    ]}
].
