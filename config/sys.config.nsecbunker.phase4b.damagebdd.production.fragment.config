%% Standard sys.config fragment for Phase 4B production DamageBDD node key.
%% Merge under existing {damage, [...]} application environment.

{nsecbunker, [
    {enabled, true},
    {relay_client_enabled, false},
    {mode, phase4b_damagebdd_production},

    {crypto_backend_cmd, "/opt/damage/bin/damage-nsecbunker-crypto-c"},
    {vault_path, "/var/lib/damage/nsecbunker/damagebdd_node_production.vault"},
    {audit_log, "/var/log/damage/nsecbunker_audit.log"},

    %% Fill after running scripts/nsecbunker/phase4b_create_production_damagebdd_node_key.sh
    {bunker_pubkey_hex, "REPLACE_WITH_PRODUCTION_DAMAGEBDD_NODE_PUBKEY_HEX"},
    {bunker_npub, "REPLACE_WITH_PRODUCTION_DAMAGEBDD_NODE_NPUB"},

    {authorized_clients, [
        "REPLACE_WITH_AUTHORISED_DAMAGEBDD_CLIENT_PUBKEY_HEX"
    ]},

    {allowed_methods, [connect, ping, get_public_key, sign_event]},
    {allowed_kinds, [1, 30023]},

    {relays, [
        "wss://relay.damus.io",
        "wss://relay.primal.net",
        "wss://nos.lol"
    ]},

    {limits, [
        {created_at_skew_seconds, 600},
        {max_kind_1_bytes, 4096},
        {max_kind_30023_bytes, 131072},
        {rate_limit_per_minute, 12},
        {rate_limit_window_seconds, 60}
    ]},

    {kind_30023, [
        {require_tags, ["d", "title", "published_at"]},
        {reject_html, true}
    ]},

    {genesis, [
        {enabled, false},
        {allowed_content_sha256, []}
    ]}
]}.
