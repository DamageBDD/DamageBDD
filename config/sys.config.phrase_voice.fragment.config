%% EXAMPLE ONLY. Merge into the EXISTING erm application/whisper_trigger entry.
%% Preserve your voice coordinator, media and TTS configuration. Do not create
%% duplicate erm application entries. Install/calibrate the speaker profile first.
[{erm, [
    {whisper_trigger, [
        {enabled, true},
        {backend, phrases},
        {trigger_phrases, ["bob"]},
        {voice, [{enabled, true}]},
        {native, [
            {vad_model, "/opt/models/silero_vad.onnx"},
            {speaker_model, "/opt/models/speaker.onnx"},
            {profile_file, "/var/lib/damage/voice/owner.profile"},
            {arecord, "/usr/bin/arecord"},
            {device, "default"},
            {threads, 4},
            {silence_ms, 700},
            {max_segment_ms, 8000},
            {min_speaker_ms, 1200},
            {require_speaker, true},
            %% Placeholder: retain YOUR calibrated existing native threshold.
            {speaker_threshold, 0.7}
        ]},
        {phrases, [
            {observe_only, true},
            {profile_file, "/var/lib/damage/voice/phrases/commands.eph"},
            %% Provisional acoustic-distance parameters, not probabilities.
            {max_distance, 0.35},
            {min_margin, 0.08},
            {min_rms_dbfs, -45.0},
            {max_clipped_fraction, 0.02},
            {cooldown_ms, 1000}
        ]}
    ]}
]}].
