%% Merge this application entry into the release sys.config.
%% The AWS provider configures aws_credentials internally to use only EC2.
[
    {damage, [
        {nsecbunker, [
            {enabled, true},
            {mode, production},
            {secret_provider, aws_secrets_manager},

            {aws_secret, [
                {region, "ap-southeast-2"},
                {secret_id, "/damage/prod/nsecbunker/vault-passphrase"},
                {expected_account_id, "123456789012"},
                {expected_role_name, "damage-node-prod"}
            ]},

            {crypto_backend_cmd, "/opt/damage/bin/damage-nsecbunker-crypto-c"},
            {crypto_timeout_ms, 10000},
            {crypto_unlock_timeout_ms, 15000},

            {audit_log, "/var/log/damage/nsecbunker_audit.log"}
        ]}
    ]}
].
